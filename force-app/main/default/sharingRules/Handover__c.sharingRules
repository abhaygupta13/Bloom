<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Contact_Center_Sharing_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Contact Center Sharing Rule</label>
        <sharedTo>
            <group>Handover_Contact_Center_and_Manager</group>
        </sharedTo>
        <criteriaItems>
            <field>Sub_Status__c</field>
            <operation>equals</operation>
            <value>Appointment Booked with Customer</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>handover_crm_operation_by_pass_all_status</fullName>
        <accessLevel>Edit</accessLevel>
        <description>CRM operation team will edit their field on all Handover status.</description>
        <label>handover crm operation by pass all status</label>
        <sharedTo>
            <role>Customer_Relations_Associate</role>
        </sharedTo>
        <criteriaItems>
            <field>Sub_Status__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
