<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Community_Unit_Sharing</fullName>
        <accessLevel>Read</accessLevel>
        <label>Available For Comunity Team</label>
        <sharedTo>
            <group>Community_Team</group>
        </sharedTo>
        <criteriaItems>
            <field>IsCommunity__c</field>
            <operation>notEqual</operation>
            <value>False</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Inventory_sharing</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Inventory sharing</label>
        <sharedTo>
            <group>Inventory_Management</group>
        </sharedTo>
        <criteriaItems>
            <field>UnitNumber__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Unit_Sold_and_availble_unit_access</fullName>
        <accessLevel>Read</accessLevel>
        <label>Unit Sold and availble unit access</label>
        <sharedTo>
            <group>Handover_Manager</group>
        </sharedTo>
        <criteriaItems>
            <field>Unit_Status__c</field>
            <operation>equals</operation>
            <value>Available,Booked,Sold</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
</SharingRules>
