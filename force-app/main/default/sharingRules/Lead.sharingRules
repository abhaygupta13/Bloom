<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Broker_Team_Sharing_Rule</fullName>
        <accessLevel>Read</accessLevel>
        <label>Broker Team Sharing Rule</label>
        <sharedTo>
            <group>Broker_Mangement_Team</group>
        </sharedTo>
        <booleanFilter>1 AND 2 AND 3</booleanFilter>
        <criteriaItems>
            <field>LeadSource</field>
            <operation>equals</operation>
            <value>Broker</value>
        </criteriaItems>
        <criteriaItems>
            <field>leadsubsource__c</field>
            <operation>equals</operation>
            <value>Broker Portal</value>
        </criteriaItems>
        <criteriaItems>
            <field>lead_channel__c</field>
            <operation>equals</operation>
            <value>Broker Portal</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Leasing_Leads_Rule</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Leasing Leads Rule</label>
        <sharedTo>
            <group>Leasing_Team</group>
        </sharedTo>
        <criteriaItems>
            <field>LeadTeam__c</field>
            <operation>equals</operation>
            <value>Leasing</value>
        </criteriaItems>
        <criteriaItems>
            <field>ContactCentreLeadStatus__c</field>
            <operation>notEqual</operation>
            <value>In Progress,New,Disqualified</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_With_ADHA_Sales_Manager_Team</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share With ADHA Sales Manager Team</label>
        <sharedTo>
            <group>ADHA_Sales_Manager_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>ApplicationNumber__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_With_Contact_Center_Team</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share With Contact Center Team</label>
        <sharedTo>
            <group>CC_Agent_Public_Group</group>
        </sharedTo>
        <criteriaItems>
            <field>LastName</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingCriteriaRules>
        <fullName>Share_With_Lead_Manager</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share With Lead Manager</label>
        <sharedTo>
            <group>Sales_Lead_Manager</group>
        </sharedTo>
        <criteriaItems>
            <field>LeadNumber__c</field>
            <operation>notEqual</operation>
            <value></value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>Share_Lead_With_Contact_Center_Manager</fullName>
        <accessLevel>Edit</accessLevel>
        <label>Share Lead With Contact Center Manager</label>
        <sharedTo>
            <role>Assistant_Manager_Contact_Center</role>
        </sharedTo>
        <sharedFrom>
            <group>CC_Agent_Public_Group</group>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
