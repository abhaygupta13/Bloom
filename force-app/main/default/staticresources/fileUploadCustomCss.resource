lightning-input.customFile.slds-form-element span.slds-form-element__label {
    display: none;
}
lightning-input.customFile.slds-form-element .slds-file-selector.slds-file-selector_files {
    border: none!important;
}
lightning-input.customFile.slds-form-element lightning-primitive-file-droppable-zone.slds-file-selector__dropzone {
    border: none!important;
}
lightning-input.customFile.slds-form-element label.slds-file-selector__body {
    border: none;
}
lightning-input.customFile.slds-form-element span.slds-file-selector__button.slds-button.slds-button_neutral {
    font-size: 0;
    padding: 0.5rem;
    border-radius: 50%;
    line-height: 1;
    background: #b61c22;
}
lightning-input.customFile.slds-form-element svg.slds-button__icon.slds-button__icon_left {
    margin: 0;
    line-height: 1;
    color: #fff;
}
lightning-input.customFile.slds-form-element span.slds-file-selector__text.slds-medium-show {
    display: none;
}

/* ===== MODAL WIDTH FIX ===== */
.slds-modal__container {
    max-width: 80rem !important;
    width: 80% !important;
}