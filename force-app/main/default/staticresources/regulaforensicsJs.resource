 versuchen","noCameraAvailable":"Keine Kamera vorhanden","photoCapturedSuccessfully":"Das Foto wurde erfolgreich aufgenommen.","scanIDInBrowser":"Scannen Sie eine ID in Ihrem Browser","useYourDeviceCamera":"Verwenden Sie die Kamera Ihres Geräts, um ein Dokument zu scannen, oder wählen Sie ein Foto des Dokuments in der Galerie aus.","fromCamera":"Von Kamera","fromGallery":"Von Gallerie","cameraConnection":"Stellen Sie sicher, dass die Kamera richtig angeschlossen ist.","documentProcessing":"Dokument in Bearbeitung...","positionDocumentCenter":"Positionieren Sie das Dokument in der Mitte","flipDocument":"Dokument drehen","processingFinished":"Bearbeitung abgeschlossen.","uploadPhoto":"Foto hochladen","useCameraOrGallery":"Verwenden Sie die Kamera Ihres Geräts oder wählen Sie ein Foto aus der Galerie aus","detectingDocument":"Suche nach Dokument...","versionNotSupported":"Ihre Browserversion wird nicht unterstützt","updateBrowser":"Aktualisieren Sie Ihre Browserversion","largeFile":"Diese Datei ist zu groß, um hochgeladen zu werden","selectSmallerFile":"Bitte wählen Sie eine kleinere Datei","licenseError":"Es ist ein Lizenzfehler aufgetreten","licenseExpired":"Die Lizenz kann nicht gefunden werden oder ist abgelaufen","fileCorrupt":"Diese Datei ist beschädigt oder wird nicht unterstützt","selectAnotherFile":"Bitte wählen Sie eine andere Datei","noFocus":"Kein Kamerafokus","incorrectCameraId":"Keine Kamera mit angegebener ID gefunden","checkCameraId":"Prüfen Sie, ob die angegebene Kamera-ID korrekt ist"}'),sr=JSON.parse('{"placeDocumentIntoFrame":"Dopasuj dokument do ramki","holdDocumentStraight":"Trzymaj urządzenie prosto","glaresOnDocument":"Unikaj oślepiania dokumentu","preparingCamera":"Przygotowywanie kamery...","processing":"Przetwarzanie...","moveCloser":"Przysuń się bliżej","timeout":"Limit czasu","somethingWentWrong":"Coś poszło nie tak","preparingService":"Przygotowanie serwisu...","success":"Gotowe!","cameraUnavailable":"Aparat jest niedostępny!","allowAccess