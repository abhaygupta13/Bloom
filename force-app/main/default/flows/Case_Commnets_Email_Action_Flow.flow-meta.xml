        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <textTemplates>
        <name>CasecommentsEmailbody</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&apos;New Case COmments Added&apos; +{!$Record.CommentBody} + &apos;by&apos; + {!$User.FirstName}&lt;/p&gt;</text>
    </textTemplates>
    <textTemplates>
        <name>CaseCommnetsSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
