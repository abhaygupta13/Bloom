    </textTemplates>
    <textTemplates>
        <name>Emailbodytexttemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Dear {!$Record.Parent.Owner:User.LastName},&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Below new case comment is added to the Case&lt;/span&gt; :   &lt;a href=&quot;{!CaseDynamicUrl}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;{!$Record.Parent.CaseNumber}&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Comment: {!$Record.CommentBody}&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(25, 24, 24);&quot;&gt;Note: This is system generated notification.&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <variables>
