<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Flow to update unit fields on unit blocking approval</description>
    <environments>Default</environments>
    <formulas>
        <name>AssignedUser</name>
        <dataType>String</dataType>
        <expression>{!$Record.AssignedToUser__c}</expression>
    </formulas>
    <formulas>
        <name>Blockedtill</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())+{!$Record.Holding_Days__c}</expression>
    </formulas>
    <formulas>
        <name>CurrentDate</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE(TODAY())</expression>
    </formulas>
    <formulas>
        <name>UnitRecordLink</name>
        <dataType>String</dataType>
        <expression>{!$Label.SalesforceURL}&amp;&quot;/&quot;&amp;{!$Record.Id}</expression>
    </formulas>
    <interviewLabel>Unit_Update Fields on Blocking Unit Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Unit_Update Fields on Blocking Unit Approval</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Assigned_To_User</name>
        <label>Update Assigned To User</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>BlockedBy__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>AssignedToUser__c</field>
            <value>
                <elementReference>$Record.BlockedBy__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Block_Till__c</field>
            <value>
                <elementReference>Blockedtill</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>BlockedComments__c</field>
            <value>
                <stringValue>Assignment Request</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>BlockedDate__c</field>
            <value>
                <elementReference>CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>BlockedReason__c</field>
            <value>
                <stringValue>Assignment Request</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Assigned_To_User</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Blocked</stringValue>
            </value>
        </filters>
        <filters>
            <field>Holding_Days__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Submitted_for_Approval__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Unit__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>AssignedUserEmail</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.BlockedBy__r.Email}</text>
    </textTemplates>
    <textTemplates>
        <name>UnitBlockedEmailSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>{!$Record.Name}: Unit Assigned</text>
    </textTemplates>
    <textTemplates>
        <name>UnitBlockedEmailTemplate</name>
        <isViewedAsPlainText>false</isViewedAsPlainText>
        <text>&lt;p&gt;Dear {!$Record.AssignedToUser__r.FirstName} {!$Record.AssignedToUser__r.LastName},&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The below mentioned unit has been blocked and assigned to you.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Unit Code&lt;/strong&gt;: {!$Record.Name}&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Project Name&lt;/strong&gt;: {!$Record.ProjectName__c}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;a href=&quot;{!UnitRecordLink}&quot; rel=&quot;noopener noreferrer&quot; target=&quot;_blank&quot;&gt;Click here&lt;/a&gt; to navigate to the unit&lt;span style=&quot;font-size: medium; font-family: &amp;quot;Times New Roman&amp;quot;; color: rgb(0, 0, 0);&quot;&gt;.&lt;/span&gt;&lt;/p&gt;</text>
    </textTemplates>
    <variables>
        <name>UnitBlockedEmailTemplateId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
