    </formulas>
    <formulas>
        <name>InstallmentDatebasedonyear</name>
        <dataType>Date</dataType>
        <expression>TODAY() + ({!$Record.Offset_Count__c} * 365.25)</expression>
    </formulas>
    <formulas>
        <description>adding InstallmentDateupdationbasedonMonth</description>
