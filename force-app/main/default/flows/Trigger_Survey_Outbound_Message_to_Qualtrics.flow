    <decisions>
        <name>Survey_Type_Check</name>
        <label>Survey Type Check</label>
        <locationX>692</locationX>
        <locationY>149</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Survey_Type_Broker_Survey</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SurveyType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales Broker Survey</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Trigger_Broker_Survey</targetReference>
            </connector>
            <label>Survey Type Broker Survey</label>
        </rules>
