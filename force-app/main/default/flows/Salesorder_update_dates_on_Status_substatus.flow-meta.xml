<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_change_in_Salesorder_status_and_substatus</name>
        <label>Check change in Salesorder status and substatus</label>
        <locationX>710</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Substatus_Becomes_cancellation_initiated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SubStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancellation Initiated</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update</targetReference>
            </connector>
            <label>Substatus Becomes cancellation initiated</label>
        </rules>
        <rules>
            <name>Substatus_becomes_AD_Sales_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SubStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved by AD Sales</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_SalesApprovedDate</targetReference>
            </connector>
            <label>Substatus becomes AD Sales Approved</label>
        </rules>
        <rules>
            <name>Sub_status_becomes_Documents_Issued</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SubStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Document Issued</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_ContractIssuedDate_date</targetReference>
            </connector>
            <label>Sub status becomes Documents Issued</label>
        </rules>
        <rules>
            <name>Booking_Cancelled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Book Cancelled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>update_SalesOrderCancelledDate</targetReference>
            </connector>
            <label>when status becomes Booking Cancelled</label>
        </rules>
        <rules>
            <name>Status_becomes_sold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Bloom_Signed_SPA_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_sold_date</targetReference>
            </connector>
            <label>Status becomes sold</label>
        </rules>
    </decisions>
    <description>Updating multiple dates on changing of Saleorder Status and substatus</description>
    <environments>Default</environments>
    <formulas>
        <name>Expectedenddate</name>
        <dataType>Date</dataType>
        <expression>$Record.BookingDate__c + VALUE($Label.SalesClosureDays)</expression>
    </formulas>
    <formulas>
        <name>todayDate</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Salesorder __update dates on Status &amp; substatus {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Salesorder __update dates on Status &amp; substatus</label>
    <processMetadataValues>
        <name>BuilderType</name>
