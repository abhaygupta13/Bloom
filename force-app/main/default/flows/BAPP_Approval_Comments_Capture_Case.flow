    <actionCalls>
        <description>Notify BBM after BL team rejects the Service Request</description>
        <name>Notify_if_BL_team_Rejects_the_application_Case</name>
        <label>Notify if BL team Rejects the application-Case</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Case.Notify_if_BL_team_Rejects_the_application_Case</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
