<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Access_Card_To_Collection</name>
        <label>Add Access Card To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>newAccessCardColl</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>newAccessCard</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_New_Card</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Old_Card</name>
        <label>Add Old Card</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>oldCardColl2</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>oldCards</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>oldCards</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Old_Card_To_Collection</name>
        <label>Add Old Card To Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>oldCardCollection</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Old_Card</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Old_Card</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>addCount</name>
        <label>addCount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>numberCardsAdded</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>loopNewCard</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Access_Card_Information</name>
        <label>Assign Access Card Information</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>newAccessCard.CardNumber__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_New_Card.newCard_Number</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newAccessCard.CardType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_New_Card.Card_Type</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newAccessCard.Unit__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case_Record.Unit__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newAccessCard.Account__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case_Record.AccountId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newAccessCard.UserType__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Case_Record.User_Type__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newAccessCard.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newAccessCard.ActivatedDateTime__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newCardNumberString</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>{!Loop_New_Card.newCard_Number};</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Access_Card_To_Collection</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Update_Old_Card_Status</name>
        <label>Update Old Card Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Old_Card.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Deactivated</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_Old_Card_To_Collection</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_Cards_Added_Matched_With_Request</name>
        <label>Check Cards Added Matched With Request</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Matched</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>numberCardsAdded</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Case_Record.NumberOfCards__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Old_Card</targetReference>
            </connector>
            <label>Yes Matched</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Case_Status</name>
        <label>Check Case Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Error_Screen_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>In_Progress</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Access_Cards</targetReference>
            </connector>
            <label>In Progress</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Old_Card_Matches</name>
        <label>Check Old Card Matches</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>oldCards</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.CardNumbers__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>oldCards.CardNumber__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Old_Card</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Find_Old_Card</name>
        <label>Find Old Card</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Old_Card</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Is_Old_Card</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Record.CardNumbers__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <elementReference>Loop_Old_Card.CardNumber__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Old_Card_Status</targetReference>
            </connector>
            <label>Yes Is Old Card</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>AccessCardType</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>CardType__c</picklistField>
        <picklistObject>AccessCard__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <interviewLabel>Screen:Activate New Cards Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Screen:Activate New Cards Flow</label>
    <loops>
        <name>Loop_New_Card</name>
        <label>Loop New Card</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>AddCards.AllItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Access_Card_Information</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Create_Access_Cards</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Old_Card</name>
        <label>Loop Old Card</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Existing_Access_Cards</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Find_Old_Card</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Old_Card_Collection</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>loopNewCard</name>
        <label>loopNewCard</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>AddCards.AllItems</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>addCount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Cards_Added_Matched_With_Request</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>oldCards</name>
        <label>oldCards</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Existing_Access_Cards</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Check_Old_Card_Matches</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>New_Card_Numbers_Screen</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Access_Cards</name>
        <label>Create Access Cards</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Case_To_Close</targetReference>
        </connector>
        <inputReference>newAccessCardColl</inputReference>
    </recordCreates>
    <recordLookups>
        <name>Get_Case_Record</name>
        <label>Get Case Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Case_Status</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Access_Cards</name>
        <label>Get Existing Access Cards</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>oldCards</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case_Record.AccountId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Unit__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Case_Record.Unit__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Activated</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>AccessCard__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Case_To_Close</name>
        <label>Update Case To Close</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Success_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>{!Get_Case_Record.Description}. New Card Numbers: {!newCardNumberString}</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Old_Card_Collection</name>
        <label>Update Old Card Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Loop_New_Card</targetReference>
        </connector>
        <inputReference>oldCardCollection</inputReference>
    </recordUpdates>
    <screens>
        <name>Error_Screen_1</name>
        <label>Error Screen 1</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>errorMessage1</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;color: rgb(160, 4, 4); font-size: 16px;&quot;&gt;This case is already closed you can&apos;t perform operation on this case.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Error_Screen_2</name>
        <label>Error Screen 2</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <backButtonLabel>Back</backButtonLabel>
        <fields>
            <name>errorMessage2</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 16px; color: rgb(147, 6, 6);&quot;&gt;The number of cards in the request does not match the number of new cards added.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Close</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>New_Card_Numbers_Screen</name>
        <label>New Card Numbers Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>loopNewCard</targetReference>
        </connector>
        <fields>
            <name>AddCards</name>
            <fieldType>Repeater</fieldType>
            <fields>
                <name>Old_Card_Number</name>
                <dataType>String</dataType>
                <defaultValue>
                    <elementReference>oldCardColl2[$EachItem].CardNumber__c</elementReference>
                </defaultValue>
                <fieldText>Old Card Number</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isDisabled>
                    <booleanValue>true</booleanValue>
                </isDisabled>
                <isRequired>false</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
            </fields>
            <fields>
                <name>Card_Type</name>
                <choiceReferences>AccessCardType</choiceReferences>
                <dataType>String</dataType>
                <defaultValue>
                    <elementReference>oldCardColl2[$EachItem].CardType__c</elementReference>
                </defaultValue>
                <fieldText>Card Type</fieldText>
                <fieldType>DropdownBox</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isDisabled>
                    <booleanValue>true</booleanValue>
                </isDisabled>
                <isRequired>false</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
            </fields>
            <fields>
                <name>newCard_Number</name>
                <dataType>String</dataType>
                <fieldText>New Card Number</fieldText>
                <fieldType>InputField</fieldType>
                <inputsOnNextNavToAssocScrn>UseStoredValues</inputsOnNextNavToAssocScrn>
                <isRequired>true</isRequired>
                <styleProperties>
                    <verticalAlignment>
                        <stringValue>top</stringValue>
                    </verticalAlignment>
                    <width>
                        <stringValue>12</stringValue>
                    </width>
                </styleProperties>
            </fields>
            <inputParameters>
                <name>collection</name>
                <value>
                    <elementReference>oldCardColl2</elementReference>
                </value>
            </inputParameters>
            <inputParameters>
                <name>canAddItem</name>
                <value>
                    <booleanValue>false</booleanValue>
                </value>
            </inputParameters>
            <inputParameters>
                <name>canRemoveItem</name>
                <value>
                    <booleanValue>false</booleanValue>
                </value>
            </inputParameters>
            <isRequired>false</isRequired>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Activate</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Success_Screen</name>
        <label>Success Screen</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>successAlert</name>
            <fieldText>&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;font-size: 16px; color: rgb(1, 163, 19);&quot;&gt;Deactivated Old Cards&lt;/strong&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center;&quot;&gt;&lt;strong style=&quot;font-size: 16px; color: rgb(1, 163, 19);&quot;&gt;Activated New Cards Successfully&lt;/strong&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
            <styleProperties>
                <verticalAlignment>
                    <stringValue>top</stringValue>
                </verticalAlignment>
                <width>
                    <stringValue>12</stringValue>
                </width>
            </styleProperties>
        </fields>
        <nextOrFinishButtonLabel>Done</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Case_Record</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>newAccessCard</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AccessCard__c</objectType>
    </variables>
    <variables>
        <name>newAccessCardColl</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AccessCard__c</objectType>
    </variables>
    <variables>
        <name>newCardNumberString</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>numberCardsAdded</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>oldCardColl2</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AccessCard__c</objectType>
    </variables>
    <variables>
        <name>oldCardCollection</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>AccessCard__c</objectType>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
