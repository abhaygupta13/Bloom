<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>If_Leasing_Offer_Signed</name>
        <label>If Leasing Offer Signed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Leasing_Offer_Signed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__EmailSubject__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Leasing Offer</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_the_Leasing_Order_Offer_signed_date</targetReference>
            </connector>
            <label>Is Leasing Offer Signed</label>
        </rules>
        <rules>
            <name>Is_Leasing_Contract_Signed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.dfsle__EmailSubject__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Leasing Contract</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Leasing_Order_Contract_signed_date</targetReference>
            </connector>
            <label>Is Leasing Contract Signed</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>Currenttime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <interviewLabel>Attach Signed Leasing Offer to Leasing Order {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Attach Signed Leasing Offer to Leasing Order</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>getLeasingOrderRecord</name>
        <label>getLeasingOrderRecord</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>If_Leasing_Offer_Signed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.dfsle__SourceId__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>LeasingOrder__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Leasing_Order_Contract_signed_date</name>
        <label>Update Leasing Order Contract signed date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getLeasingOrderRecord.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>LeasingContractSignedDate__c</field>
            <value>
                <elementReference>Currenttime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>isLeasingContractSigned__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>LeasingOrder__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_the_Leasing_Order_Offer_signed_date</name>
        <label>Update the Leasing Order Offer signed date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>getLeasingOrderRecord.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>LeasingOfferSignedDate__c</field>
            <value>
                <elementReference>Currenttime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>isLeasingOfferSigned__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>LeasingOrder__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>getLeasingOrderRecord</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>dfsle__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Completed</stringValue>
            </value>
        </filters>
        <filters>
            <field>dfsle__Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>dfsle__EnvelopeStatus__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
