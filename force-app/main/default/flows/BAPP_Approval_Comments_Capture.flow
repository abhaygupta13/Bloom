<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Agency_Registration_Application_Rejected</name>
        <label>Agency Registration Application Rejected</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>BrokerApplication__c.AgencyRegistration_ApplicationRejected</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>BrokerApplication__c.AgencyRegistration_ApplicationRejected</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <actionCalls>
        <name>Approved_Comment</name>
        <label>Approved Comment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>BAPPApprovalFlow</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Agency_Registration_Application_Rejected</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>BAPPApprovalFlow</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <actionCalls>
        <name>Approved_Comment_By_BBM</name>
        <label>Approved Comment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>BAPPApprovalFlow</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>BAPPApprovalFlow</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>64.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Approval_Status</name>
        <label>Approval Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Approval</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved by BBM</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved by BL</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approved</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Comment_By_BBM</targetReference>
            </connector>
            <label>Approval</label>
        </rules>
        <rules>
            <name>Rejection</name>
            <conditionLogic>(1 AND 2 ) OR ( 3 AND 4 )</conditionLogic>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RejectedByBL__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ApprovalStatus__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RejectedByBL__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approved_Comment</targetReference>
            </connector>
            <label>Rejection</label>
        </rules>
    </decisions>
    <description>This flow captures the approval comments
offset to 1
New condition added in Agency registration appln rejected</description>
    <environments>Default</environments>
    <interviewLabel>BAPP Approval Comments Capture {!$Flow.CurrentDateTime}</interviewLabel>
    <label>BAPP Approval Comments Capture</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterFormula>ISCHANGED({!$Record.ApprovalStatus__c})</filterFormula>
        <object>BrokerApplication__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <name>BBM_Approved_Comment</name>
            <connector>
                <targetReference>Approval_Status</targetReference>
            </connector>
            <label>BBM Approved Comment</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Minutes</offsetUnit>
            <recordField>LastModifiedDate</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
