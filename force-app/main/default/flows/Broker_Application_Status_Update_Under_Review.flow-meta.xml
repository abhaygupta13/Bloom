    <recordUpdates>
        <description>Update status from &quot;Submitted&quot; to &quot;Under Review&quot;</description>
        <name>Update_Status_on_Broker_Application</name>
        <label>Update Status on Broker Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>ApprovalStatus__c</field>
