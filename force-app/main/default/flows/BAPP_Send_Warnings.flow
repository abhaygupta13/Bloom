    <decisions>
        <name>Check_Warning_Count</name>
        <label>Check Warning Count</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Warning Count&gt; 3</defaultConnectorLabel>
        <rules>
            <name>Warning_Count_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.WarningCounter__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Enter_Warning_Description</targetReference>
            </connector>
            <label>Warning Count 1</label>
        </rules>
        <rules>
            <name>Warning_Count_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.WarningCounter__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Enter_Warning2_Description</targetReference>
            </connector>
            <label>Warning Count 2</label>
        </rules>
        <rules>
            <name>Warning_Count_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.WarningCounter__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Enter_Warning3_Description</targetReference>
            </connector>
            <label>Warning Count 3</label>
        </rules>
    </decisions>
    <description>Send Warning Email for Suspension/Terminations</description>
    <environments>Default</environments>
    <interviewLabel>BAPP_Send Warnings {!$Flow.CurrentDateTime}</interviewLabel>
