<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>ApplicationNumber__c</field>
        <field>ApprovalStatus__c</field>
        <field>ApprovalComments__c</field>
        <field>RejectionComments__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>In_ApprovalFalse</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_the_Approved_By_BBM</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Bloom_Broker_Management_BBM</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>This is first step is to evaluate the Application Applicant record by BBM</description>
        <label>Approval By BBM</label>
        <name>ApprovalByBBM</name>
        <rejectionActions>
            <action>
                <name>FirstBBMRejection</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>UpdateInApprovalForReject</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approval_By_BL</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Field_Update_In_Approval_BL</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Notify_if_BL_team_Approves_the_application</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Bloom_Legal_BL</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <description>This step to approve the International Agency Document for Approval</description>
        <entryCriteria>
            <criteriaItems>
                <field>BrokerApplication__c.ApprovalStatus__c</field>
                <operation>equals</operation>
                <value>Approved by BBM</value>
            </criteriaItems>
            <criteriaItems>
                <field>BrokerApplication__c.TypeofEstablishment__c</field>
                <operation>equals</operation>
                <value>International</value>
            </criteriaItems>
        </entryCriteria>
        <label>Approval By BL</label>
        <name>ApprovalByBL</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Field_Update_In_Approval_Reject_BL</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Final_Review_True</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Notify_if_BL_team_Rejects_the_application</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Status_Rejected_By_BL</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This Approval process is for Broker Application for first Stage for BBM</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>BrokerApplication__c.ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Under Review</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>In_Approval_True</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Application Approval BBM</label>
    <processOrder>1</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
