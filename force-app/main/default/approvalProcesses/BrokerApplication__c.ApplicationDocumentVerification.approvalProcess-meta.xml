<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>ApplicationNumber__c</field>
        <field>ApprovalStatus__c</field>
        <field>ApprovalComments__c</field>
        <field>RejectionComments__c</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>Approved_by_BL</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Notify_if_BL_team_Approves_the_application</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Send_To_BL_False</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_In_Approval_Again</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>Bloom_Legal_BL</name>
                <type>queue</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Approval By BL</label>
        <name>ApprovalByBL</name>
        <rejectionActions>
            <action>
                <name>Final_Review</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Notify_if_BL_team_Rejects_the_application</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Rejected_By_BL</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>RejectedByBL</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Send_To_BL_False_Rejection</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Update_In_Approval_For_Reject</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>This Approval process is for Broker Application for first Stage for BL Domestic</description>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 OR 3 OR 4) AND 2</booleanFilter>
        <criteriaItems>
            <field>BrokerApplication__c.ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved by BBM</value>
        </criteriaItems>
        <criteriaItems>
            <field>BrokerApplication__c.TypeofEstablishment__c</field>
            <operation>equals</operation>
            <value>Domestic</value>
        </criteriaItems>
        <criteriaItems>
            <field>BrokerApplication__c.ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </criteriaItems>
        <criteriaItems>
            <field>BrokerApplication__c.ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>RFI</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Update_In_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Application Document Verification</label>
    <processOrder>2</processOrder>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>false</showApprovalHistory>
</ApprovalProcess>
