    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>aattia@bloomholding.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Commission Line Items Approval Step</label>
        <name>Commission_Line_Items_Approval_Step</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>CommissionLineItem__c.Status__c</field>
            <operation>equals</operation>
            <value>Invoice Ready,Invoice Rejected</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Invoice_Approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Send_to_SAP</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Invoice_Rejected</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Invoice_submition</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>Commission Line Items Approval</label>
    <processOrder>1</processOrder>
