<apex:page showHeader="false" sidebar="false" applyHtmlTag="False" applyBodyTag="false" renderAs="pdf" controller="CommOfferExtension">
    <html>
        <head>
            <style>
                
                @page {
                size: A4;
                margin: 30px;
                }
                
                body {
                font-family: "Times New Roman", serif;
                font-size: 13px;
                color: #000;
                }
                
                /* ===== HEADER LOGO ===== */
                .logo {
                font-size: 60px;
                color: #c00000;
                font-weight: normal;
                }
                
                /* ===== TITLE ===== */
                .title {
                text-align: center;
                font-size: 20px;
                font-weight: bold;
                margin: 20px 0;
                }
                
                /* ===== TEXT ===== */
                .section p {
                margin: 6px 0;
                }
                
                /* ===== TABLE ===== */
                table {
                width: 100%;
                border-collapse: collapse;
                }
                
                td, th {
                border: 1px solid #000;
                padding: 6px;
                }
                
                th {
                text-align: center;
                font-weight: bold;
                }
                
                /* ===== FOOTER ===== */
                .footer {
                bottom: 20px;
                width: 100%;
                font-size: 11px;
                }
                
                .footerTable {
                width: 100%;
                }
                
                .footerLeft {
                text-align: left;
                }
                
                .footerRight {
                text-align: right;
                font-weight: bold;
                }
                .rentTable {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                margin-bottom: 0;
                }
                
                
                .rentTable th,
                .rentTable td {
                border: 1px solid #222222;
                padding: 5px 5px;
                vertical-align: middle;
                text-align: center;
                font-size: 9px;
                }
                
                .sectionTitleTable{
                width:100%;
                border-collapse:collapse;
                table-layout:fixed;
                margin-top:5px;
                margin-bottom:0;
                }
                
                .sectionTitleTable td{
                border:1px solid #222222;
                border-bottom:none;
                text-align:center;
                font-weight:bold;
                font-size:12px;
                padding:5px 0;
                }
                
                
                .rentTable th {
                font-weight: bold;
                font-size: 9px;
                }
                
                
                .rentPeriod {
                width: 21%;
                }
                
                
                .rentStart {
                width: 19%;
                }
                
                
                .rentEnd {
                width: 19%;
                }
                
                
                .rentPerSqm {
                width: 21%;
                }
                
                
                .rentTotal {
                width: 20%;
                }
                
                
                .amountTable {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                margin-top: 18px;
                }
                
                
                .amountTable td {
                border: 1px solid #222222;
                padding: 6px 7px;
                vertical-align: top;
                font-size: 10px;
                }
                
                
                .amountLabel {
                width: 37%;
                font-weight: bold;
                }
                
                
                .amountValue {
                width: 63%;
                }
                
                
                .serviceChargeTable {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                }
                
                
                .serviceChargeTable td {
                border: 1px solid #222222;
                padding: 6px 7px;
                vertical-align: top;
                font-size: 10px;
                }
                
                
                .serviceChargeLabel {
                width: 37%;
                font-weight: bold;
                }
                
                
                .serviceChargeDetails {
                width: 63%;
                }
                
                
                .serviceChargeSubTable {
                width: 100%;
                border-collapse: collapse;
                }
                
                
                .serviceChargeSubTable td {
                border: 1px solid #222222;
                padding: 5px;
                vertical-align: top;
                }
                
                
                .serviceChargeSubLabel {
                width: 35%;
                }
                
                
                .serviceChargeSubValue {
                width: 65%;
                }
                
                
                .turnoverTable {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
                }
                
                
                .turnoverTable td {
                border: 1px solid #222222;
                padding: 6px 7px;
                vertical-align: top;
                font-size: 10px;
                }
                
                
                .turnoverLabel {
                width: 37%;
                font-weight: bold;
                }
                
                
                .turnoverValue {
                width: 63%;
                }
                
                
                .turnoverSubTable {
                width: 100%;
                border-collapse: collapse;
                }
                
                
                .turnoverSubTable td {
                border: 1px solid #222222;
                padding: 5px;
                }
                
                
                .turnoverSubLabel {
                width: 35%;
                }
                
                
                .turnoverSubValue {
                width: 65%;
                }
                
                
                .description {
                text-align: justify;
                line-height: 1.3;
                }
                
                
                .amount {
                white-space: nowrap;
                }
                
                
                .textRight {
                text-align: right;
                }
                
                
                .textCenter {
                text-align: center;
                }
                
                
                .bold {
                font-weight: bold;
                }
                
                
                .noBorder {
                border: none !important;
                }
                
                
                .keepTogether {
                page-break-inside: avoid;
                }
                
                
                .rentTable tr {
                page-break-inside: avoid;
                }
                
                
                .smallText {
                font-size: 9px;
                }
                
                .acceptanceSection {
                width: 100%;
                margin-top: 25px;
                font-size: 11px;
                line-height: 1.4;
                }
                
                .contactText {
                margin-top: 15px;
                text-align: justify;
                line-height: 1.5;
                }
                
            </style>
        </head>
        
        <body>
            
            <!-- ===== LOGO ===== -->
            <div class="logo">Bloom</div>
            
            <!-- ===== TITLE ===== -->
            <div class="title">Renewal Offer</div>
            
            <!-- ===== BASIC INFO ===== -->
            <div class="section"> 
                <p><b>Date:</b>
                        <apex:outputText value="{0,date,d MMMM yyyy}">
                            <apex:param value="{!wrapper.todayDate}"/>
                        </apex:outputText>
                    </p>
                <p><b>Tenant Name:</b>{!wrapper.tenantName}</p>
                <p>Dear</p>
            </div>
            
            <!-- ===== PROPERTY DETAILS ===== -->
            <table>
                <tr><td><b>Development Name:</b></td><td>{!wrapper.developmentName}</td></tr>
                <tr><td><b>Unit Type:</b></td><td> {!wrapper.unitType}</td></tr>
                <tr><td><b>Unit Number:</b></td><td>{!wrapper.unitNumber}</td></tr>
                <tr><td><b>Location:</b></td><td>{!wrapper.location}</td></tr>
                <tr><td><b>Internal Area:</b></td><td> <apex:outputText value="{0,number,#,##0.##}">
                            <apex:param value="{!wrapper.internalArea}"/>
                        </apex:outputText> m2 (approximately)</td></tr>
                <tr><td><b>External Area:</b></td><td><apex:outputText value="{0,number,#,##0.##}"
                                         rendered="{!NOT(ISNULL(wrapper.externalArea))}">
                            
                            <apex:param value="{!wrapper.externalArea}"/>
                            
                        </apex:outputText></td></tr>
                <tr><td><b>Lease Terms:</b></td><td>{!wrapper.leaseTerms}</td></tr>
                <tr><td><b>Renewal Date:</b></td><td> <apex:outputText value="{0,date,d MMMM yyyy}">
                            <apex:param value="{!wrapper.renewalDate}"/>
                        </apex:outputText></td></tr>
                <tr><td><b>Renewal Expiry:</b></td><td>  <apex:outputText value="{0,date,d MMMM yyyy}">
                            <apex:param value="{!wrapper.renewalExpiry}"/>
                        </apex:outputText></td></tr>
                <tr><td><b>Current Rent Amount:</b></td><td>AED &nbsp;
                        
                        <apex:outputText value="{0,number,#,##0.00}">
                            <apex:param value="{!wrapper.currentRentAmount}"/>
                        </apex:outputText></td></tr>
            </table>
            
            <!-- ===== RENT TABLE ===== 
            <table style="width:100%; border-collapse: collapse; font-size:12px;">
                
                <!-- ===== Base Rent Schedule ===== 
                <tr>
                    <th colspan="5" style="text-align:center;">Base Rent Schedule</th>
                </tr>
                
                <tr>
                    <th style="width:22%;">Lease Period</th>
                    <th style="width:18%;">Start</th>
                    <th style="width:18%;">End</th>
                    <th style="width:20%;">Base Rent per sqm (excl. VAT) AED</th>
                    <th style="width:22%;">Total Base Rent (excl. VAT) AED</th>
                </tr>
                
                <tr>
                    <td>Lease Period 1</td>
                    <td>29 September 2026</td>
                    <td>28 September 2027</td>
                    <td>2,500.00</td>
                    <td>910,000.00</td>
                </tr>
                
                <tr>
                    <td>Lease Period 2</td>
                    <td>29 September 2027</td>
                    <td>28 September 2028</td>
                    <td>2,625.00</td>
                    <td>955,500.00</td>
                </tr>
                
                <tr>
                    <td>Lease Period 3</td>
                    <td>29 September 2028</td>
                    <td>28 September 2029</td>
                    <td>2,756.25</td>
                    <td>1,003,275.00</td>
                </tr>
                
                <tr>
                    <td>Lease Period 4</td>
                    <td>29 September 2029</td>
                    <td>28 September 2030</td>
                    <td>2,894.06</td>
                    <td>1,053,439.00</td>
                </tr>
                
                <tr>
                    <td>Lease Period 5</td>
                    <td>29 September 2030</td>
                    <td>28 September 2031</td>
                    <td>3,038.77</td>
                    <td>1,106,110.00</td>
                </tr>
                
                <!-- ===== SERVICE CHARGE (FIXED) ===== 
                <tr>
                    <td><b>Service Charge</b></td>
                    <td><b>Amount for Lease Period 1</b></td>
                    <td colspan="3">
                        AED 91,000 (excl. VAT), being AED 250 per square meter
                    </td>
                </tr>
                
                <tr>
                    <td></td>
                    <td><b>Specific conditions</b></td>
                    <td colspan="3">
                        The Service Charge payable by the Tenant shall increase on the commencement date 
                        of each new Lease Period by five percent (5%) greater than the amount payable in 
                        the preceding Lease Period.
                    </td>
                </tr>
                
                <!-- ===== Marketing Fund ===== 
                <tr>
                    <td><b>Marketing Fund</b></td>
                    <td colspan="4">
                        AED 45,500 (excl. VAT) being 2.5% of Annual Base Rent
                    </td>
                </tr>
                
                <!-- ===== Gross Rent ===== 
                <tr>
                    <td><b>Gross Rent Amount Year 1</b></td>
                    <td colspan="4">AED 1,046,500.00</td>
                </tr>
                
                <!-- ===== Chilled Water ===== 
                <tr>
                    <td><b>Chilled Water</b></td>
                    <td colspan="4">Metered</td>
                </tr>
                
                <!-- ===== Security Deposit ===== 
                <tr>
                    <td><b>Security Deposit (25% of Base/annum)</b></td>
                    <td colspan="4">AED 227,500.00</td>
                </tr>
                
                <!-- ===== Turnover Rent ===== 
                <tr>
                    <td><b>Turnover Rent</b></td>
                    <td colspan="4">
                        means for each Lease Period an amount equal to the amount (if any) by which the 
                        Turnover Percentage of Gross Revenue exceeds the Base Rent due and payable in 
                        the same Lease Period.
                    </td>
                </tr>
                
                <tr>
                    <td></td>
                    <td><b>Turnover Period</b></td>
                    <td colspan="3">29 September 2026 to 28 September 2031</td>
                </tr>
                
                <tr>
                    <td></td>
                    <td><b>Percentage</b></td>
                    <td colspan="3">12%</td>
                </tr>
                
                <!-- ===== Renewal Fee ===== 
                <tr>
                    <td><b>Renewal Fee</b></td>
                    <td colspan="4">AED 520.00</td>
                </tr>
                
            </table>-->
            
            <!-- ============================= -->
            <!-- BASE RENT SCHEDULE -->
            <!-- ============================= -->
            <br/>
            <table class="sectionTitleTable">
                <tr>
                    <td>Base Rent Schedule</td>
                </tr>
            </table>
            <table class="rentTable">
                <thead>
                    <tr>
                        
                        <th class="rentPeriod">
                            Lease Period
                        </th>
                        
                        <th class="rentStart">
                            Start
                        </th>
                        
                        <th class="rentEnd">
                            End
                        </th>
                        
                        <th class="rentPerSqm">
                            Base Rent per<br/>
                            sqm (excl.<br/>
                            VAT)<br/>
                            AED 
                        </th>
                        
                        <th class="rentTotal">
                            Total Base Rent<br/>
                            (excl. VAT)<br/>
                            AED 
                        </th>
                        
                    </tr>
                    
                </thead>
                
                
                <tbody>
                    
                    <apex:repeat value="{!wrapper.baseRentRows}"
                                 var="row">
                        
                        <tr>
                            
                            <td class="rentPeriod">
                                {!row.leasePeriod}
                            </td>
                            
                            
                            <td class="rentStart">
                                
                                <apex:outputText value="{0,date,d MMMM yyyy}">
                                    <apex:param value="{!row.startDate}"/>
                                </apex:outputText>
                                
                            </td>
                            
                            
                            <td class="rentEnd">
                                
                                <apex:outputText value="{0,date,d MMMM yyyy}">
                                    <apex:param value="{!row.endDate}"/>
                                </apex:outputText>
                                
                            </td>
                            
                            
                            <td class="rentPerSqm">
                                
                                <apex:outputText value="{0,number,#,##0.00}">
                                    <apex:param value="{!row.baseRentPerSqm}"/>
                                </apex:outputText>
                                
                            </td>
                            
                            
                            <td class="rentTotal">
                                
                                <apex:outputText value="{0,number,#,##0.00}">
                                    <apex:param value="{!row.totalBaseRent}"/>
                                </apex:outputText>
                                
                            </td>
                            
                        </tr>
                        
                    </apex:repeat>
                    
                </tbody>
                
            </table>
            
            
            <!-- ============================= -->
            <!-- SERVICE CHARGE -->
            <!-- ============================= -->
            
            <table class="serviceChargeTable">
                
                <tr>
                    
                    <td class="serviceChargeLabel">
                        Service Charge
                    </td>
                    
                    
                    <td class="serviceChargeDetails">
                        
                        <table class="serviceChargeSubTable">
                            
                            <tr>
                                
                                <td class="serviceChargeSubLabel">
                                    
                                    Amount for<br/>
                                    Lease Period 1
                                    
                                </td>
                                
                                
                                <td class="serviceChargeSubValue">
                                    
                                    AED &nbsp;
                                    
                                    <apex:outputText value="{0,number,#,##0.00}">
                                        <apex:param value="{!wrapper.serviceChargeAmount}"/>
                                    </apex:outputText>
                                    
                                    (excl. VAT), being AED &nbsp;
                                    
                                    <apex:outputText value="{0,number,#,##0.00}">
                                        <apex:param value="{!wrapper.serviceChargePerSqm}"/>
                                    </apex:outputText>
                                    
                                    per square meter
                                    
                                </td>
                                
                            </tr>
                            
                            
                            <tr>
                                
                                <td class="serviceChargeSubLabel">
                                    
                                    Specific conditions
                                    
                                </td>
                                
                                
                                <td class="serviceChargeSubValue description">
                                    
                                    The Service Charge payable by the Tenant shall
                                    increase on the commencement date of each
                                    new Lease Period by five percent (5%) greater
                                    than the amount payable in the preceding Lease
                                    Period.
                                    
                                </td>
                                
                            </tr>
                            
                        </table>
                        
                    </td>
                    
                </tr>
                
                
                <!-- ============================= -->
                <!-- MARKETING FUND -->
                <!-- ============================= -->
                
                
                
                <tr>
                    
                    <td class="amountLabel">
                        Marketing Fund
                    </td>
                    
                    
                    <td class="amountValue">
                        
                        AED &nbsp;
                        
                        <apex:outputText value="{0,number,#,##0.00}">
                            <apex:param value="{!wrapper.marketingFundAmount}"/>
                        </apex:outputText>
                        
                        (excl. VAT) being 2.5% of Annual Base Rent
                        
                    </td>
                    
                </tr>
                
                
                <!-- ============================= -->
                <!-- GROSS RENT -->
                <!-- ============================= -->
                
                <tr>
                    
                    <td class="amountLabel">
                        Gross Rent Amount Year 1
                    </td>
                    
                    
                    <td class="amountValue">
                        
                        AED &nbsp;
                        
                        <apex:outputText value="{0,number,#,##0.00}">
                            <apex:param value="{!wrapper.grossRentAmountYear1}"/>
                        </apex:outputText>
                        
                    </td>
                    
                </tr>
                
                
                <!-- ============================= -->
                <!-- CHILLED WATER -->
                <!-- ============================= -->
                
                <tr>
                    
                    <td class="amountLabel">
                        Chilled Water:
                    </td>
                    
                    
                    <td class="amountValue">
                        {!wrapper.chilledWater}
                    </td>
                    
                </tr>
                
                
                <!-- ============================= -->
                <!-- SECURITY DEPOSIT -->
                <!-- ============================= -->
                
                <tr>
                    
                    <td class="amountLabel">
                        Security Deposit (25% of Base/annum):
                    </td>
                    
                    
                    <td class="amountValue">
                        
                        AED &nbsp;
                        
                        <apex:outputText value="{0,number,#,##0.00}">
                            <apex:param value="{!wrapper.securityDeposit}"/>
                        </apex:outputText>
                        
                    </td>
                    
                </tr>
                
                
                <!-- ============================= -->
                <!-- TURNOVER RENT -->
                <!-- ============================= -->
                
                
                
                <tr>
                    
                    <td class="turnoverLabel">
                        Turnover Rent
                    </td>
                    
                    
                    <td class="turnoverValue">
                        
                        <div class="description">
                            
                            means for each Lease Period an amount equal
                            to the amount (if any) by which the Turnover
                            Percentage of Gross Revenue exceeds the Base
                            Rent due and payable in the same Lease Period.
                            
                        </div>
                        
                        
                        <table class="turnoverSubTable">
                            
                            <tr>
                                <td class="turnoverSubLabel">
                                    Turnover
                                </td>
                                
                                <td class="turnoverSubValue">
                                    
                                    <apex:outputText value="{0,date,d MMMM yyyy}">
                                        <apex:param value="{!wrapper.torStartDate}"/>
                                    </apex:outputText>
                                    
                                    &nbsp;to&nbsp;
                                    
                                    <apex:outputText value="{0,date,d MMMM yyyy}">
                                        <apex:param value="{!wrapper.torEndDate}"/>
                                    </apex:outputText>
                                    
                                </td>
                            </tr>
                            
                            <tr>
                                <td class="turnoverSubLabel">
                                    Percentage
                                </td>
                                
                                <td class="turnoverSubValue">
                                    
                                    <apex:outputPanel rendered="{!wrapper.torPercentage > 0}">
                                        
                                        <apex:outputText value="{0,number,#,##0.##}%">
                                            <apex:param value="{!wrapper.torPercentage}"/>
                                        </apex:outputText>
                                        
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel rendered="{!wrapper.torPercentage <= 0}">
                                        Not Applicable
                                    </apex:outputPanel>
                                    
                                </td>
                            </tr>
                            
                        </table>
                        
                    </td>
                    
                </tr>
                
                
                <!-- ============================= -->
                <!-- RENEWAL FEE -->
                <!-- ============================= -->
                
                <tr>
                    
                    <td class="turnoverLabel">
                        Renewal Fee
                    </td>
                    
                    
                    <td class="turnoverValue">
                        
                        AED &nbsp;
                        
                        <apex:outputText value="{0,number,#,##0.00}">
                            <apex:param value="{!wrapper.renewalFee}"/>
                        </apex:outputText>
                        
                    </td>
                    
                </tr> 
                
            </table>
            
            <!-- ===== FOOTER ===== -->
            <div class="footer" style="margin:5px;padding:1rem;">
                <table class="footerTable" style="border: 0px;">
                    <tr style="border: 0px;">
                        <td class="footerLeft" style="border: 0px;">
                            <b>Bloom Properties LLC</b><br/>
                            Abu Dhabi, United Arab Emirates<br/>
                            P.O. Box 28928 | T. +971 2 6969500 | F. +971 2 6431144<br/>
                            A National Holding Company
                        </td>
                        
                        <td class="footerRight" style="border: 0px;">
                            bloomproperties.com
                        </td>
                    </tr>
                </table>
            </div>
            
        </body>
    </html>
</apex:page>