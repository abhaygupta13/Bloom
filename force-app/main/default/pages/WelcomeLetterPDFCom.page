<apex:page controller="WelcomeLetterPDFController"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           applyBodyTag="false"
           applyHtmlTag="false">
    
    <html xmlns="http://www.w3.org/1999/xhtml">
        
        <head>
            
            <style>
                
                .retailText { width: 200px; text-align: center; font-family: Arial, Helvetica, sans-serif; font-size: 15pt; font-weight: bold; margin-top: 5px; }
                
                @page {
                size: A4;
                margin: 30mm 18mm 25mm 18mm;
                
                @top-left {
                content: element(pageHeader);
                }
                
                @bottom-left {
                content: element(footerAddress);
                }
                
                @bottom-right {
                content: element(footerWebsite);
                }
                }
                
                .footerAddress {
                position: running(footerAddress);
                font-family: Arial, Helvetica, sans-serif;
                font-size: 7pt;
                color: #666666;
                line-height: 1.15;
                text-align: left;
                }
                
                .footerWebsite {
                position: running(footerWebsite);
                font-family: Arial, Helvetica, sans-serif;
                font-size: 7pt;
                color: #666666;
                text-align: right;
                white-space: nowrap;
                }
                
                .dateDay {
                font-size: 10pt;
                }
                
                .dateSuffix {
    font-size: 6pt;
    vertical-align: super;
    position: relative;
    top: -0.25em;
}
                
                .pageHeader {
                position: running(pageHeader);
                width: 200px;
                text-align: left;
                }
                
                .pageHeader img {
                width: 165px;
                }
                
                body{
                
                font-family:Arial,Helvetica,sans-serif;
                font-size:10pt;
                color:#000000;
                line-height:1.35;
                
                }
                
                table{
                
                border-collapse:collapse;
                width:100%;
                
                }
                
                .logo{
                
                width:165px;
                
                }
                
                .header td{
                
                vertical-align:top;
                
                }
                
                .details{
                
                margin-top:15px;
                
                }
                
                .details td{
                
                padding:3px 0;
                
                }
                
                .label{
                
                width:160px;
                
                }
                
                .subject {
                margin-top: 15px;
                font-weight: bold;
                font-size: 12pt;
                text-decoration: underline;
                }
                
                .text{
                
                margin-top:10px;
                text-align:justify;
                
                }
                
                .itemTable{
                
                margin-top:6px;
                
                }
                
                .itemTable td{
                
                vertical-align:top;
                padding-bottom:6px;
                
                }
                
                .bullet {
                width: 25px;
                vertical-align: top;
                }
                
                
                .subBullet {
                width: 25px;
                padding-left: 18px;
                vertical-align: top;
                font-weight: normal;
                }
                
                 .helpTable {
    width: 40%;
    margin-top: 8px;
    border-collapse: collapse;
    border: 1px solid #000;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 10pt;
}

.helpTable th,
.helpTable td {
    border: 1px solid #000;
    padding: 6px 8px;
}

.helpTable th {
    font-weight: bold;
    text-align: center;
    background: #EDEDED;
}

.helpTable td:first-child {
    width: 80%;
}

.helpTable td:last-child {
    width: 20%;
    text-align: center;
    font-weight: bold;
}
                
                .signatureTable {
                width: 100%;
                margin-top: 25px;
                border-collapse: collapse;
                table-layout: fixed;
                }
                
                .signatureTable td {
                padding-top: 12px;
                vertical-align: bottom;
                font-size: 10pt;
                }
                
                .signatureLabel,
                .signatureLabelRight {
                width: 22%;
                font-weight: bold;
                white-space: normal;   /* allow label wrapping */
                }
                
                .signatureLabelRight {
                padding-left: 18px;
                }
                
                .signatureValue,
                .signatureValueRight {
                width: 28%;
                border-bottom: 1px solid #000;
                height: 18px;
                padding: 0 4px 2px 4px;
                white-space: normal;   /* allow long values to wrap */
                word-wrap: break-word;
                }
                
                .pageBreak{
                
                page-break-before:always;
                
                }
                
            </style>
            
        </head>
        
        <body>
            
            <!-- Header that repeats on every PDF page -->
            <div class="pageHeader">
                <apex:image value="{!URLFOR($Resource.BloomLogo)}"
                            styleClass="logo"/>
                <div class="retailText">RETAIL</div>
            </div>
            
            <!-- Footer Address -->
            <div class="footerAddress">
                <b>Bloom Retail Management Services L.L.C.</b> <br/>
                7th Floor, Bloom Central, Sheikh Rashid Bin Saeed St. Rd 18<br/>
                P.O. Box 28928, Abu Dhabi, UAE | T. +971 2 6969500<br/>
                A National Holding Company
            </div>
            
            <!-- Footer Website -->
            <div class="footerWebsite">
               <b>www.bloomholding.com</b> 
            </div>
            <br/>
            <!-- Your actual document content starts here -->
            <table style="margin-top:0px; width:100%;">
                <tr>
                    <td>
                        <apex:outputText value="{!formattedTodayDate}" escape="false"/>
                    </td>
                </tr>
            </table>
            
            
            <table class="details">
                
                <tr>
                    
                    <td>
                        
                        <apex:outputText value="{!accountName}"/>
                        
                    </td>
                    
                </tr>
                
                <tr>
                    
                    <td>
                        
                        <apex:outputText value="{!companyName}"/>
                        
                    </td>
                    
                </tr>
                
                <tr>
                    <td>
                        <apex:outputText value="{!unitNumber}"/>
                    </td>
                </tr>
                
                <tr>
                    <td>
                        <apex:outputText value="{!address}" escape="false"/>
                    </td>
                    <td></td>
                </tr>
                <br/>
                <tr>
    <td>
        Reference No.: &nbsp;
        <apex:outputText value="{!referenceNumber}"/>
    </td>
</tr>
                
            </table>
            <br/>
            
            <p class="subject">
                Subject: New Unit Opening Mandatory Requirements: 
                
            </p>
            
            <p>
                Dear&nbsp;
                <apex:outputText value="{!accountFirstName}"/>,
            </p>
            
            <p class="text">
                
                We would like to thank you for choosing Bloom Holding as your business partner.
                Below is a short summary of key points that will be discussed during our meeting 15 days prior to the opening.    </p>
            <table class="itemTable">
                
                <tr>
                    <td class="bullet">1.</td>
                    <td>
                        Trade License (Valid) 
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">2.</td>
                    <td>
                        
                        Insurance Policy – All 4 Insurance documents in full as per signed lease agreement: 
                        (Entire Leased Area / Store Room):             
                    </td>
                </tr>
                
                <!-- Sub-bullet -->
                <tr>
                    <td colspan="2" style="padding-left:50px;">
                        <span style="padding-right:8px;">&#8226;</span>
                        Property All Risk Insurance:
                    </td>
                </tr>
                
                <tr>
                    <td colspan="2" style="padding-left:50px;">
                        <span style="padding-right:8px;">&#8226;</span>
                        Business Interruption Insurance
                        (With a minimum indemnity period of at least twelve (12) months):
                    </td>
                </tr>
                
                <tr>
                    <td colspan="2" style="padding-left:50px;">
                        <span style="padding-right:8px;">&#8226;</span>
                        Public Liability Insurance: 5 Million AED.
                    </td>
                </tr>
                
                <tr>
                    <td colspan="2" style="padding-left:50px;">
                        <span style="padding-right:8px;">&#8226;</span>
                        Workmen's Compensation and Employers Liability Insurance:
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">3.</td>
                    <td>
                        
                        Fire Alarm Maintenance Contract Agreement (AMC),
                        by ADCD approved contractor.
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">4.</td>
                    <td>
                        
                        Fire Fighting System Maintenance Contract Agreement (AMC),
                        by ADCD approved contractor.
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">5.</td>
                    <td>
                        
                        General Maintenance Contract for Air Conditioning,
                        Electrical,
                        Mechanical,
                        Plumbing,
                        Civil and Carpentry Works.
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">6.</td>
                    <td>
                        
                        Pest Control Contract for the entire leased area – 
                        Pest control needs to be conducted prior to unit opening  
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">7.</td>
                    <td>
                        
                        Housekeeping maintenance contract 
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">8.</td>
                    <td>
                        
                        Tenant Contact Information Form completed in Excel 
                        (not handwritten) and returned via email to 
                        
                        
                        <a href="mailto:{!$Label.TenantEnquiryEmail}">
                            <apex:outputText value="{!$Label.TenantEnquiryEmail}"/>;_
                        </a>
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">9.</td>
                    <td>
                        
                        Late Opening Penalty to be settled in full prior to 
                        removal of hoarding and unit permitted to open 
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">10.</td>
                    <td>
                        
                        Provide proof of account set up with ADDC for electricity meter and water (if applicable). 
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">11.</td>
                    <td>
                        
                        Ista NOC for Chilled Water Connection (if applicable) 
                        
                    </td>
                </tr>
                
                <tr>
                    <td class="bullet">12.</td>
                    <td>
                        
                        There will be a satisfaction survey conducted in the year.
                        A team from Bloom will contact you to acquire your valuable 
                        feedback and we request your full participation in this activity. 
                        
                    </td>
                </tr>
                
                
                
                 <tr>
    <td class="bullet">13.</td>
    <td>
        Help Line Numbers Reminder:

        <table class="helpTable">
            
            <tr>
                <td>Abu Dhabi Police Hotline:</td>
                <td>999</td>
            </tr>
            <tr>
                <td>Ambulance Service Hotline:</td>
                <td>998</td>
            </tr>
            <tr>
                <td>Fire Fighting Hotline:</td>
                <td>997</td>
            </tr>
        </table>
    </td>
</tr>   
            </table>
            
            
            <br/>
            
            
            
            <p class="text">
                
                Please do not hesitate to contact us via email
                
                
                <a href="mailto:{!$Label.TenantEnquiryEmail}">
                    <apex:outputText value="{!$Label.TenantEnquiryEmail}"/>
                </a>
                should you require clarification or assistance.
                
            </p>
            
            <p>
                
                Yours Sincerely,
                
            </p>
            
             <br/>
            
            <p>
                
                <b>
                    
                    Atif Chaudhary
                    
                </b>
                
                <br/>
                
                General Manager - Malls &amp; Retail
                
            </p>
            
            <hr style="margin-top:25px; margin-bottom:15px; border:0; border-top:1px solid #000;"/>
            
            <p>
                
                <b>
                    
                    I acknowledge receipt of this letter
                    
                </b>
                
            </p>
            
            <!-- Signature section -->
            <table class="signatureTable">
                <tr>
                    <td class="signatureLabel">Signature:</td>
                    <td class="signatureValue"></td>
                    
                    <td class="signatureLabelRight">Date:</td>
                    <td class="signatureValueRight"></td>
                </tr>
                
                <tr>
                    <td class="signatureLabel">Name (in print letters):</td>
                    <td class="signatureValue">
                        <apex:outputText value="{!accountName}"/>
                    </td>
                    
                    <td class="signatureLabelRight">Unit Number:</td>
                    <td class="signatureValueRight">
                        <apex:outputText value="{!unitNumber}"/>
                    </td>
                </tr>
                
                <tr>
                    <td class="signatureLabel">Designation:</td>
                    <td class="signatureValue"></td>
                    
                    <td class="signatureLabelRight">Company Name:</td>
                    <td class="signatureValueRight">
                        <apex:outputText value="{!companyName}"/>
                    </td>
                </tr>
            </table>
        </body>
        
    </html>
    
</apex:page>