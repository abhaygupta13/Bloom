<apex:page renderAs="pdf"
  controller="BCAPP_SOAPDFController"
  showHeader="false" sidebar="false"
  standardStylesheets="false" applyBodyTag="false" applyHtmlTag="false">

  <html>
    <head>
      <style>
        @page { size: 297mm 420mm; margin: 0; }
      </style>
    </head>

    <!-- Base font down to 10px -->
    <body style="margin-top:5%;font-family:Arial,Helvetica,sans-serif;font-size:10px;color:#1d1d1f;">
      <!-- Wrapper -->
      <div style="padding:16px 18px 22px 18px;">

        <!-- Header -->
        <table style="width:100%;margin-bottom:8px;">
          <tr>
            <td style="width:50%;vertical-align:top;">
              <!-- Brand size up for prominence -->
               <apex:image value="{!$Resource.BloomLogo}" width="160px"/>
              <div style="font-size:10px;color:#808080;">COMMUNITY MANAGEMENT</div>
            </td>
            <td style="width:10%;vertical-align:top;text-align:left;font-size:10.5px;line-height:1.45;font-weight: bolder;">
              BLOOM COMMUNITY MANAGEMENT<br/>
              PO BOX 28398, ABU DHABI<br/>
              UNITED ARAB EMIRATES<br/>
              Email: SCQuery@bloomholding.com
            </td>
          </tr>
        </table>
          <br />
        <!-- Title Bar -->
        <div style="font-weight:700;text-transform:uppercase;font-size:14px;color:#fff;
                    background:#970517;padding:2px 10px;letter-spacing:.3px;text-align:center;
                    margin:6px 0 6px 0;border:1px solid #000;">
          SERVICE CHARGES STATEMENT
        </div>

        <!-- Info Grid -->
        <table style="width:100%;border-collapse:collapse;table-layout:fixed;margin:0 0 8px 0;">
          <tr>
            <!-- LEFT STACK -->
            <td style="width:50%;vertical-align:top;padding-right:10px;">
              <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                <tr>
                  <td style="width:42%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Project</td>
                  <td style="width:58%;border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;word-wrap:break-word;">{!projectName}</td>
                </tr>
                <tr>
                  <td style="width:42%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Property Details</td>
                  <td style="border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;word-wrap:break-word;">{!propertyDetails}</td>
                </tr>
                <tr>
                  <td style="width:42%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Customer ID</td>
                  <td style="border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;word-wrap:break-word;">{!customerIdText}</td>
                </tr>
                <tr>
                  <td style="width:42%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Customer Name</td>
                  <td style="border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;word-wrap:break-word;">{!customerName}</td>
                </tr>
                <tr>
                  <td style="width:42%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Contract Number</td>
                  <td style="border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;word-wrap:break-word;">{!contractNumber}</td>
                </tr>
                <tr>
                  <td style="width:42%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Customer TRN</td>
                  <td style="border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;word-wrap:break-word;">{!customerTRN}</td>
                </tr>
              </table>
            </td>

            <!-- SPACER -->
            <td style="width:10%;border:none;"></td>

            <!-- RIGHT STACK -->
            <td style="width:40%;vertical-align:middle;padding-left:10px;">
              <table style="width:100%;border-collapse:collapse;table-layout:fixed;">
                <tr>
                  <td style="width:50%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Statement Type</td>
                  <td style="width:50%;border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;">Detail</td>
                </tr>
                <tr>
                  <td style="width:50%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Statement Period</td>
                  <td style="border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;word-wrap:break-word;">{!statementPeriod}</td>
                </tr>
                <tr>
                  <td style="width:50%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Printing Date</td>
                  <td style="border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;">
                    <apex:outputText value="{0,date,dd-MMM-yyyy}">
                      <apex:param value="{!printingDate}"/>
                    </apex:outputText>
                  </td>
                </tr>
                <tr>
                  <td style="width:50%;background:#970517;color:#fff;border:1px solid #7a7a7a;border-bottom:1px solid;padding:2px 4px;font-weight:900;font-size:11px;vertical-align:bottom;white-space:normal;">Generated By</td>
                  <td style="width:50%;border:1px solid #7a7a7a;border-bottom:1px solid;padding:0px 2px;font-size:11px;vertical-align:bottom;">Bloom Community App</td>
                </tr>
              </table>
            </td>
          </tr>
        </table>

        <!-- Statement Table -->
        <table style="width:100%;border-collapse:collapse;table-layout:fixed;margin-top:2px;border: 1px solid;">
          <thead>
            <tr>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;width:10%;text-align:center;">Date</th>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;width:12%;text-align:center;">Document No.</th>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;text-align:left;">Description</th>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;width:13%;text-align:center;">Reference</th>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;width:10%;text-align:right;">Debit</th>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;width:10%;text-align:right;">Credit</th>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;width:12%;text-align:right;">Balance</th>
              <th style="padding:2px 4px;background:#970517;color:#fff;font-weight:900;font-size:11px;width:8%;text-align:center;">Status</th>
            </tr>
          </thead>

          <tbody>
            <apex:repeat value="{!rows}" var="r">
              <tr>
                <td style="padding:2px 4px;font-size:11px;text-align:center;background:#fff;vertical-align:middle;">
                  <apex:outputText value="{0,date,dd-MMM-yyyy}">
                    <apex:param value="{!r.dateVal}"/>
                  </apex:outputText>
                </td>
                <td style="padding:2px 4px;font-size:11px;text-align:center;background:#fff;vertical-align:middle;">{!r.docNo}</td>
                <td style="padding:2px 4px;font-size:11px;background:#fff;text-align:left;vertical-align:middle;">{!r.description}</td>
                <td style="padding:2px 4px;font-size:11px;text-align:center;background:#fff;vertical-align:middle;">{!r.reference}</td>
                <td style="padding:2px 4px;font-size:11px;text-align:right;background:#fff;vertical-align:middle;">
                  <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!r.debit}"/></apex:outputText>
                </td>
                <td style="padding:2px 4px;font-size:11px;text-align:right;background:#fff;vertical-align:middle;">
                  <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!r.credit}"/></apex:outputText>
                </td>
                <td style="padding:2px 4px;font-size:11px;text-align:right;background:#fff;vertical-align:middle;">
                  <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!r.balance}"/></apex:outputText>
                </td>
                <td style="padding:2px 4px;font-size:11px;text-align:center;background:#fff;vertical-align:middle;">{!r.docType}</td>
              </tr>
            </apex:repeat>
          </tbody>

          <tfoot>
            <tr>
              <td colspan="4" style="border:1px solid #7a7a7a;padding:2px 4px;text-align:right;font-weight:900;background:#970517;color:#fff;font-size:11px;">Total</td>
              <td style="border:1px solid #7a7a7a;padding:2px 4px;text-align:right;background:#970517;color:#fff;font-weight:900;font-size:11px;">
                <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!totalDebit}"/></apex:outputText>
              </td>
              <td style="border:1px solid #7a7a7a;padding:2px 4px;text-align:right;background:#970517;color:#fff;font-weight:900;font-size:11px;">
                <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!totalCredit}"/></apex:outputText>
              </td>
              <td style="border:1px solid #7a7a7a;padding:2px 4px;text-align:right;background:#970517;color:#fff;font-weight:900;font-size:11px;">
                <apex:outputText value="{0,number,###,##0.00}"><apex:param value="{!finalBalance}"/></apex:outputText>
              </td>
              <td style="border:1px solid #7a7a7a;padding:2px 4px;background:#970517;color:#970517;font-size:11px;">&nbsp;</td>
            </tr>
          </tfoot>
        </table>

        <!-- PAYMENT OPTION -->
        <div style="margin-top:12px;font-size:10px;line-height:1.5;">
          <!-- Section Title -->
          <div style="text-align:center;font-weight:700;text-decoration:underline;margin-bottom:6px;font-size:12px;">
            PAYMENT OPTION
          </div>

          <!-- Bank Details -->
          <div style="font-weight:700;text-decoration:underline;margin-bottom:2px;font-size:10px;">Bank Details (AED Only)</div>
          <table style="width:100%;border-collapse:collapse;margin-bottom:4px;font-size:10px;">
            <tr>
              <td style="width:160px;padding:2px 4px; font-size:11px;">Account Name:</td>
              <td style="padding:2px 4px;font-weight:700; font-size:11px;">{!bankAccountName}</td>
            </tr>
            <tr>
              <td style="padding:2px 4px; font-size:11px;">Account Number:</td>
              <td style="padding:2px 4px;font-weight:700; font-size:11px;">{!bankAccountNumber}</td>
            </tr>
            <tr>
              <td style="padding:2px 4px; font-size:11px;">IBAN:</td>
              <td style="padding:2px 4px;font-weight:700; font-size:11px;">{!bankIBAN}</td>
            </tr>
            <tr>
              <td style="padding:2px 4px; font-size:11px;">Swift Code:</td>
              <td style="padding:2px 4px;font-weight:700; font-size:11px;">{!bankSwift}</td>
            </tr>
            <tr>
              <td style="padding:2px 4px; font-size:11px;">Bank:</td>
              <td style="padding:2px 4px;font-weight:700; font-size:11px;">{!bankName}</td>
            </tr>
          </table>

          <!-- Credit Card -->
          <div style="font-weight:700;text-decoration:underline;margin:4px 0 2px 0;font-size:11px;">Credit Card:</div>
          <div style="padding:2px 4px;margin-bottom:4px;font-size:11px;">
            Payment using credit card is available at the community management office of your respective community
          </div>

          <!-- Cheque -->
          <div style="font-weight:700;text-decoration:underline;margin:4px 0 2px 0;font-size:11px;">Cheque:</div>
          <table style="width:100%;border-collapse:collapse;margin-bottom:4px;font-size:11px;">
            <tr>
              <td style="width:160px;padding:2px 4px; font-size:11px;">Payable to:</td>
              <td style="padding:2px 4px;font-weight:700; font-size:11px;">BLOOM GARDEN O A REAL ES MGT SP LLC</td>
            </tr>
          </table>

          <!-- Note -->
          <div style="font-weight:700;text-decoration:underline;margin:4px 0 2px 0;font-size:11px;">Note:</div>
          <div style="padding:2px 4px;font-size:11px;">1. Separate payment for each property.</div>
          <div style="padding:2px 4px;font-size:11px;">
            2. Please ensure to provide <span style="color:#b3002d;font-weight:700;">Property Details</span> &amp; 
            <span style="color:#b3002d;font-weight:700;">Customer ID</span> details for direct transfers/deposits.
          </div>

          <!-- Footer Note -->
          <div style="font-size:10px;font-style:italic;margin-top:6px;padding:2px 4px;">
            This is computer generated document and requires no signature
          </div>
        </div>

      </div>
    </body>
  </html>
</apex:page>