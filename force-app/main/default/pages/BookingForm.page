                <apex:outputPanel rendered="{!offerDetails.offerLinesApplied}" >
                    <b> Offer:</b> {!offerDetails.offerRecord.Name} 
                </apex:outputPanel>                
            </td>
        </tr>
        <tr>
            <td colspan="2"> 
                <apex:outputPanel rendered="{!offerDetails.offerLinesApplied}" >                    
