            @page {
            size: A4;
            margin:30mm 5mm;
            @bottom-left {
            content: element(footer);
            }
            @top-left {
            content: element(header);
            }
            @bottom-right {
            content: "Page " counter(page) " of " counter(pages);
            font-size: 12px;
            }
            }
            @page:first {
            @bottom-left {
            content: element(footer);
            }
            @top-left {
            content: element(header);
            }
            } 
            
            div.divFooter {
            display: block;
            padding: 5px;
            position: running(footer);
            }
            div.divHeader {
            margin:0px 0px;
            display: block;
            padding: 0px;
            position: running(header);
            }
            body {
            font-size:14px;
            font-family: Calibri, sans-serif;
            }
            table{
            width: 100%;
            }
            div.divFooter {
            display: block;
            padding: 5px;
            position: running(footer);
            }
            .termNCondition{
            //page-break-before: always;
            } 
            .greyColor{
            background: #ccc;
            }
            .contractTable{
            border-collapse: collapse;
            }
            .contractTable tr th{
            background:#f2f2f2;
            padding:8px;
            font-size:13px;
            color:#000;
            border: 1px solid #000;
            font-weight: 300;
            }
            .contractTable tr td{
            border: 1px solid #000;
            padding:8px;
            font-size:13px;
            color:#000;    
            vertical-align: middle;
            }
            .heading{
            font-size: 16px;
            text-align: center;
            font-weight: 600;
            }
            .contractTable tr td.noBorder{
            border: none;
            padding: 0 0 .5rem;
            }
            .importantRed{
            color: #ff0000;
            }
            .signatureLine{
            border-top: 1px solid #000;
            margin-top: 2rem;
            }
        </style>
        
        
    </head>
    
    <div class="divHeader">
    <div style="float:left; margin-top: 0px;"> <!-- Adjust the margin-top value to move the left logo up -->
        <apex:image alt="Logo" value="{!$Resource.BloomgLiving}" width="120px" height="70px"/>
    </div>
    <div style="float:right; margin-top: 0px;"> <!-- Adjust the margin-top value to move the right logo up -->
        <apex:image alt="Logo" value="{!$Resource.Granda}" width="120px" height="70px"/>
    </div>
</div>
    
<div class="divFooter">
        <table class="paymentMethod">
            <tr>
                <td><a><apex:image alt="Logo" value="{!$Resource.BloomLogo}" width="100px" height="30px"/></a>
                </td>
                <td style="width: 100px;"></td>
                <td><p style="font-size: 8px; color: #4d5156;">
                    Bloom District Properties - Sole Proprietorship - L.L.C., P.O. Box 28928, Abu Dhabi, UAE<br/>
                    T +971 2 6969500 call free 800 bloom (25666) F +971 2 6431144 <br/>
                    Email: <span style="color: #8e8ee5;">info@bloom.co.ae - www.bloom.co.ae</span>
                    </p></td> 
            </tr>
        </table>
    </div> 
    <h3 class="heading">BOOKING FORM</h3>
    <table style="width: 60%" class="contractTable">
        <tr>
            
            <td colspan="2" class="noBorder">
                Date:  <apex:outputText value="{0,date,dd-MMM-yyyy}"> <apex:param value="{!NOW()}" /> </apex:outputText>
            </td>
        </tr>
        <tr>
            <td style="width: 100px;" class="greyColor">Order No:</td>
            <td>{!OppList[0].OpportunityNumber__c}</td>
            <td style="width: 100px;" class="greyColor">Project Name:</td>
            <td>{!offerDetails.unitRecord.Project__r.Name}</td>
        </tr>
        
    </table>
    <br/>
    <table id="table" width="100%" class="contractTable">
        <tr>
            <td colspan="7" class="greyColor">
                Property Details: 
            </td>
        </tr>
        <tr>
            <td class="greyColor">Unit Number </td>
            <td class="greyColor">Unit Type</td>
            <td class="greyColor">No. of Bedrooms</td>
            <td class="greyColor">Purchase Price</td>
            <td class="greyColor">Payment Plan</td>
            <td class="greyColor">Discount</td>
            <td class="greyColor">Final Purchase Price</td>
        </tr>
        
        
        
        
        
        <apex:repeat value="{!UnitList}" var="unit">
            <tr>
                <td>{!unit.UnitNumber__c}</td>
                <td>{!unit.UnitType__c}</td>
                <td>{!unit.NumberOfBedrooms__c}</td>
                <td><!--{!unit.currencyISOCOde}--> <apex:outputText value="{0, number,  ###,##0}">
                    <apex:param value="{!unit.SellingPrice__c}" />
                    </apex:outputText>
                    
                </td>
                <td>
                    <!--{!paymentplanNameMap[unit.id]}-->{!paymentplanDescriptionMap[unit.id]}
                </td>
                <td> <!--{!offerDetails.unitRecord.currencyISOCOde}-->  <apex:repeat value="{!offerDetails.applicablePaymentPlansCalculated}" var="paymentPlans">
                    <apex:outputPanel rendered="{!paymentPlans.isSelected}">
                        <apex:outputText value="{0, number,  ###,##0}">
                            <apex:param value="{!( offerDetails.unitRecord.SellingPrice__c - paymentPlans.discountedUnitSalesPrice )}" />
                        </apex:outputText></apex:outputPanel></apex:repeat>
                </td>
                <td>
                    
                    <!--{!offerDetails.unitRecord.currencyISOCOde}-->  <apex:repeat value="{!offerDetails.applicablePaymentPlansCalculated}" var="paymentPlans">
                    <apex:outputPanel rendered="{!paymentPlans.isSelected}">
                        <apex:outputText value="{0, number,  ###,##0}">
                            <apex:param value="{!(unit.SellingPrice__c - (offerDetails.unitRecord.SellingPrice__c - paymentPlans.discountedUnitSalesPrice) )}" />
                        </apex:outputText></apex:outputPanel></apex:repeat>
                    
                </td>
            </tr>
        </apex:repeat>
        
        <tr>
            <td colspan="3" align="right">Total</td>
            <td></td>
            <td></td>
            <td></td>
            <td>
                
                {!offerDetails.unitRecord.currencyISOCOde}
                <apex:outputText value="{0, number,  ###,##0}">
                    <apex:param value="{!Total}" />
                </apex:outputText>
                
            </td>
        </tr>
    </table>
    <br/>
    
    <table width="100%" class="contractTable">
        <tr>
            <td colspan="6" class="greyColor">
                Client Details: 
            </td>
        </tr>
        <tr>
            <td colspan="3">Customer Name: {!customerName} </td>
            <td  colspan="3">Nationality: {!OppList[0].Account.Nationality__c}</td>
        </tr>
        <tr>
            <td colspan="3">Passport No: {!OppList[0].Account.PassportNumber__pc} </td>
            <td  colspan="3">Emirates ID Number: {!OppList[0].Account.Emirates_Id__pc}</td>
        </tr>
        <tr>
            <td colspan="3">Mobile No: {!OppList[0].Account.MobileCountryCode__pc} {!OppList[0].Account.PersonMobilePhone}</td>
            <td  colspan="3">E-mail Address: {!OppList[0].Account.PersonEmail}</td>
        </tr>
        <tr>
            <td colspan="3">Source :{!OppList[0].LeadSource} </td>
            <td  colspan="3" >Payment Mode :</td>
            
        </tr>
        <tr>
            <td colspan="3">Broker Name : {!OppList[0].BrokerAgencyAccount__r.Name} </td>
            <td  colspan="3">Broker Agent(if applicable) : {!OppList[0].BrokerAgentContact__r.Name}</td>
        </tr>
        
    </table>
    <br/>
    
    <table width="100%" class="contractTable">
        <tr>
            <td  class="greyColor">
                <apex:repeat value="{!UnitList}" var="unit"> <b> Payment Plan:</b>{!paymentplanDescriptionMap[unit.id]}</apex:repeat>
            </td>
