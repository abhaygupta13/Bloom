    <masterLabel>Common Area Case Record Page</masterLabel>
    <parentFlexiPage>sfa__Case_rec_L</parentFlexiPage>
    <sobjectType>Case</sobjectType>
    <template>
        <name>flexipage:recordHomeTemplateDesktop</name>
        <properties>
            <name>actionNames</name>
            <valueList>
                <valueListItems>
                    <value>Case.Submit</value>
                </valueListItems>
                <valueListItems>
                    <value>Case.SubmittoBFM</value>
                </valueListItems>
                <valueListItems>
                    <value>Case.AddComment</value>
                </valueListItems>
                <valueListItems>
                    <value>FeedItem.ContentPost</value>
                </valueListItems>
                <valueListItems>
                    <value>Case.ReopenCase</value>
                    <visibilityRule>
                        <booleanFilter>1 OR 2</booleanFilter>
                        <criteria>
                            <leftValue>{!Record.Status}</leftValue>
                            <operator>EQUAL</operator>
                            <rightValue>Cancelled</rightValue>
                        </criteria>
                        <criteria>
                            <leftValue>{!Record.Status}</leftValue>
                            <operator>EQUAL</operator>
                            <rightValue>Closed</rightValue>
                        </criteria>
                    </visibilityRule>
                </valueListItems>
                <valueListItems>
                    <value>Case.Cancel</value>
                    <visibilityRule>
                        <booleanFilter>1 AND 2</booleanFilter>
                        <criteria>
                            <leftValue>{!Record.Status}</leftValue>
                            <operator>NE</operator>
                            <rightValue>Cancelled</rightValue>
                        </criteria>
                        <criteria>
                            <leftValue>{!Record.Status}</leftValue>
                            <operator>NE</operator>
                            <rightValue>Closed</rightValue>
                        </criteria>
                    </visibilityRule>
                </valueListItems>
                <valueListItems>
                    <value>Edit</value>
                </valueListItems>
            </valueList>
        </properties>
        <properties>
            <name>enablePageActionConfig</name>
            <value>true</value>
        </properties>
        <properties>
            <name>saveOptions</name>
            <value>[{&quot;name&quot;:&quot;UseDefaultAssignmentRule&quot;,&quot;value&quot;:&quot;NONE&quot;},{&quot;name&quot;:&quot;triggerOtherEmail&quot;,&quot;value&quot;:&quot;NONE&quot;}]</value>
        </properties>
    </template>
    <type>RecordPage</type>
</FlexiPage>
