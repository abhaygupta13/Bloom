<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Case.Mark_as_complete</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND((3 AND (5 OR 7)) OR(4 AND (6 OR 7)))</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.IsDPCleared__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Yes</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Closed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Step__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>1</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Step__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Final</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.ProfileName__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>CRM Operations</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.ProfileName__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Finance Team</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.Reassign_to_Previous_Team</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Closed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.ProfileName__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>CRM Operations</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Submit</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 4 AND 5 AND 6</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Deferral_Within_1_Month__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>No</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.DeferralApprovalStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Rejected</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.DeferralApprovalStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Approved</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.DeferralApprovalStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Pending</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Step__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>1</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Closed</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.Postpone_Approved</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3 AND 4 AND (5 OR 6)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Step__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Final</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.PostponeApproved__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Yes</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.PostponeApproved__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>No</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Closed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.ProfileName__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Finance Team</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.Cancel</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Cancelled</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.Assign_Request</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.isRunningUserMatchesOwner__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Closed</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>ChangeOwnerOne</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!$User.FirstName}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Ahmed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>CONTAINS</operator>
                                    <rightValue>Finance</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.AddComment</value>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.FollowUp</value>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.CaseCloseAction</value>
                        </valueListItems>
                    </valueList>
                </componentInstanceProperties>
