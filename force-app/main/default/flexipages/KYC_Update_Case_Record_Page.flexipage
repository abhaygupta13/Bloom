                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Case.Reassign_to_Previous_Team</value>
                        </valueListItems>
                        <valueListItems>
