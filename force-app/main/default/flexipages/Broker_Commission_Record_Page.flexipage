    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Edit</value>
                        </valueListItems>
                        <valueListItems>
                            <value>BrokerCommission__c.GenerateCombinedDocument</value>
                        </valueListItems>
                        <valueListItems>
                            <value>BrokerCommission__c.ReSync</value>
                            <visibilityRule>
                                <booleanFilter>1 AND (2 OR 3)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.IntegrationStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Success</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.FirstApprovalStatus__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Approved</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SecondApprovalStatus__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Approved</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>BrokerCommission__c.Share</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Generated</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>BrokerCommission__c.SubmitForApproval</value>
                            <visibilityRule>
                                <booleanFilter>1 AND (2 OR 3 OR 6) AND 4 AND 5 AND 7 AND 8</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.InvoiceVerified__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Draft</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Shared</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.FirstApprovalStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Pending</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.SecondApprovalStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Pending</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Posted</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.FinalApprovalStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Pending</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.FinalApprovalStatus__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Approved</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>BrokerCommission__c.Verify</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!Record.InvoiceVerified__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>BrokerCommission__c.Cancel</value>
                            <visibilityRule>
                                <booleanFilter>1 AND (2 OR 3)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Cancelled</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Broker Management Team</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
