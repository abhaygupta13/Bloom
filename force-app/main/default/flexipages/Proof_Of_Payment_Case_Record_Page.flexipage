                                    <operator>EQUAL</operator>
                                    <rightValue>3</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.isRunningUserMatchesOwner__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.TPFType__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Individual</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.TPFType__c}</leftValue>
