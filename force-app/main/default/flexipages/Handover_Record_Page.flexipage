    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Edit</value>
                        </valueListItems>
                        <valueListItems>
                            <value>Handover__c.Complete_KHO_Process</value>
                            <visibilityRule>
                                <booleanFilter>1 OR 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Sub_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Schedule KHO Appointment</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Sub_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>PHPP Handover Keys</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Handover__c.Generate_Document</value>
                            <visibilityRule>
                                <booleanFilter>1 OR 2 OR 3 OR 4</booleanFilter>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>amdiaz@bloomholding.com</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>msaaidi@bloomholding.com</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>tawadh@bloomholding.com</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Handover__c.Assign_To_Me</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2 AND 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.IsCurrentUserOwner__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.isCurrentUserHOAgent__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Sub_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Under Resale</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Handover__c.Complete_My_Task</value>
                            <visibilityRule>
                                <booleanFilter>1 AND (NOT 7) AND ((2 AND 5) OR 3 OR 4 OR 6)</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.Sub_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Handover Completed</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.IsCurrentUserOwner__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.isCurrentUserHOAgent__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>webintegration@bloomholding.com</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Sub_Status__c}</leftValue>
                                    <operator>NE</operator>
                                    <rightValue>Under Resale</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>rattia@bloomholding.com</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Sub_Status__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Book Appointment with Customer</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Handover__c.Send_for_Signature</value>
                        </valueListItems>
                        <valueListItems>
                            <value>Handover__c.MarkAsPotentialDefaulter</value>
                            <visibilityRule>
                                <booleanFilter>(1 OR 2) AND 3</booleanFilter>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>CRM Operations</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Profile.Name}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>System Administrator</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Payment_Settled__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
