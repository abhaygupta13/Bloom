    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>actionNames</name>
                    <valueList>
                        <valueListItems>
                            <value>Edit</value>
                        </valueListItems>
                        <valueListItems>
                            <value>PaymentPlanSchedule__c.Generate_Tax_Credit_Invoice</value>
                        </valueListItems>
                        <valueListItems>
                            <value>PaymentPlanSchedule__c.Generate_Tax_Invoice</value>
                        </valueListItems>
                        <valueListItems>
                            <value>PaymentPlanSchedule__c.Re_Sync</value>
                            <visibilityRule>
                                <booleanFilter>1 AND 2</booleanFilter>
                                <criteria>
                                    <leftValue>{!Record.PaymentStatus__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Not Invoiced</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.ShowSyncButton__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>true</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>PaymentPlanSchedule__c.Reverse</value>
                            <visibilityRule>
                                <booleanFilter>(1 OR 6) AND 2 AND 3 AND 4 AND 5</booleanFilter>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>mkandy@bloomholding.com</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.IsReversed__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>false</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.PaymentStatus__c}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>Un Paid</rightValue>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Paymentdoc__c}</leftValue>
                                    <operator>EQUAL</operator>
                                </criteria>
                                <criteria>
                                    <leftValue>{!Record.Paymentdocumentnumber__c}</leftValue>
                                    <operator>EQUAL</operator>
                                </criteria>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>mfraij@bloomholding.com</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
                            <value>Delete</value>
                            <visibilityRule>
                                <criteria>
                                    <leftValue>{!$User.Username}</leftValue>
                                    <operator>EQUAL</operator>
                                    <rightValue>mkandy@bloomholding.com</rightValue>
                                </criteria>
                            </visibilityRule>
                        </valueListItems>
                        <valueListItems>
