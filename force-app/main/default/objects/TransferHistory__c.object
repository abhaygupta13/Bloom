        <label>Transfer Charges</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TransferPrice__c</fullName>
        <description>Property Transfer Price</description>
        <externalId>false</externalId>
        <label>Transfer Price</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TransferType__c</fullName>
        <description>The type of Transfer</description>
        <externalId>false</externalId>
        <label>Transfer Type</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>UnitNumber__c</fullName>
        <externalId>false</externalId>
        <label>UnitNumber</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Transfer History</label>
    <nameField>
        <displayFormat>TN - {00000}</displayFormat>
        <label>Transfer Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Transfer History</pluralLabel>
