        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Year_Picklist</valueSetName>
        </valueSet>
    </fields>
    <label>Sales Target</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>DirectTargetAmount__c</columns>
        <columns>IndirectTargetAmount__c</columns>
        <columns>SalesManager__c</columns>
        <columns>StaffName__c</columns>
        <columns>Quarter__c</columns>
        <columns>Year__c</columns>
        <columns>DirectAchievedAmount__c</columns>
        <columns>IndirectAchievedAmount__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>ST{00000}</displayFormat>
        <label>Sales Target Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
