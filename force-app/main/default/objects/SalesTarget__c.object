        <fullName>IndirectPostLaunchAchievedAmount__c</fullName>
        <defaultValue>0</defaultValue>
        <label>Indirect Post-Launch Achieved Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
