    <fields>
        <fullName>AchievedDCLAllocationAmount__c</fullName>
        <formula>IF( DirectAchievedAmount__c  &gt;=  DirectTargetAmount__c ,DirectTargetAmount__c *  AchievedDCLAllocationPercent__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Achieved Co Lead Allocation Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
