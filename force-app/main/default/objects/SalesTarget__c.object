    </fields>
    <fields>
        <fullName>StaffName__c</fullName>
        <externalId>false</externalId>
        <formula>SalesManager__r.FirstName + &apos; &apos;+  SalesManager__r.LastName</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Staff Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TotalAchievedAmount__c</fullName>
        <formula>IndirectAchievedAmount__c +  DirectAchievedAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Achieved Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TotalAllocationCommissionAmount__c</fullName>
        <formula>AchievedTotalAllocationCommissionAmount__c +  DoubledTotalAllocationCommissionAmount__c +  ExceededTotalAllocationCommissionAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Allocation Commission Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TotalCommissionAmount__c</fullName>
        <formula>(DCLNotAchievedCommissionAmount__c +  DCLAchievedCommissionAmount__c +  DCLExceededCommissionAmount__c +  DCLDoubledCommissionAmount__c +  DSGNotAchievedCommissionAmount__c +  DSGAchievedCommissionAmount__c +  DSGExceededCommissionAmount__c +  DSGDoubledCommissionAmount__c +  IndirectPreLaunchCommissionAmount__c +  IndirectLaunchCommissionAmount__c +  IndirectPostLaunchCommissionAmount__c + SpecialDirectAchievedCommissionAmt__c+ SpecialDirectNotAchievedCommiAmt__c+ SpecialDirectExceededCommissionAmt__c+ SpecialDirectDoubledCommissionAmount__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Commission Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TotalTargetAmount__c</fullName>
        <formula>DirectTargetAmount__c +  IndirectTargetAmount__c</formula>
