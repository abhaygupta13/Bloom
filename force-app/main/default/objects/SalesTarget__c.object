    </fields>
    <fields>
        <fullName>IndirectVarianceAmount__c</fullName>
        <formula>IndirectAchievedAmount__c - IndirectTargetAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Indirect Variance Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ProjectTargetNotAchievedCount__c</fullName>
        <label>Project Target Not Achieved Count</label>
        <summaryFilterItems>
            <field>ProjectSalesTarget__c.IsTargetAchieved__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </summaryFilterItems>
        <summaryForeignKey>ProjectSalesTarget__c.SalesTarget__c</summaryForeignKey>
        <summaryOperation>count</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>Quarter__c</fullName>
        <label>Quarter</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Q1</fullName>
                    <default>false</default>
                    <label>Q1</label>
                </value>
                <value>
                    <fullName>Q2</fullName>
                    <default>false</default>
                    <label>Q2</label>
                </value>
                <value>
                    <fullName>Q3</fullName>
