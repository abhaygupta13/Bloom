        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ExceededDCLAllocationPercent__c</fullName>
        <formula>IF( DirectAchievedAmount__c &gt; DirectTargetAmount__c ,  DCLAchievedAmount__c /  DirectAchievedAmount__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exceeded Co Lead Allocation Percent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>ExceededDSGAllocationAmount__c</fullName>
        <formula>IF( AND(DirectTargetAmount__c &gt; 0, DirectAchievedAmount__c &gt;  DirectTargetAmount__c, DirectAchievedAmount__c &lt; DirectTargetAmount__c *2), DirectVarianceAmount__c *  ExceededDSGAllocationPercent__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exceeded Self Gen Allocation Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ExceededDSGAllocationCommissionAmount__c</fullName>
        <formula>ExceededDSGAllocationAmount__c *  DSGExceededCommissionPercentage__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exceeded Self Gen Allocation Commi Amt</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ExceededDSGAllocationPercent__c</fullName>
        <formula>IF( DirectAchievedAmount__c &gt; DirectTargetAmount__c , DSGAchievedAmount__c /  DirectAchievedAmount__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exceeded Self Gen Allocation Percent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>ExceededTotalAllocationCommissionAmount__c</fullName>
        <formula>ExceededDCLAllocationCommissionAmount__c +  ExceededDSGAllocationCommissionAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Exceeded Total Allocation Commi Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ExternalIdentifier__c</fullName>
        <description>Quarter + Year + Sales Manager Email</description>
        <externalId>true</externalId>
        <label>External Identifier</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>GrandTotal__c</fullName>
        <formula>TotalCommissionAmount__c -  DeductionsAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Grand Total</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
