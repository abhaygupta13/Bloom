    </fields>
    <fields>
        <fullName>IndirectPreLaunchAchievedAmount__c</fullName>
        <defaultValue>0</defaultValue>
        <label>Indirect Pre-Launch Achieved Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>IndirectPreLaunchCommissionAmount__c</fullName>
        <formula>IndirectPreLaunchAchievedAmount__c *  IndirectPreLaunchCommissionPercentage__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Indirect Pre-Launch Commission Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
