        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>IndirectLaunchCommissionAmount__c</fullName>
        <formula>IndirectLaunchAchievedAmount__c *  IndirectLaunchCommissionPercentage__c</formula>
