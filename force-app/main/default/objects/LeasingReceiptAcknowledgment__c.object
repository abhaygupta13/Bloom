    <label>Leasing Receipt Acknowledgment</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>LRA-{00000000}</displayFormat>
        <label>Leasing Receipt Acknowledgment  Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Leasing Receipt Acknowledgments</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>ChequenumbeReferenceNumbervalidation</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND(
ISPICKVAL(PaymentType__c , &quot;Cheque&quot;),
ISBLANK(ChequeNumber__c)
),
AND(
ISPICKVAL(PaymentType__c , &quot;Wire Transfer&quot;),
ISBLANK(ReferenceNumber__c)
)
)</errorConditionFormula>
        <errorMessage>Please enter Cheque Number for Cheque payments and Reference Number for Wire Transfer payments.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PreventEditWhenSyncedToSAP</fullName>
        <active>true</active>
        <description>Restricts modifications to SAP-synced receipts to maintain data integrity between Salesforce and SAP. Only reversal is permitted.</description>
        <errorConditionFormula>AND(
    NOT(ISNEW()),
    NOT(ISBLANK(SAPDocumentNumber__c)),
    $Profile.Name &lt;&gt; &apos;System Administrator&apos;,
    $Profile.Name &lt;&gt; &apos;Support Administrator&apos;,
    $Profile.Name &lt;&gt; &apos;System Integration&apos;,
    OR(
        ISCHANGED(Amount__c),
        ISCHANGED(BankName__c),
        ISCHANGED(BankAccount__c),
        ISCHANGED(ChequeNumber__c),
        ISCHANGED(ReferenceNumber__c),
        ISCHANGED(PaymentType__c),
        ISCHANGED(ReceiptDate__c),
        ISCHANGED(ChequeDate__c),
        ISCHANGED(VerifyDate__c),
        ISCHANGED(Remarks__c),
        ISCHANGED(BeingTowards__c),
        ISCHANGED(IsAdvancePayment__c),
        ISCHANGED(DefaultPropertyBank__c),
        ISCHANGED(ReceivingEntity__c),
        ISCHANGED(FundingEntity__c),
        ISCHANGED(LeasingOrder__c),
        ISCHANGED(OnHold__c),
        ISCHANGED(HoldDate__c),
        ISCHANGED(Withdrawal__c),
        ISCHANGED(Replacement__c)
    )
)</errorConditionFormula>
        <errorMessage>This receipt is already synced with SAP. Editing receipt details is not allowed. Please submit for Reversal if changes are required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>ValidateHoldDateEntry</fullName>
        <active>true</active>
        <errorConditionFormula>HoldDate__c != Null &amp;&amp; ChequeDate__c != null &amp;&amp; (HoldDate__c &lt; ChequeDate__c )</errorConditionFormula>
        <errorMessage>Hold date should be greater than Cheque date.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
