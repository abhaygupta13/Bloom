    <fields>
        <fullName>ReceiptReferenceNumber__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    ISBLANK(SAPDocumentNumber__c),
    
    LeasingOrder__r.SAPCompanyCode__c &amp; &apos;/&apos; &amp;
    RIGHT(Name, 8) &amp; &apos;/&apos; &amp;
    TEXT(YEAR(TODAY())) &amp;
    
    IF(OnHold__c, &quot;-OH&quot;,
        IF(Withdrawal__c, &quot;-WD&quot;,
            IF(Replacement__c, &quot;-Replacement&quot;, &quot;&quot;)
        )
    ),
    
    SAPDocumentNumber__c &amp;
    IF(OnHold__c, &quot;-OH&quot;,
        IF(Withdrawal__c, &quot;-WD&quot;,
            IF(Replacement__c, &quot;-Replacement&quot;, &quot;&quot;)
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Receipt Reference Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
