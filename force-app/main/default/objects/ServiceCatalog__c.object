    <fields>
        <fullName>SuperAppName__c</fullName>
        <label>Super App Name</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <label>Type</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Complaint</fullName>
                    <default>false</default>
                    <label>Complaint</label>
                </value>
                <value>
                    <fullName>Service Request</fullName>
                    <default>false</default>
                    <label>Service Request</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>isNextButtonSelectable__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Next Button Selectable</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>isUnitChangeRequired__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Unit Change Required</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Service Catalog</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>isNextButtonSelectable__c</columns>
        <columns>ProcessType__c</columns>
        <columns>Type__c</columns>
        <columns>Category__c</columns>
        <columns>SubCategory__c</columns>
        <columns>AvailableForOwner__c</columns>
        <columns>AvailableForTenant__c</columns>
        <columns>Active__c</columns>
        <columns>IsAvailableForSuperApp__c</columns>
        <columns>SuperAppName__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Active__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Bloom_Broker_Management_BBM_ServiceCatalog</fullName>
        <filterScope>Queue</filterScope>
        <label>Bloom Broker Management (BBM)</label>
        <queue>Bloom_Broker_Management_BBM</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Collection_Team_Queue_ServiceCatalog</fullName>
        <filterScope>Queue</filterScope>
        <label>Collection Team</label>
        <queue>Collection_Team_Queue</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Government_Relation_Queue_ServiceCatalog</fullName>
        <filterScope>Queue</filterScope>
        <label>Government Relation Team</label>
        <queue>Government_Relation_Team</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Handover_Catalogs</fullName>
        <columns>NAME</columns>
        <columns>Active__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ProcessFlowType__c</field>
            <operation>equals</operation>
            <value>Handover</value>
        </filters>
        <label>Handover Catalogs</label>
    </listViews>
    <listViews>
        <fullName>Leasing_Finance_queue_ServiceCatalog</fullName>
        <filterScope>Queue</filterScope>
        <label>Leasing Finance queue</label>
        <queue>Leasing_Finance_queue</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Legal_Team_ServiceCatalog</fullName>
        <filterScope>Queue</filterScope>
        <label>Legal Team</label>
        <queue>Legal_Team</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Operation_Team_ServiceCatalog</fullName>
        <filterScope>Queue</filterScope>
        <label>Operation Team</label>
        <queue>Operation_Team</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Super_App_KYC_SR_Operation_Team_Assignme_ServiceCatalog</fullName>
        <filterScope>Queue</filterScope>
        <label>Super App KYC SR Operation Team</label>
        <queue>Super_App_KYC_SR_Operation_Team</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
