        <label>Service Catelog Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Service Catalogs</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
