    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to manage all the memo&apos;s raised for an opportunity</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>ApprovalProgress__c</fullName>
        <description>For capturing the Approval Progress of the Booking Memo</description>
        <label>Approval Progress</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approved by Line Manager</fullName>
                    <default>false</default>
                    <label>Approved by Line Manager</label>
                </value>
                <value>
                    <fullName>Rejected by Line Manager</fullName>
                    <default>false</default>
                    <label>Rejected by Line Manager</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ApprovalStatus__c</fullName>
        <description>For capturing the Approval Status of the Booking Memo</description>
        <label>Approval Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>Approval_Status</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>ApprovalSubStatus__c</fullName>
        <description>For capturing the Approval Sub Status of the Booking Memo</description>
        <label>Approval Sub Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Approval Pending with Line Manager</fullName>
                    <default>false</default>
                    <label>Approval Pending with Line Manager</label>
                </value>
                <value>
                    <fullName>Approval Pending with Head of Sales</fullName>
                    <default>false</default>
                    <label>Approval Pending with Head of Sales</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>ExistingOffer__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>For capturing the Existing Offer of the Booking Memo</description>
        <label>Existing Offer</label>
        <referenceTo>OffersPromotions__c</referenceTo>
        <relationshipLabel>Booking Memos</relationshipLabel>
        <relationshipName>MemosExistingOffer</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>ExistingPaymentPlan__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>For capturing the Existing Payment Plan of the Booking Memo</description>
        <label>Existing Payment Plan</label>
        <referenceTo>PaymentPlan__c</referenceTo>
        <relationshipLabel>Booking Memos</relationshipLabel>
        <relationshipName>MemosExistingPaymentPlan</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>LastModifiedApproveStatus__c</fullName>
        <description>Capture last modified date of Approve status</description>
        <label>Last Modified Approve Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>MemoHeader__c</fullName>
        <description>For capturing the Memo Header of the Booking Memo</description>
        <label>Memo Header</label>
        <length>131072</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>MemoSubject__c</fullName>
        <description>For capturing the Memo Subject of the Booking Memo</description>
        <externalId>false</externalId>
        <label>Memo Subject</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>MemoType__c</fullName>
        <description>For capturing the Memo Type of the Booking Memo</description>
        <label>Memo Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>New Payment Plan</fullName>
                    <default>false</default>
                    <label>New Payment Plan</label>
                </value>
                <value>
                    <fullName>New Sale</fullName>
                    <default>false</default>
                    <label>New Sale</label>
                </value>
                <value>
                    <fullName>Staff RTO</fullName>
                    <default>false</default>
                    <label>Staff RTO</label>
                </value>
                <value>
                    <fullName>Bulk Sale</fullName>
                    <default>false</default>
                    <label>Bulk Sale</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>OriginalCreationDate__c</fullName>
        <description>Date when the record was original created in the source system, which will be used for migration.</description>
        <inlineHelpText>Date when the record was original created in the source system, which will be used for migration.</inlineHelpText>
        <label>Original Creation Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>OwnerManger__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>For capturing the Owner Manger of the Booking Memo</description>
        <label>Owner Manger</label>
        <referenceTo>User</referenceTo>
        <relationshipName>Booking_MemosOwnerManger</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>RelatedOpportunityCustomerName__c</fullName>
        <externalId>false</externalId>
        <formula>&apos;Maaz&apos;</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Related Opportunity Customer Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RelatedOpportunity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>For capturing the Related Opportunity of the Booking Memo</description>
        <label>Related Opportunity</label>
        <referenceTo>Opportunity</referenceTo>
        <relationshipLabel>Booking Memos</relationshipLabel>
        <relationshipName>Memos</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>SpecialNote__c</fullName>
        <description>For capturing the Special Note of the Booking Memo</description>
        <externalId>false</externalId>
        <inlineHelpText>Special note provided for the Memo.</inlineHelpText>
        <label>Special Note</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>isApproved__c</fullName>
        <formula>if( ISPICKVAL( ApprovalStatus__c , &quot;Approved&quot;), true, false )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>isApproved</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>Booking Memo</label>
    <nameField>
        <displayFormat>M-{000000}</displayFormat>
        <label>Memo Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Booking Memos</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
