    <fields>
        <fullName>Order_Status__c</fullName>
        <externalId>false</externalId>
        <formula>text(SalesOrder__r.Status__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Order Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OutstandingAmountNumber__c</fullName>
        <externalId>false</externalId>
        <formula>OutstandingAmount__c/3.67</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Outstanding Amount in USD</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OutstandingAmount__c</fullName>
        <formula>IF( Amount__c &gt; InvoicedAmount__c , Amount__c - InvoicedAmount__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Amount not Cleared</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>OutstandingAmountinwords__c</fullName>
        <label>Outstanding Amount in words</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>2</visibleLines>
    </fields>
    <fields>
        <fullName>PendingAmount__c</fullName>
        <description>Amount Pending to be received for the charges.</description>
        <formula>IF((ISNULL(AmountReceived__c) || AmountReceived__c =0),  Amount__c , IF(NOT(ISNULL(AmountReceived__c)) &amp;&amp; AmountReceived__c &gt; 0 &amp;&amp; AmountReceived__c &lt; Amount__c, Amount__c - AmountReceived__c, 0) )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Amount Pending to be received for the charges.</inlineHelpText>
        <label>Pending Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Reason__c</fullName>
        <label>Reason</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <controllingField>ReversalCategory__c</controllingField>
