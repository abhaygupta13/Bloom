    <fields>
        <fullName>ReceiptAcknowledgement__c</fullName>
        <externalId>false</externalId>
        <formula>IF(OR(TEXT(SalesOrder__r.Status__c) = &apos;Cancelled&apos;, TEXT(SalesOrder__r.Status__c) = &apos;Cancelled by User&apos;), &quot;Sales Order is Cancelled&quot;, IF( PendingAmount__c &gt;0, HYPERLINK(&quot;/lightning/cmp/c__OpenReceiptAcknowledgement?c__recordId=&quot;+Id, &quot;Enter Receipt&quot;, &quot;_self&quot;), &quot;Receipts Entered&quot;))</formula>
        <label>Add Receipts</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
