        <fullName>VATApplicable__c</fullName>
        <formula>AND(
    ISPICKVAL(TypeOfCharge__c, &quot;Cheque Bounce Fee&quot;),
    Installment_Line__r.SalesOrder__r.Unit__r.Project__r.BounceChequeFeeVATApplicable__c
)</formula>
