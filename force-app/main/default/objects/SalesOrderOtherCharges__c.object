    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to manage all the charges applicable for a Sales Order.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Customer who has to pay for the charges</description>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Sales Orders Other Charges</relationshipLabel>
        <relationshipName>Sales_Orders_Other_ChargesAccount</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>AmountReceived__c</fullName>
        <description>Total amount received for this charges from the customer.</description>
        <inlineHelpText>Total amount received for this charges from the customer.</inlineHelpText>
        <label>Amount Received</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
