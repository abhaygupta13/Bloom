    <nameField>
        <label>Milestone Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Milestones</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>Delayed_MilestoneDateValidation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISCHANGED(Milestone_Status__c),
    ISPICKVAL(Milestone_Status__c,&apos;Delayed - Finance Approval Pending&apos;),
    Milestone_Date__c &lt;= PRIORVALUE(Milestone_Date__c)
)</errorConditionFormula>
        <errorMessage>The milestone date must be later than the current milestone date if the status is delayed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Milestone_Status_Updation_with_profile</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  ISCHANGED( Milestone_Status__c ),
  ISPICKVAL( Milestone_Status__c , &apos;Delayed&apos;),
   $User.Id  &lt;&gt;  $Label.MilestoneDelayedApprover 
)</errorConditionFormula>
        <errorMessage>Only Finance Director can make status as delayed</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
