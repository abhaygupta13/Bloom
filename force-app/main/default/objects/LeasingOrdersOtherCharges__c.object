    <label>Leasing Order Other Charges</label>
    <listViews>
        <fullName>All</fullName>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <displayFormat>LOC-{0000000}</displayFormat>
        <label>Leasing Orders Other Charges Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Leasing Orders Other Charges</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>RefDocno__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>OtherChargeDateInBetwnLeaseStartEndDate</fullName>
        <active>true</active>
        <description>Other charge calculation start date should be in between leasing period.</description>
        <errorConditionFormula>(CalculationFromDate__c  &lt;  LeasingOrder__r.LeasingStartDate__c)  || (CalculationFromDate__c  &gt;   LeasingOrder__r.LeasingEndDate__c )</errorConditionFormula>
        <errorMessage>Start date should be in between lease start date and lease end date.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>RestrictChargesBeyondLeaseEndDate</fullName>
        <active>true</active>
        <description>Restricts users from creating or updating Other Charges where the calculation date or due date is greater than the Lease Termination Date or Lease End Date.</description>
        <errorConditionFormula>AND(
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    $Profile.Name &lt;&gt; &quot;Support Administrator&quot;,
    $Profile.Name &lt;&gt; &quot;System Integration&quot;,
    OR(
        AND(
            NOT(ISBLANK(LeasingOrder__r.TerminationDate__c)),
            OR(
                CalculationFromDate__c &gt; LeasingOrder__r.TerminationDate__c,
                CalculationToDate__c &gt; LeasingOrder__r.TerminationDate__c,
                DueDate__c &gt; LeasingOrder__r.TerminationDate__c
            )
        ),
        AND(
            NOT(ISBLANK(LeasingOrder__r.LeasingEndDate__c)),
            OR(
                CalculationFromDate__c &gt; LeasingOrder__r.LeasingEndDate__c,
                CalculationToDate__c &gt; LeasingOrder__r.LeasingEndDate__c,
                DueDate__c &gt; LeasingOrder__r.LeasingEndDate__c
            )
        )
    )
)</errorConditionFormula>
        <errorMessage>Other Charge calculation date cannot be greater than the Lease End Date or Termination Date.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
