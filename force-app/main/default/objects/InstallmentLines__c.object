        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Inst_Amount_incl_tax__c</fullName>
        <formula>InstallmentAmount__c + (InstallmentPercentage__c * SalesOrder__r.TaxableAmount__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Inst Amount incl tax</label>
        <precision>18</precision>
        <required>false</required>
