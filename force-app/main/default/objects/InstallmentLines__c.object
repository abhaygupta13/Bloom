        <fullName>InstallmentAmountintheWords__c</fullName>
        <description>For capturing the Installment Amount in the Words</description>
        <externalId>false</externalId>
        <label>Installment Amount in the Words</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InstallmentDate__c</fullName>
        <description>Captures the expected installment date</description>
        <inlineHelpText>Captures the expected installment date</inlineHelpText>
        <label>Installment Date</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>InstallmentDateinArabic__c</fullName>
        <description>For capturing the arabic installment date</description>
        <externalId>false</externalId>
        <formula>IF( InstallmentNumber__c = 1,
&quot;تاريخ السريان&quot;,
CASE(
MONTH(InstallmentDate__c ),
1,TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;يناير&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)) ,
2, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;فبراير&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
3, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;مارس&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
4, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;أبريل&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
5, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;مايو&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
6, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;يونيو&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
7, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;يوليو&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
8, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;أغسطس&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
9, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;سبتمبر&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)), 
10, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;أكتوبر&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
11, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;نوفمبر&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
12, TEXT(DAY(InstallmentDate__c)) &amp; &quot; &quot; &amp; &quot;ديسمبر&quot; &amp; &quot; &quot; &amp; TEXT(YEAR(InstallmentDate__c)),
&quot;None&quot;
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Installment Date in Arabic</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InstallmentNumber__c</fullName>
        <description>Captures the installment number</description>
        <externalId>false</externalId>
        <inlineHelpText>Captures the installment number</inlineHelpText>
        <label>Installment #</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InstallmentPercentage__c</fullName>
        <description>Captures the installment percentage</description>
        <inlineHelpText>Captures the installment percentage</inlineHelpText>
        <label>Installment %</label>
        <precision>5</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>InstallmentSPADesc__c</fullName>
        <externalId>false</externalId>
        <formula>CASE(InstallmentNumber__c ,
1, &apos;Effective Date&apos;, TEXT(DAY(InstallmentDate__c))  &amp; &quot;-&quot; &amp; CASE(MONTH(InstallmentDate__c),
1, &quot;Jan&quot;,
2, &quot;Feb&quot;,
3, &quot;Mar&quot;, 
4, &quot;Apr&quot;, 
5, &quot;May&quot;, 
6, &quot;Jun&quot;,
7, &quot;Jul&quot;,
8, &quot;Aug&quot;,
9, &quot;Sep&quot;,
10, &quot;Oct&quot;,
11, &quot;Nov&quot;,
12, &quot;Dec&quot;,
&quot;None&quot;)  &amp; &quot;-&quot; &amp; TEXT(YEAR(InstallmentDate__c)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Installment SPADate</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Installment_Amount_Excluding_ADM__c</fullName>
        <externalId>false</externalId>
        <label>Installment Amount Excluding ADM</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Installment_Amount_Invoiced__c</fullName>
        <externalId>false</externalId>
        <label>Installment Amount Invoiced</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Installment_Date_Text__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(DAY( InstallmentDate__c )) &amp; &quot;-&quot; &amp; CASE(MONTH(InstallmentDate__c),
1, &quot;Jan&quot;,
2, &quot;Feb&quot;,
3, &quot;Mar&quot;, 
4, &quot;Apr&quot;, 
5, &quot;May&quot;, 
6, &quot;Jun&quot;,
7, &quot;Jul&quot;,
8, &quot;Aug&quot;,
9, &quot;Sep&quot;,
10, &quot;Oct&quot;,
11, &quot;Nov&quot;,
12, &quot;Dec&quot;,
&quot;None&quot;)  &amp; &quot;-&quot; &amp;  TEXT(Year(InstallmentDate__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Installment Date Text</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Installment_Due_Flag__c</fullName>
        <externalId>false</externalId>
        <formula>IF (IF(ISNULL(RevisedDate__c ), InstallmentDate__c, RevisedDate__c) &lt; TODAY(), &quot;YES&quot;, &quot;NO&quot;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Installment Due Flag</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Installment_Percent_Excluding_ADM__c</fullName>
        <formula>( Installment_Amount_Excluding_ADM__c  /   SalesOrder__r.Sales_Price_Excluding_ADM__c )</formula>
