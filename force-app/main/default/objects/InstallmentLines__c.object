    <fields>
        <fullName>PendingAmount__c</fullName>
        <description>Amount Pending to be received for the installment line.</description>
        <formula>IF(
    ADM_Fee_Included__c &amp;&amp; InstallmentNumber__c = 1,

    IF(
        ISBLANK(AmountReceived__c) || AmountReceived__c = 0,
        Installment_Amount_Excluding_ADM__c - BLANKVALUE(TotalRebateAmount__c, 0),

        IF(
            AmountReceived__c &gt; 0 &amp;&amp;
            AmountReceived__c &lt; Installment_Amount_Excluding_ADM__c,

            Installment_Amount_Excluding_ADM__c
            - AmountReceived__c
            - BLANKVALUE(TotalRebateAmount__c, 0),

            0
        )
    ),

    IF(
        ISBLANK(AmountReceived__c) || AmountReceived__c = 0,

        InstallmentAmount__c
        - BLANKVALUE(TotalRebateAmount__c, 0),

        IF(
            AmountReceived__c &gt; 0 &amp;&amp;
            AmountReceived__c &lt; InstallmentAmount__c,

            InstallmentAmount__c
            - AmountReceived__c
            - BLANKVALUE(TotalRebateAmount__c, 0),

            0
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Amount Pending to be received for the installment line.</inlineHelpText>
        <label>Pending Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
