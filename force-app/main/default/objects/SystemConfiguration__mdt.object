<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Metadata to store Object level settings</description>
    <fields>
        <fullName>IsRunAfterDelete__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To be checked when a trigger has to be executed after deleting</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <inlineHelpText>To be checked when a trigger has to be executed after deleting</inlineHelpText>
        <label>Is Run After Delete</label>
        <type>Checkbox</type>
    </fields>
