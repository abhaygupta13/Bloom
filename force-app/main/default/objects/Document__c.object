    <fields>
        <fullName>View_File_del__c</fullName>
        <externalId>false</externalId>
        <formula>IF(NOT(ISBLANK( Content_Version_Id__c )), 
   HYPERLINK(
      &quot;/sfc/servlet.shepherd/version/renditionDownload?rendition=ORIGINAL_Png&amp;versionId=&quot;+Content_Version_Id__c ,
      &quot;Preview&quot;
   ),
   &quot;&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>View File</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
