    <validationRules>
        <fullName>Property_Management_Fee</fullName>
        <active>true</active>
        <errorConditionFormula>PropertyManagementFee__c  &lt; 0</errorConditionFormula>
        <errorDisplayField>PropertyManagementFee__c</errorDisplayField>
        <errorMessage>Property Management Fee cannot be negative.</errorMessage>
    </validationRules>
