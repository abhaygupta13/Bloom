    <fields>
        <fullName>Building_Amenities__c</fullName>
        <label>Building Amenities</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Balcony</fullName>
                    <default>false</default>
                    <label>Balcony</label>
                </value>
                <value>
                    <fullName>Built-in Wardrobes</fullName>
                    <default>false</default>
                    <label>Built-in Wardrobes</label>
                </value>
                <value>
