                    <label>Children Play Area</label>
                </value>
                <value>
                    <fullName>Covered Parking</fullName>
                    <default>false</default>
                    <label>Covered Parking</label>
                </value>
                <value>
                    <fullName>Gym</fullName>
                    <default>false</default>
                    <label>Gym</label>
                </value>
                <value>
                    <fullName>Jogging Track</fullName>
                    <default>false</default>
                    <label>Jogging Track</label>
                </value>
                <value>
                    <fullName>Pets Allowed</fullName>
                    <default>false</default>
                    <label>Pets Allowed</label>
                </value>
                <value>
                    <fullName>Restaurant</fullName>
                    <default>false</default>
                    <label>Restaurant</label>
                </value>
                <value>
                    <fullName>Swimming Pool</fullName>
                    <default>false</default>
                    <label>Swimming Pool</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
