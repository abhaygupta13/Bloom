<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cheque_Reference_Number_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(PaymentType__c,&quot;Cheque&quot;),OR(ISCHANGED(ReferenceNumber__c),ISNEW()),LEN(ReferenceNumber__c)  &lt;&gt; 6)</errorConditionFormula>
    <errorMessage>Cheque Reference Number Should Be 6 Digits.</errorMessage>
</ValidationRule>
