<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AR_receipts_cannot_be_deleted</fullName>
    <active>true</active>
    <errorConditionFormula>ISCHANGED(Markfordeletion__c) &amp;&amp;
Markfordeletion__c &amp;&amp;
((ISPICKVAL(Status__c,&apos;Conirmed&apos;) ||
ISPICKVAL(Status__c,&apos;Remitted&apos;)  ||
ISPICKVAL(Status__c,&apos;Reversed&apos;) ||
ISPICKVAL(Status__c,&apos;Cleared&apos;)  )
)</errorConditionFormula>
    <errorMessage>You cannot delete receipts received by finance or with status confirmed, remitted, reversed or cleared.</errorMessage>
</ValidationRule>
