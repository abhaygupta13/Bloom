    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object used manage all the group required for allocating the Units to Sales Managers.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>AllocationGroupCode__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Provide max of 10 digit Allocation group code Ex : AUH,DXB etc.</description>
        <externalId>false</externalId>
        <inlineHelpText>Provide max of 10 digit Allocation group code Ex : AUH,DXB etc.</inlineHelpText>
        <label>Allocation Group Code</label>
        <length>10</length>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <description>Field to additional details for creating this group</description>
        <inlineHelpText>Field to additional details for creating this group</inlineHelpText>
        <label>Description</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>TextArea</type>
    </fields>
    <fields>
        <fullName>EndDate__c</fullName>
        <description>Field to capture the validity of the group</description>
        <inlineHelpText>Capture the end date to have access to the properties in the group for all the users, for groups that are active forever provide a date 100 years from now.</inlineHelpText>
        <label>End Date</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <description>Indicates if the allocation group is active or not.</description>
        <formula>EndDate__c &gt;= Today()  &amp;&amp; StartDate__c &lt;= Today()</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Indicates if the allocation group is active or not.</inlineHelpText>
        <label>Is Active ?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PublicGroupAssociated__c</fullName>
        <caseSensitive>false</caseSensitive>
        <description>Field to map the public group associated with the allocation group</description>
        <externalId>false</externalId>
        <label>Public Group Associated</label>
        <length>18</length>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>StartDate__c</fullName>
        <description>Field to capture the validity of the group</description>
        <inlineHelpText>Provide the start date as past date for existing groups and temporary groups provide the date when it is intended to be used.</inlineHelpText>
        <label>Start Date</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <label>Allocation Group</label>
    <listViews>
        <fullName>Active_Groups</fullName>
        <columns>NAME</columns>
        <columns>AllocationGroupCode__c</columns>
        <columns>StartDate__c</columns>
        <columns>EndDate__c</columns>
        <columns>Description__c</columns>
        <columns>IsActive__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>IsActive__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Active Groups</label>
    </listViews>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>AllocationGroupCode__c</columns>
        <columns>StartDate__c</columns>
        <columns>EndDate__c</columns>
        <columns>Description__c</columns>
        <columns>IsActive__c</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <label>Allocation Group Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Allocation Groups</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>DatesValidation</fullName>
        <active>true</active>
        <description>For validating that the start date is before end date</description>
        <errorConditionFormula>StartDate__c &gt; EndDate__c</errorConditionFormula>
        <errorDisplayField>StartDate__c</errorDisplayField>
        <errorMessage>Please provide start date before the end date of the allocation group.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>ManageUsers</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <linkType>url</linkType>
        <masterLabel>Manage Users</masterLabel>
        <openType>replace</openType>
        <protected>false</protected>
        <url>/lightning/n/Manage_Users?c__agid={!AllocationGroup__c.Id}</url>
    </webLinks>
</CustomObject>
