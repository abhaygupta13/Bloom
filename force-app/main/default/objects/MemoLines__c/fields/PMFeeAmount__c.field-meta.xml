<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PMFeeAmount__c</fullName>
    <description>For capturing the PM Fee Amount of the Memo Lines</description>
    <formula>(Unit__r.BuildingSectionName__r.PropertyManagementFee__c)  *  Unit__r.MarketLeaseRent__c  * PMFeeYears__c</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>PM Fee Amount</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackTrending>false</trackTrending>
    <type>Currency</type>
</CustomField>
