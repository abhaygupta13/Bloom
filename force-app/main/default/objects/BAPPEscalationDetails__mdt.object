<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>This custom metadata type is used to store the escalation Related details for Bloom Broker Management App</description>
    <fields>
        <fullName>Escalation_Tenure_In_Hours__c</fullName>
        <defaultValue>24</defaultValue>
        <description>This field indicates after how many hours the escalation would be initiated</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Escalation Tenure(In Hours)</label>
        <precision>2</precision>
        <required>true</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Escalation_To_Email__c</fullName>
        <description>This email indicates whom to send the escalation related emails</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Escalation To Email</label>
        <required>true</required>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <description>This field will be used to configure the type/scenario of the escalation for which the escalation details are being added</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Type</label>
        <required>false</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Registration</fullName>
                    <default>true</default>
                    <label>Registration</label>
                </value>
                <value>
                    <fullName>RFI</fullName>
                    <default>false</default>
                    <label>RFI</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>BAPP Escalation Details</label>
    <pluralLabel>BAPP Escalation Details</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
