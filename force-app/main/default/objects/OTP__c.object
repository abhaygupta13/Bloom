    <allowInChatterGroups>true</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>This object is created to store the OPT and related information created for various functionalities requiring OTP generation and verification</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Stores the Id of the Account related to which the OTP was generated.</description>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>OTP</relationshipLabel>
        <relationshipName>OTP</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CommunicationType__c</fullName>
        <description>Identifies whether the OTP is to be sent over Phone or Email</description>
        <label>Communication Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Email</fullName>
                    <default>false</default>
                    <label>Email</label>
                </value>
                <value>
                    <fullName>SMS</fullName>
                    <default>false</default>
                    <label>SMS</label>
                </value>
                <value>
                    <fullName>WhatsApp</fullName>
                    <default>false</default>
                    <label>WhatsApp</label>
                </value>
            </valueSetDefinition>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Contact__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Stores the Id of the Contact related to which the OTP is generated</description>
        <label>Contact</label>
        <referenceTo>Contact</referenceTo>
        <relationshipLabel>OTP</relationshipLabel>
        <relationshipName>OTP</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>CustomerKey__c</fullName>
        <description>This field as a parameter is optional for a few process types.</description>
        <externalId>false</externalId>
        <label>Customer Key</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Email__c</fullName>
        <description>Stores the Email id which is required in case the OTP is to be sent over Email</description>
        <externalId>false</externalId>
        <label>Email</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Email</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OTPCodeExpiration__c</fullName>
        <description>This indicates the date and time up to which the OTP code is valid</description>
        <label>OTP Code Expiration</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>OTPCode__c</fullName>
        <description>Stores the OTP generated</description>
        <externalId>false</externalId>
        <label>OTP Code</label>
        <length>10</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ParentId__c</fullName>
        <externalId>false</externalId>
        <label>ParentId</label>
        <length>50</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PhoneNumber__c</fullName>
        <description>Stores the Phone number which is required when the OTP is to be sent on WhatsApp or SMS</description>
        <label>Phone Number</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Phone</type>
    </fields>
    <fields>
        <fullName>ProcessType__c</fullName>
        <description>Identifies the process for which the OTP is being generated.
Example: OTP generation for Email verification during the &apos;registration&apos; process</description>
        <label>Process Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Registration</fullName>
                    <default>false</default>
                    <label>Registration</label>
                </value>
                <value>
                    <fullName>Track My Application</fullName>
                    <default>false</default>
                    <label>Track My Application</label>
                </value>
                <value>
                    <fullName>Forgot Password</fullName>
                    <default>false</default>
                    <label>Forgot Password</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>TransactionId__c</fullName>
        <caseSensitive>true</caseSensitive>
        <description>This is a unique Transaction Id which should be generated on the front-end and sent to Salesforce for further Verification purpose</description>
        <externalId>false</externalId>
        <label>Transaction Id</label>
        <length>20</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Verified__c</fullName>
        <defaultValue>false</defaultValue>
        <description>This field is used to indicate whether a specific OTP is already Verified</description>
        <label>Verified</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <label>OTP</label>
    <nameField>
        <displayFormat>O-{000000}</displayFormat>
        <label>OTP Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>OTP</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
