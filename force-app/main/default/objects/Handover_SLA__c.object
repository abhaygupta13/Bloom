    <fields>
        <fullName>SLAStage__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    Days_Spent__c &gt; Goal_Days__c,
    &quot;Breached&quot;,
    IF(
        Days_Spent__c &lt;= Goal_Days__c,
        &quot;In Compliance&quot;,
        &quot;&quot;  
    )
)</formula>
        <label>SLA Stage</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SLA_Status__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    Days_Spent__c &gt;  Goal_Days__c ,
    &quot;Breached &quot; &amp; IMAGE(&quot;/resource/1729575807000/WrongIconImage&quot; , &quot;No image&quot;, 20, 20),
    IF(
        Days_Spent__c &lt;= Goal_Days__c,
        &quot;In Compliance &quot; &amp; IMAGE(&quot;/resource/1729575807000/RightIconImage&quot;, &quot;No image&quot;, 20, 20),
        &quot;&quot;
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SLA Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
