        <fullName>MembershipType__c</fullName>
        <description>For capturing the Membership Type of the Memo Lines</description>
        <externalId>false</externalId>
        <label>Membership Type</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>OriginalCreationDate__c</fullName>
        <description>Date when the record was original created in the source system, which will be used for migration.</description>
        <inlineHelpText>Date when the record was original created in the source system, which will be used for migration.</inlineHelpText>
        <label>Original Creation Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>PMFeeAmount__c</fullName>
        <description>For capturing the PM Fee Amount of the Memo Lines</description>
        <formula>(Unit__r.BuildingSectionName__r.PropertyManagementFee__c)  *  Unit__r.MarketLeaseRent__c  * PMFeeYears__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>PM Fee Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>PMFeeYears__c</fullName>
        <description>For capturing the PM Fee Years of the Memo Lines</description>
        <externalId>false</externalId>
        <label>PM Fee Years</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PriceAfterDiscount__c</fullName>
        <description>For capturing the Price After Discount of the Memo Lines</description>
        <externalId>false</externalId>
        <formula>Unit__r.SellingPrice__c -  DiscountAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Price After Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>RebateAmount__c</fullName>
        <description>For capturing the Rebate Amount of the Memo Lines</description>
        <formula>Unit__r.SellingPrice__c *  RebatePercentage__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Rebate Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>RebatePercentage__c</fullName>
        <description>For capturing the Rebate Percentage of the Memo Lines</description>
        <label>Rebate Percentage</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>SCWaiverAmount__c</fullName>
        <description>For capturing the SC Waiver Amount of the Memo Lines</description>
        <formula>IF( ISBLANK( Unit__r.MeasuredArea__c )  , Unit__r.AnticipatedServiceCharges__c  *  SCWaiverYears__c *  Unit__r.SaleableArea__c ,  Unit__r.AnticipatedServiceCharges__c  *  SCWaiverYears__c * Unit__r.MeasuredArea__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>SC Waiver Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>SCWaiverYears__c</fullName>
        <description>For capturing the SC Waiver Years of the Memo Lines</description>
        <externalId>false</externalId>
        <label>SC Waiver Years</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>SubsidyAmount__c</fullName>
        <description>For capturing the Subsidy Amount of the Memo Lines</description>
        <formula>(Unit__r.SellingPrice__c * 80 / 100) *  SubsidyPercentage__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Subsidy Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>SubsidyPercentage__c</fullName>
        <description>For capturing the Subsidy Percentage of the Memo Lines</description>
        <label>Subsidy Percentage</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Unit__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
