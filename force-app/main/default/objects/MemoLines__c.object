        <description>For capturing the Voucher Name of the Memo Lines</description>
        <externalId>false</externalId>
        <label>Voucher Name</label>
        <length>255</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Memo Lines</label>
    <nameField>
        <displayFormat>ML-{0000000}</displayFormat>
