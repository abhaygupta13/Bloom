        <fullName>AllocationGroup__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>For capturing the Allocation Group of the Unit</description>
        <label>Allocation Group</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>AllocationGroup__c.IsActive__c</field>
                <operation>equals</operation>
                <value>True</value>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>AllocationGroup__c</referenceTo>
        <relationshipLabel>Units</relationshipLabel>
        <relationshipName>PropertiesPropertyAllocationGroup</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
