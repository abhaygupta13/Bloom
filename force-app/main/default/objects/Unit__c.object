    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>BlockUnitValidationRule</fullName>
        <active>true</active>
        <description>Validation Rule to ensure block information are populated  when unit status changes to Blocked</description>
        <errorConditionFormula>AND( ISPICKVAL( Status__c , &apos;Blocked&apos;), OR(  ISBLANK(   TEXT(BlockedReason__c ) )))</errorConditionFormula>
        <errorMessage>Please edit the Blocked By, Blocked Reason and Blocked Comments fields.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Is_Inactive_Units_Rule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(IsInactive__c = true ,NOT( ISCHANGED(IsInactive__c) ))</errorConditionFormula>
        <errorMessage>Editing is not allowed for this unit because it is no longer available.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PublicExclusiveCheck</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
IsPublic__c = TRUE,
IsExclusive__c = TRUE
)</errorConditionFormula>
        <errorMessage>A unit cannot be public and exclusive at the same time.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Required_fields_for_Booking</fullName>
        <active>true</active>
        <description>When unit status is updated as In-Progress or Booked</description>
        <errorConditionFormula>AND(
ISCHANGED(Status__c),
OR(ISPICKVAL(Status__c, &apos;In-Progress&apos;),ISPICKVAL(Status__c, &apos;Booked&apos;)),
ISBLANK(LockedBy__c)
)</errorConditionFormula>
        <errorMessage>Required fields are missing for updating the status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reserved_Unit</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
ISPICKVAL(Active_Sales_Order__r.Status__c, &apos;Reserved&apos;)
 &amp;&amp; NOT(ISPICKVAL(Status__c, &apos;Reserved&apos;))&amp;&amp; ISCHANGED(Status__c),
TRUE,
FALSE
)</errorConditionFormula>
        <errorMessage>Status cannot be changed when the Unit is Reserved</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sold_Status_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>IF(
ISPICKVAL(Active_Sales_Order__r.Status__c, &apos;Sold&apos;)&amp;&amp; NOT(ISPICKVAL( BlockedReason__c,&apos;SALES CANCELLATION&apos;)) 
 &amp;&amp; NOT(ISPICKVAL(Status__c, &apos;Sold&apos;))&amp;&amp;  ISCHANGED(Status__c) ,
TRUE,
FALSE
)</errorConditionFormula>
        <errorMessage>Status cannot be changed when Unit is Sold</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Unique_Name_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
  CONTAINS(
      VLOOKUP( 
        $ObjectType.Unit__c.Fields.Name , 
        $ObjectType.Unit__c.Fields.Name, Name
      ), 
      Name
    ), 
  OR(
      ISNEW(), ISCHANGED(Name)
    ) 
  )</errorConditionFormula>
        <errorDisplayField>Name</errorDisplayField>
        <errorMessage>Please provide a unique code for all the units.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
