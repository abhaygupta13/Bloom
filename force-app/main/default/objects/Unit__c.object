        <fullName>DoorNumber__c</fullName>
        <externalId>false</externalId>
        <label>Door Number</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Door_Number__c</fullName>
        <externalId>false</externalId>
        <formula>VALUE(
MID(
ADMAddressingNumber__c,
CASE(
LEN(ADMAddressingNumber__c) - LEN(SUBSTITUTE(ADMAddressingNumber__c, &quot;-&quot;, &quot;&quot;)),
1, FIND(&quot;-&quot;, ADMAddressingNumber__c) + 1,
2, FIND(&quot;-&quot;, ADMAddressingNumber__c, FIND(&quot;-&quot;, ADMAddressingNumber__c) + 1) + 1,
3, FIND(&quot;-&quot;, ADMAddressingNumber__c, FIND(&quot;-&quot;, ADMAddressingNumber__c, FIND(&quot;-&quot;, ADMAddressingNumber__c) + 1) + 1) + 1,
4, FIND(&quot;-&quot;, ADMAddressingNumber__c, FIND(&quot;-&quot;, ADMAddressingNumber__c, FIND(&quot;-&quot;, ADMAddressingNumber__c, FIND(&quot;-&quot;, ADMAddressingNumber__c) + 1) + 1) + 1) + 1,
1 /* Fallback default */
),
LEN(ADMAddressingNumber__c)
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Door Number</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
