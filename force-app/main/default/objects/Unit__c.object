    <fields>
        <fullName>AllocationGroupUser__c</fullName>
        <description>For capturing the Allocation Group/User of the Unit</description>
        <externalId>false</externalId>
        <formula>IF( ISBLANK( AllocationGroupName__c ) ,  AssignedToUser__r.FirstName + &apos; &apos; + AssignedToUser__r.LastName, AllocationGroupName__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Allocation Group/User</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
