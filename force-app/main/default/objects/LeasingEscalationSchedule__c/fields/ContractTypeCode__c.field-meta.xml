<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ContractTypeCode__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    NOT(ISBLANK(TEXT(LeasingOrder__r.Unit__r.PropertyUsage__c))),
    IF(
        ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Residential&quot;), &quot;R001&quot;,
        IF(
            ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Commercial&quot;), &quot;R002&quot;,
            IF(
                ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Retail&quot;), &quot;R003&quot;,
                &quot;&quot;
            )
        )
    ),
    &quot;&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>ContractTypeCode</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
