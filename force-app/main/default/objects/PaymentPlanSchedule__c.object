        <type>Date</type>
    </fields>
    <fields>
        <fullName>LeasingContractTypeCode__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
Name = &quot;Discounted Installment&quot;,
LeasingOrder__r.Project__r.Leasing_Company__r.LeasingSAPRentfreeConditionType__c,

CASE(
LeasingOrder__r.Unit__r.PropertyUsage__c,
&quot;Commercial&quot;, &quot;R024&quot;,
&quot;Residential&quot;, LeasingOrder__r.Project__r.Leasing_Company__r.LeasingSAPResContractTypeCode__c,
&quot;Retail&quot;, &quot;R024&quot;,
&quot;&quot;
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Leasing Contract Type Code</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
