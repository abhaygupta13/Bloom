        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>Overdue_days__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    ISPICKVAL(PaymentStatus__c, &quot;Paid&quot;),
    &quot;Paid&quot;,
    IF(
        (TODAY() - DueDate__c) &gt; 0,
        TEXT(TODAY() - DueDate__c) &amp; &quot; Days Overdue&quot;,
        IF(
            (TODAY() - DueDate__c) &lt; 0,
            TEXT(ABS(TODAY() - DueDate__c)) &amp; &quot; Days Pending&quot;,
            &quot;Due Today&quot;
        )
    )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Overdue days</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>PaymentStartDate__c</fullName>
        <label>Payment Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>PaymentStatusFormula__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  ISPICKVAL(PaymentStatus__c, &quot;Paid&quot;),
  IMAGE(&quot;/resource/1693905638000/GreenCircle&quot;, &quot;Green&quot;, 15, 15) &amp; &quot; Paid&quot;,
  
  IF(
    ISPICKVAL(PaymentStatus__c, &quot;Un Paid&quot;),
    IMAGE(&quot;/resource/1693905638000/RedCircle&quot;, &quot;Red&quot;, 15, 15) &amp; &quot; Unpaid&quot;,
    
    IF(
      ISPICKVAL(PaymentStatus__c, &quot;Not Invoiced&quot;),
      IMAGE(&quot;/resource/1693905638000/OrangeCircle&quot;, &quot;Orange&quot;, 15, 15) &amp; &quot; Not Invoiced&quot;,
   IF(
      ISPICKVAL(PaymentStatus__c, &quot;Reversed&quot;),
      IMAGE(&quot;/resource/1693905638000/OrangeCircle&quot;, &quot;Orange&quot;, 15, 15) &amp; &quot; Reversed&quot;,
        &quot;&quot;
    )
  )
)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Payment Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
