    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>To capture the customer to whom the Sales Order is for.</description>
        <inlineHelpText>To capture the customer to whom the Sales Order is for.</inlineHelpText>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Sales Orders</relationshipLabel>
        <relationshipName>Opportunity_Units</relationshipName>
        <required>true</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Active_Transfer_Case__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <label>Active Transfer Case</label>
        <referenceTo>Case</referenceTo>
        <relationshipLabel>Sales Orders</relationshipLabel>
        <relationshipName>Sales_Orders</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Additional_Terms_Conds__c</fullName>
        <externalId>false</externalId>
        <formula>Unit__r.Project__r.Additional_Terms_Conds__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Additional Terms Conds</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Address__c</fullName>
        <externalId>false</externalId>
        <formula>Account__r.PersonMailingStreet + &apos; &apos; + Account__r.PersonMailingCity + &apos; &apos; + Account__r.PersonMailingState + &apos; &apos; + Account__r.PersonMailingCountry</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Address</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>All_Offers__c</fullName>
        <externalId>false</externalId>
        <formula>if(Discount_Percent__c &gt; 0, &apos;Discount&apos; &amp; text(Discount_Percent__c) &amp; &apos;%&apos;, &apos;&apos;) &amp; if( ADM_Fee_Waived_Percentage__c &gt; 0, &apos; Adm Fee Waived&apos; &amp; text(ROUND(ADM_Fee_Waived_Percentage__c * 100,2)) &amp; &apos;%&apos;, &apos;&apos;) &amp; if( HomeMaintenanceWaivedYears__c &gt; 0, &apos; HomeMaintenanceWaiverYears&apos; &amp; text(HomeMaintenanceWaivedYears__c), &apos;&apos;) &amp; if(Rebate_Percentage__c &gt; 0, &apos; Rebate&apos; &amp; text(Rebate_Percentage__c * 100) &amp; &apos;%&apos;, &apos;&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>All Offers</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AmountPayable__c</fullName>
        <description>For capturing the total amount payable</description>
        <label>Amount Payable</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Amount_Payable_Excluding_ADM__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
				ADM_Fee_Included__c, ((SellingPrice__c - ADM_Fee_Combined__c) - Discount__c)  , AmountPayable__c
		)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
