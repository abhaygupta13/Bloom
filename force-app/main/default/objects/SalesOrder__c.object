    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Status__c</columns>
        <columns>SubStatus__c</columns>
        <columns>BookingDate__c</columns>
        <columns>SalesManager__c</columns>
        <columns>CustomerSignedSPADate__c</columns>
        <columns>Offer__c</columns>
        <columns>Broker_Agencyy__c</columns>
        <columns>PaymentPlan__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>Payment_Plan_Type__c</columns>
        <columns>ADMFeeWaivedAmount__c</columns>
        <columns>ADMFeeAmount__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>notEqual</operation>
            <value>Book Cancelled,Cancelled</value>
        </filters>
        <filters>
            <field>ProjectName__c</field>
            <operation>contains</operation>
            <value>Marbella</value>
        </filters>
        <label>All Sales Orders</label>
        <sharedTo>
            <group>Assistant_Director_Sales</group>
            <group>CC_Agent_Public_Group</group>
            <group>Crm_Operations_Users</group>
            <group>Operations_Team</group>
            <group>System_Administrator</group>
            <role>Senior_Manager_Tax</role>
        </sharedTo>
    </listViews>
