    <fields>
        <fullName>Broker_Agent__c</fullName>
        <externalId>false</externalId>
        <formula>TRIM(
BLANKVALUE(Opportunity__r.BrokerAgentContact__r.FirstName, &quot;&quot;) &amp;

IF(
AND(
NOT(ISBLANK(Opportunity__r.BrokerAgentContact__r.FirstName)),
NOT(ISBLANK(Opportunity__r.BrokerAgentContact__r.MiddleName))
),
&quot; &quot;,
&quot;&quot;
) &amp;

BLANKVALUE(Opportunity__r.BrokerAgentContact__r.MiddleName, &quot;&quot;) &amp;

IF(
AND(
OR(
NOT(ISBLANK(Opportunity__r.BrokerAgentContact__r.FirstName)),
NOT(ISBLANK(Opportunity__r.BrokerAgentContact__r.MiddleName))
),
NOT(ISBLANK(Opportunity__r.BrokerAgentContact__r.LastName))
),
&quot; &quot;,
&quot;&quot;
) &amp;

BLANKVALUE(Opportunity__r.BrokerAgentContact__r.LastName, &quot;&quot;)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Broker Agent</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
