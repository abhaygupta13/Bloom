        <fullName>ADM_Fee_Cleared_Amount__c</fullName>
        <label>ADM Fee Cleared</label>
        <summarizedField>SalesOrderOtherCharges__c.InvoicedAmount__c</summarizedField>
        <summaryFilterItems>
            <field>SalesOrderOtherCharges__c.TypeOfCharge__c</field>
            <operation>equals</operation>
            <value>ADM Fee, ADM Admin Fee</value>
        </summaryFilterItems>
        <summaryForeignKey>SalesOrderOtherCharges__c.SalesOrder__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>ADM_Fee_Combined__c</fullName>
        <externalId>false</externalId>
        <label>ADM Fee Combined</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ADM_Fee_Included__c</fullName>
        <formula>Offer__r.ADM_Fee_Included__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ADM Fee Included</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>ADM_Fee_Received_Amount__c</fullName>
        <label>ADM Fee Received</label>
        <summarizedField>SalesOrderOtherCharges__c.AmountReceived__c</summarizedField>
        <summaryForeignKey>SalesOrderOtherCharges__c.SalesOrder__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>ADM_Fee_Received__c</fullName>
        <externalId>false</externalId>
        <formula>IF(  ADM_Fee_Received_Amount__c  &gt;=  ADMFeeAmount__c ,IMAGE(&quot;/resource/1693905638000/GreenCheckMark&quot;, &quot;Green&quot;, 30, 30),IMAGE(&quot;/resource/1693905660000/RedCrossMark&quot;, &quot;red&quot;, 30, 30))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ADM Fee Received</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>ADM_Fee_Waived_Percentage__c</fullName>
        <formula>IF( ADMFeeWaivedAmount__c &gt; 0, (ADMFeeWaivedAmount__c - 420)/  AmountPayable__c, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ADM Fee Waived Percentage</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>ADM_Waiver__c</fullName>
        <defaultValue>false</defaultValue>
        <label>ADM Waiver</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>AbuDhabiMunicipalityFees__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Discount_Percent__c=0 , (Sales_Price_Excluding_ADM__c*2/100) , Sales_Price_Excluding_ADM__c * (Discount_Percent__c/100))</formula>
        <label>Abu Dhabi Municipality Fees</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AccountNameArabic__c</fullName>
        <externalId>false</externalId>
        <formula>Account__r.Title_Arabic__c + &apos;&apos; +  Account__r.NameinArabic__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name Arabic</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>AccountName__c</fullName>
        <description>For capturing the Account Name for SPA</description>
        <externalId>false</externalId>
        <formula>IF( Account__r.RecordType.DeveloperName = &apos;PersonAccount&apos;, TEXT(Account__r.Salutation) + &apos; &apos; + Account__r.FirstName + &apos; &apos; +  Account__r.MiddleName + &apos; &apos; +  Account__r.LastName,  Account__r.Name )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Name</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Contact_ID__c</fullName>
        <externalId>false</externalId>
        <formula>Account__r.PersonContactId</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Contact ID</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Account_Nationality__c</fullName>
        <externalId>false</externalId>
        <formula>TEXT(Account__r.Nationality__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Account Nationality</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
