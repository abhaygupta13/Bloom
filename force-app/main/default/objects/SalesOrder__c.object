        <fullName>Booking_Date_Arabic__c</fullName>
        <externalId>false</externalId>
        <formula>&quot;من شهر&quot; &amp; CASE(MONTH(BookingDate__c),
1, &quot;يناير&quot;,
2, &quot;فبراير&quot;,
3, &quot;مارس&quot;,
4, &quot;أبريل&quot;,
5, &quot;مايو&quot;,
6, &quot;يونيو&quot;,
7, &quot;يوليو&quot;,
8, &quot;أغسطس&quot;,
9, &quot;سبتمبر&quot;,
10, &quot;أكتوبر&quot;,
11, &quot;نوفمبر&quot;,
12, &quot;ديسمبر&quot;,
&quot;None&quot;
) &amp; &quot; &quot; &amp; TEXT(YEAR(BookingDate__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Booking Date Arabic</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
