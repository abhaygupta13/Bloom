    <sharingModel>Private</sharingModel>
    <startsWith>Vowel</startsWith>
    <validationRules>
        <fullName>Approved_SPA_Validation_Sub_Status</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL( SubStatus__c , &apos;Approved SPA Validation&apos;) &amp;&amp; (( ADMFeeAmount__c  &gt;=   ADM_Fee_Cleared_Amount__c + 10 ) || (!ADM_Fee_Included__c &amp;&amp; First_Installment_Amount__c  &gt;=   First_Installment_Cleared_Amount__c + 100 ))</errorConditionFormula>
        <errorMessage>ADM Fee And First Installment Should Be Cleared</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cheques_are_not_received_error</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(SubStatus__c, &apos;SPA Signed&apos;),
    OR(
        ADM_Fee_Received_Amount__c &lt; ADMFeeAmount__c,
         Sales_Order_Installment_Total__c &gt; Sales_Order_Received_Amount__c 

    )
)</errorConditionFormula>
        <errorMessage>Cheques are not yet received</errorMessage>
    </validationRules>
