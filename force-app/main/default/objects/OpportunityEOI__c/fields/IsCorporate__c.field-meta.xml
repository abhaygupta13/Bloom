<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsCorporate__c</fullName>
    <description>Formula field to check if account is corporate or not</description>
    <formula>IF( Opportunity__r.Account.RecordType.DeveloperName  == &apos;OrganizationAccount&apos;, true, false)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Is Corporate</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
