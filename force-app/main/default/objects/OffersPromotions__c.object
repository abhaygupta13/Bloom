    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object to manage all the Offers &amp; Promotions associated with a Project and/or that can be used for a booking.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>ADM_Fee_Included__c</fullName>
        <defaultValue>false</defaultValue>
        <label>ADM Fee Included</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>BookingMemo__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Booking Memo that led to this offer been autocreated.</description>
        <inlineHelpText>Booking Memo that led to this offer been autocreated.</inlineHelpText>
        <label>Booking Memo</label>
        <referenceTo>BookingMemo__c</referenceTo>
        <relationshipLabel>Offers &amp; Promotions</relationshipLabel>
        <relationshipName>Offers_Promotions</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>BrokerPortalFlag__c</fullName>
        <defaultValue>false</defaultValue>
        <description>To be checked if the offer is applicable on the broker portal.</description>
        <inlineHelpText>To be checked if the offer is applicable on the broker portal.</inlineHelpText>
        <label>Broker Portal Flag</label>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>BuildingSectionName__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Choosen when offer has to be applied only for a Building under the specified project.</description>
        <inlineHelpText>Choose when offer has to be applied only for a Building under the specified project.</inlineHelpText>
        <label>Building/Section Name</label>
        <lookupFilter>
            <active>true</active>
            <filterItems>
                <field>$Source.Project__c</field>
                <operation>equals</operation>
                <valueField>BuildingSection__c.Project__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>BuildingSection__c</referenceTo>
        <relationshipLabel>Offers &amp; Promotions</relationshipLabel>
        <relationshipName>OffersPromotionsBuildingSectionName</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Customer_Sub_Type__c</fullName>
        <label>Customer Sub Type</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>CustomerSubType</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>Direct_Indirect__c</fullName>
        <label>Direct/Indirect</label>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Direct</fullName>
                    <default>false</default>
                    <label>Direct</label>
                </value>
                <value>
                    <fullName>Indirect</fullName>
                    <default>false</default>
                    <label>Indirect</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>EndDate__c</fullName>
        <description>Duration till when the offer has to be active.</description>
        <inlineHelpText>Duration till when the offer has to be active.</inlineHelpText>
        <label>End Date</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <formula>IF(EndDate__c &gt;= Today() &amp;&amp; StartDate__c &lt;=Today(), true,FALSE)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>IsActive ?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>OfferDescription__c</fullName>
        <description>Provide detailed description of the offer &amp; promotion</description>
        <inlineHelpText>Provide detailed description of the offer &amp; promotion</inlineHelpText>
        <label>Offer Description</label>
        <length>1000</length>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
    <fields>
        <fullName>OfferName__c</fullName>
        <externalId>false</externalId>
        <label>Offer Name</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Project__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Project for which the promotion is applied. All the offers have to be associated with a project.</description>
        <inlineHelpText>Project for which the promotion is applied. All the offers have to be associated with a project.</inlineHelpText>
        <label>Project</label>
        <referenceTo>Project__c</referenceTo>
        <relationshipLabel>Offers &amp; Promotions</relationshipLabel>
        <relationshipName>OffersPromotionsProject</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>StartDate__c</fullName>
        <description>Duration from when the offer has to be active.</description>
        <inlineHelpText>Duration from when the offer has to be active.</inlineHelpText>
        <label>Start Date</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Unit__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Unit for which the offer is applied along with Booking Memo. Unit is considered only for Memo offers.</description>
        <inlineHelpText>Unit for which the offer is applied along with Booking Memo.</inlineHelpText>
        <label>Unit</label>
        <referenceTo>Unit__c</referenceTo>
        <relationshipLabel>Offers &amp; Promotions</relationshipLabel>
        <relationshipName>OffersPromotions</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Offer &amp; Promotion</label>
    <listViews>
        <fullName>Alhambra_Offers</fullName>
        <columns>NAME</columns>
        <columns>Project__c</columns>
        <columns>BuildingSectionName__c</columns>
        <columns>OfferName__c</columns>
        <columns>ADM_Fee_Included__c</columns>
