        <columns>EndDate__c</columns>
        <columns>IsActive__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Project__c</field>
            <operation>equals</operation>
            <value>Alhambra</value>
        </filters>
        <label>Alhambra Offers</label>
    </listViews>
