    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Internal_Commission_Company_Layout</fullName>
        <fields>Name</fields>
        <fields>Project__c</fields>
        <fields>InventoryLaunchCategory__c</fields>
        <fields>IsActive__c</fields>
