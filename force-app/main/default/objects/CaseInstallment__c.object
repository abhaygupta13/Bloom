    <validationRules>
        <fullName>New_Installment_Date_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>NewInstallmentDate__c &lt;= InstallmentDate__c</errorConditionFormula>
        <errorMessage>New Installment Date must be a future date.</errorMessage>
    </validationRules>
