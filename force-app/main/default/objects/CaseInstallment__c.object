        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>InstallmentAmount__c</fullName>
        <formula>Installment__r.InstallmentAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
