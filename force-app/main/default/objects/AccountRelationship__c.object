    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Primary account of the relationship</description>
        <inlineHelpText>Primary account of the relationship</inlineHelpText>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Relationships</relationshipLabel>
        <relationshipName>AccountRelationships</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>OriginalCreationDate__c</fullName>
        <description>Date when the record was original created in the source system, which will be used for migration.</description>
        <inlineHelpText>Date when the record was original created in the source system, which will be used for migration.</inlineHelpText>
        <label>Original Creation Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>RelatedAccount__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Related account of the primary account</description>
        <inlineHelpText>Related account of the primary account</inlineHelpText>
        <label>Related Account</label>
        <lookupFilter>
            <active>true</active>
            <errorMessage>Please choose different account.</errorMessage>
            <filterItems>
                <field>Account.Id</field>
                <operation>notEqual</operation>
                <valueField>$Source.Account__c</valueField>
            </filterItems>
            <isOptional>false</isOptional>
        </lookupFilter>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Relationships With</relationshipLabel>
        <relationshipName>AccountRelationships1</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>RelationshipType__c</fullName>
        <description>Relationship that the primary and related account have.</description>
        <inlineHelpText>Relationship that the primary and related account have.</inlineHelpText>
        <label>Relationship Type</label>
        <required>true</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Spouse Of</fullName>
                    <default>false</default>
                    <label>Spouse Of</label>
                </value>
                <value>
                    <fullName>Child Of</fullName>
                    <default>false</default>
                    <label>Child Of</label>
                </value>
                <value>
