    <fields>
        <fullName>CommissionAmountFormula__c</fullName>
        <formula>IF(CommissionAmount__c &gt; 0 ,
    CommissionAmount__c,
     IF( SalesOrder__r.ADM_Fee_Included__c ,
          (SalesOrder__r.NetAmount__c - SalesOrder__r.ADMFeeAmount__c ) * CommissionPercentage__c / 2 ,
           SalesOrder__r.NetAmount__c * CommissionPercentage__c / 2
        )
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Commission Amount Formula</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
