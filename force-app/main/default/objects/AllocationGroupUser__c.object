    <fields>
        <fullName>AllocationGroup__c</fullName>
        <description>Field to capture Allocation Group Reference</description>
        <inlineHelpText>Group to which the user is added to.</inlineHelpText>
        <label>Allocation Group</label>
        <referenceTo>AllocationGroup__c</referenceTo>
        <relationshipLabel>Allocation Group Users</relationshipLabel>
        <relationshipName>AllocationGroupUsersAllocationGroup1</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>EndDate__c</fullName>
        <description>Field to capture the duration for the user to be part of the group</description>
        <inlineHelpText>Capture the duration of the user to be part of the group</inlineHelpText>
        <label>End Date</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <description>Indicates if the user will have access to the units allocated to the group or not.</description>
        <formula>EndDate__c &gt;= Today()  &amp;&amp; StartDate__c &lt;= Today()</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Indicates if the user will have access to the units allocated to the group or not.</inlineHelpText>
        <label>Is Active ?</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>PublicGroupAssociated__c</fullName>
        <description>Public Group Id that the allocation group is associated with.</description>
        <externalId>false</externalId>
        <formula>AllocationGroup__r.PublicGroupAssociated__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Public Group Associated</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>StartDate__c</fullName>
        <description>Field to capture the duration for the user to be part of the group</description>
        <inlineHelpText>Capture the duration of the user to be part of the group</inlineHelpText>
        <label>Start Date</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>UserEmail__c</fullName>
        <externalId>false</externalId>
        <formula>User__r.Email</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
