    <deploymentStatus>Deployed</deploymentStatus>
    <description>Object used to allocate the receipt with installments and sales order other charges like ADM, SC etc.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>ControlledByParent</externalSharingModel>
    <fields>
        <fullName>Account__c</fullName>
        <deleteConstraint>Restrict</deleteConstraint>
        <description>Customer who made the payment</description>
        <label>Account</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Receipt Allocations</relationshipLabel>
        <relationshipName>Receipt_AllocationsAccount</relationshipName>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>AmountApplied__c</fullName>
        <label>Amount Applied</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Applied_To__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
  NOT(ISBLANK(SalesOrderOtherCharges__c)),
  IF(
    CONTAINS(TEXT(TypeOfInvoice__c), &quot;_&quot;),
    LEFT(TEXT(TypeOfInvoice__c), FIND(&quot;_&quot;, TEXT(TypeOfInvoice__c)) - 1),
    TEXT(TypeOfInvoice__c)
  ),
  TEXT(TypeOfInvoice__c) + &quot; &quot; + InstallmentNumberOrChargeType__c
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Applied To</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Booking_Date__c</fullName>
