    <nameField>
        <displayFormat>RA-{000000}</displayFormat>
        <label>Receipt Acknowledgement #</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Receipt Acknowledgements</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
        <excludedStandardButtons>MassAssignRecordLabel</excludedStandardButtons>
        <massQuickActions>RejectReversalRequests</massQuickActions>
        <massQuickActions>ApproveReversalRequests</massQuickActions>
        <searchResultsAdditionalFields>SalesOrder__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Account__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Amount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>MaturityDate__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ReferenceNumber__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ChequeReceivedBy__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>ReceiptDate__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>RecievedFromAccount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>SAP_Document_No__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <validationRules>
        <fullName>AR_receipts_cannot_be_deleted</fullName>
        <active>true</active>
        <errorConditionFormula>ISCHANGED(Markfordeletion__c) &amp;&amp;
Markfordeletion__c &amp;&amp;
((ISPICKVAL(Status__c,&apos;Conirmed&apos;) ||
ISPICKVAL(Status__c,&apos;Remitted&apos;)  ||
ISPICKVAL(Status__c,&apos;Reversed&apos;) ||
ISPICKVAL(Status__c,&apos;Cleared&apos;)  )
)</errorConditionFormula>
        <errorMessage>You cannot delete receipts received by finance or with status confirmed, remitted, reversed or cleared.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cheque_Duplication_Number</fullName>
        <active>true</active>
        <errorConditionFormula>OR(
AND(
SalesOrder__r.Sales_Order_Number__c = &quot;SO04619&quot;,
ReferenceNumber__c = &quot;000007&quot;
),
AND(
SalesOrder__r.Sales_Order_Number__c = &quot;SO07177&quot;,
ReferenceNumber__c = &quot;935946&quot;
)
)</errorConditionFormula>
        <errorMessage>This is a lost Cheque</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cheque_Reference_Number_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(ISPICKVAL(PaymentType__c,&quot;Cheque&quot;),OR(ISCHANGED(ReferenceNumber__c),ISNEW()),LEN(ReferenceNumber__c)  &lt;&gt; 6)</errorConditionFormula>
        <errorMessage>Cheque Reference Number Should Be 6 Digits.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Delete_Reverse_Validation_Rule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(Finance_Verified__c = true,ISCHANGED( Markfordeletion__c ))</errorConditionFormula>
        <errorMessage>You cannot Delete/Reverse finance verified receipts.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>MarkforDeletion_cannot_be_updated</fullName>
        <active>true</active>
        <errorConditionFormula>if(ISCHANGED(Markfordeletion__c), 

PRIORVALUE(Markfordeletion__c) ,


(Markfordeletion__c &amp;&amp;
NOT(ISNEW()) 

)

)

&amp;&amp;
NOT(
($Profile.Name = &apos;Integration Profile&apos; ||
$Profile.Name = &apos;System Administrator&apos; ||
$Profile.Name = &apos;PaymentUrl Profile&apos; ||
$Profile.Name = &apos;Finance Team&apos; || 
$Profile.Name = &apos;Finance &amp; Collection Team&apos;
)
)</errorConditionFormula>
        <errorMessage>You cannot update receipts marked for deletion.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Posting_Date_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT($Profile.Name = &quot;System Administrator&quot;),
    ISCHANGED(ReceiptPostingDate__c),
    ReceiptPostingDate__c &lt; TODAY(),
    OR(
        MONTH(ReceiptPostingDate__c) &lt;&gt; MONTH(TODAY()),
        YEAR(ReceiptPostingDate__c) &lt;&gt; YEAR(TODAY())
    )
)</errorConditionFormula>
        <errorMessage>Posting Date must be within the current month or future date</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Received_To_Entered_Status_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(PRIORVALUE(Status__c),&apos;Received&apos;) &amp;&amp; ISPICKVAL( Status__c ,&apos;Entered&apos;)</errorConditionFormula>
        <errorMessage>Status Cannot be Changed from Received to Entered</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Received_cheque_cannot_be_updated</fullName>
        <active>true</active>
        <errorConditionFormula>ChequeReceived__c &amp;&amp; 
NOT(ISNEW()) &amp;&amp;
(ISCHANGED(Amount__c) ||
ISCHANGED(BankName__c) ||
ISCHANGED(BeneficiaryName__c) ||
ISCHANGED(ChequeReceived__c) ||
ISCHANGED(ChequeReceivedBy__c) ||
ISCHANGED(ChequeReceivedDate__c) ||
ISCHANGED(Customer_Transfer_Reference__c) ||
ISCHANGED(MaturityDate__c) ||
ISCHANGED(PaidBy__c) ||
ISCHANGED(PaymentType__c) ||
ISCHANGED(ReceiptNumber__c) ||
ISCHANGED(ReceiptDate__c) ||
ISCHANGED(ReferenceNumber__c) ||
ISCHANGED(Remarks__c) ||
ISCHANGED(VerifyBy__c) ||
ISCHANGED(VerifyDate__c) ||
ISCHANGED(RecievedFromAccount__c)

)
&amp;&amp;
( $Profile.Name = &apos;Sales Manager&apos; ||
$Profile.Name = &apos;Sales Admin&apos; ||
$Profile.Name = &apos;Customer Management&apos; ||
$Profile.Name = &apos;CM Agent&apos; )</errorConditionFormula>
        <errorMessage>Receipt cannot be update once received by finance team.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Scanned_status_validation</fullName>
        <active>true</active>
        <errorConditionFormula>ISPICKVAL(Status__c , &apos;Scanned&apos;) &amp;&amp;
 ISCHANGED(Status__c ) &amp;&amp; 

NOT(
($Profile.Name = &apos;System Administrator&apos; ||
$Profile.Name = &apos;Cheque Scanner&apos; ||
 $Profile.Name = &apos;Integration Profile&apos; 
)
)</errorConditionFormula>
        <errorMessage>You cannot update status of receipt to scanned.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Status_Reason_Mandatory</fullName>
        <active>true</active>
        <description>Status reason to be provided when status is &apos;On Hold&apos; or &apos;Reversal&apos;</description>
        <errorConditionFormula>AND(
ISBLANK( TEXT(StatusReason__c )),
 ISPICKVAL( Status__c , &apos;On Hold&apos;)
 
)</errorConditionFormula>
        <errorDisplayField>StatusReason__c</errorDisplayField>
        <errorMessage>Please provide reason for the receipt to be &apos;On Hold&apos;</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
