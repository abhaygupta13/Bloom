    <listViews>
        <fullName>All</fullName>
        <columns>SalesOrder__c</columns>
        <columns>NAME</columns>
        <columns>Account__c</columns>
        <columns>Amount__c</columns>
        <columns>MaturityDate__c</columns>
        <columns>ReferenceNumber__c</columns>
        <columns>Finance_Verified__c</columns>
        <columns>ChequeReceivedBy__c</columns>
        <columns>BankName__c</columns>
        <columns>Status__c</columns>
        <columns>RecievedFromAccount__c</columns>
        <columns>LAST_UPDATE</columns>
        <columns>UPDATEDBY_USER</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>greaterThan</operation>
            <value>7/7/2022 12:00 AM</value>
        </filters>
        <filters>
            <field>SalesOrder__c</field>
            <operation>equals</operation>
            <value>TOL-T-V-164-240826</value>
        </filters>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Cleared_and_not_Applied_Receipts</fullName>
