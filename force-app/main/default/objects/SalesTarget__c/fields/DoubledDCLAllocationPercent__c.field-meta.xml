<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DoubledDCLAllocationPercent__c</fullName>
    <formula>IF( AND(DirectTargetAmount__c  &gt; 0,DirectAchievedAmount__c &gt;= (DirectTargetAmount__c * 2)),  DCLAchievedAmount__c /  DirectAchievedAmount__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Doubled Co Lead Allocation Percent</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
