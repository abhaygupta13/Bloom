    <label>Leasing Receipt Allocation</label>
    <nameField>
        <displayFormat>LRA{0000000}</displayFormat>
        <label>Leasing Receipt Allocation Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Leasing Receipt Allocations</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>FullAmountValidation</fullName>
        <active>true</active>
        <errorConditionFormula>LeasingReceiptAcknowledgment__r.FullAmountAllocation__c &amp;&amp;  (LeasingReceiptAcknowledgment__r.Amount__c !=  AmountApplied__c )</errorConditionFormula>
        <errorMessage>Kindly allocate full amount for respective acknowledgement.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>InvoiceAmountCheck</fullName>
        <active>false</active>
        <errorConditionFormula>(PaymentPlanSchedule__c != Null &amp;&amp;  PaymentPlanSchedule__r.TotalInstallmentAmount__c &lt;  AmountApplied__c )||
	(LeasingOrderOtherCharges__c != Null &amp;&amp;  LeasingOrderOtherCharges__r.TotalAmount__c  &lt; AmountApplied__c)</errorConditionFormula>
        <errorMessage>Applied amount cannot be greater than Invoice Amount</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>acnledgmntAmntGrtrThnApliedAmnt</fullName>
        <active>true</active>
        <errorConditionFormula>LeasingReceiptAcknowledgment__c != Null &amp;&amp; AmountApplied__c &gt;  LeasingReceiptAcknowledgment__r.Amount__c</errorConditionFormula>
        <errorMessage>Applied amount cannot be greater than Amount on Receipt Acknowledgement.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
