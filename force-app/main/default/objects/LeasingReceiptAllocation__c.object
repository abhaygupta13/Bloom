        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ConditionType__c</fullName>
        <externalId>false</externalId>
        <formula>IF( LeasingOrderOtherCharges__c != Null,   TEXT(LeasingOrderOtherCharges__r.ConditionType__c) ,
	IF( PaymentPlanSchedule__c != Null,
		IF( ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Residential&quot;), &quot;R001&quot; ,
			IF(ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Commercial&quot;), &quot;R024&quot; ,
				IF(ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Retail&quot;), &quot;R028&quot;,&quot;&quot;)
			)
		),&quot;&quot;
	)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Condition Type</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
