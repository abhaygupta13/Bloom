    <fields>
        <fullName>InvoiceDocNo__c</fullName>
        <externalId>false</externalId>
        <formula>IF(PaymentPlanSchedule__c != Null &amp;&amp; PaymentPlanSchedule__r.RefDocno__c != Null, PaymentPlanSchedule__r.RefDocno__c, IF( LeasingOrderOtherCharges__c != Null &amp;&amp;  LeasingOrderOtherCharges__r.RefDocno__c != Null, LeasingOrderOtherCharges__r.RefDocno__c, &quot;&quot;))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
