        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>MaturityDate__c</fullName>
        <formula>IF(ReceiptAcknowledgement__r.New_Maturity_Date__c != NULL, ReceiptAcknowledgement__r.New_Maturity_Date__c, ReceiptAcknowledgement__r.MaturityDate__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Maturity Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
