    <label>Broker Application</label>
    <listViews>
        <fullName>All_Broker_Applications</fullName>
        <columns>NAME</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>ApplicationNumber__c</columns>
        <columns>TradeLicenseNumber__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Broker Applications</label>
        <sharedTo>
            <group>Broker_Mangement_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Approved_Broker_Applications</fullName>
        <columns>NAME</columns>
        <columns>ApplicationNumber__c</columns>
        <columns>TypeofEstablishment__c</columns>
        <columns>AgencyEmail__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>ApprovalStatus__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </filters>
        <label>Approved Broker Applications</label>
        <sharedTo>
            <group>BAPP_BBM_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Approved_by_BL</fullName>
        <columns>NAME</columns>
        <columns>ApplicationNumber__c</columns>
        <columns>ApprovalStatus__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved by BL</value>
        </filters>
        <label>Approved by BL</label>
    </listViews>
    <listViews>
        <fullName>Bloom_Legal_BL_BrokerApplication</fullName>
        <booleanFilter>1 AND (2 OR 3)</booleanFilter>
        <columns>NAME</columns>
        <columns>ApplicationNumber__c</columns>
        <columns>TypeofEstablishment__c</columns>
        <columns>AgencyEmail__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>OWNER.FIRST_NAME</columns>
        <columns>LAST_UPDATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>SendToBL__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved by BBM</value>
        </filters>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </filters>
        <label>Bloom Legal (BL)</label>
        <sharedTo>
            <group>BAPP_BL_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Broker_Applications_Broker_Management</fullName>
        <columns>NAME</columns>
        <columns>ApplicationNumber__c</columns>
        <columns>TypeofEstablishment__c</columns>
        <columns>AgencyEmail__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>OWNER.ALIAS</field>
            <operation>equals</operation>
            <value>Bloom Broker Management (BBM)</value>
        </filters>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Submitted</value>
        </filters>
        <label>Broker Management - Pending Approval</label>
        <sharedTo>
            <group>Broker_Mangement_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Broker_Applications_RFI_Received</fullName>
        <columns>NAME</columns>
        <columns>ApplicationNumber__c</columns>
        <columns>TypeofEstablishment__c</columns>
        <columns>AgencyEmail__c</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>OWNER.ALIAS</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>IsRFIUpdated__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>RFI</value>
        </filters>
        <label>Broker Applications - RFI Updated</label>
        <sharedTo>
            <group>BAPP_BBM_Team</group>
            <group>BAPP_Draft_RFI_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Broker_Draft_Applications</fullName>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Draft</value>
        </filters>
        <label>Broker Draft Applications</label>
        <sharedTo>
            <group>BAPP_Draft_RFI_Team</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Broker_RFI_Awaiting</fullName>
        <booleanFilter>1 AND 2</booleanFilter>
        <columns>NAME</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>RFI</value>
        </filters>
        <filters>
            <field>IsRFIUpdated__c</field>
            <operation>equals</operation>
            <value>0</value>
        </filters>
        <label>Broker – RFI Awaiting</label>
        <sharedTo>
            <group>BAPP_Draft_RFI_Team</group>
            <group>Sales_Lead_Manager</group>
        </sharedTo>
    </listViews>
    <listViews>
        <fullName>Final_Approval_Pending</fullName>
        <columns>NAME</columns>
        <columns>AgreementNumber__c</columns>
        <columns>TypeofEstablishment__c</columns>
        <columns>AgencyEmail__c</columns>
        <columns>ApprovalStatus__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Agreement Completed</value>
        </filters>
        <label>Final Approval Pending</label>
        <sharedTo>
            <group>BAPP_BBM_Team</group>
        </sharedTo>
    </listViews>
    <nameField>
        <label>Agency Name</label>
        <trackHistory>true</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Broker Applications</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
