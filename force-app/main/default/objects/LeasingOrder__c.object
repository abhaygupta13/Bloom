    <label>Leasing Order</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>LeasingStartDate__c</columns>
        <columns>LeasingEndDate__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>OwnerName__c</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <listViews>
        <fullName>Leasing_Finance_queue_LeasingOrder</fullName>
        <filterScope>Queue</filterScope>
        <label>Leasing Finance queue</label>
        <queue>Leasing_Finance_queue</queue>
        <sharedTo>
            <allInternalUsers></allInternalUsers>
        </sharedTo>
    </listViews>
    <nameField>
        <label>Leasing Order Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Leasing Orders</pluralLabel>
    <profileSearchLayouts>
        <fields>NAME</fields>
        <fields>SAPCompanyCode__c</fields>
        <fields>LeasingSAPContractId__c</fields>
        <fields>LeasingOrderDataMigrationUniqueKey__c</fields>
        <fields>LeasingOrderNumber__c</fields>
        <fields>LeasingStartDate__c</fields>
        <fields>LeasingEndDate__c</fields>
        <profileName>Support Administrator</profileName>
    </profileSearchLayouts>
    <searchLayouts>
        <searchResultsAdditionalFields>SAPCompanyCode__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LeasingSAPContractId__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LeasingOrderDataMigrationUniqueKey__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LeasingOrderNumber__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LeasingStartDate__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>LeasingEndDate__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>RequireSignedOfferForNewLease</fullName>
        <active>true</active>
        <description>For New Leasing Orders, a signed Leasing Offer is required before Bloom Team Approval.</description>
        <errorConditionFormula>AND(
    ISPICKVAL(LeaseType__c, &apos;New&apos;),
    ISPICKVAL(BloomTeamApprovalStatus__c, &apos;Approved&apos;),
    isLeasingOfferSigned__c = FALSE,
    OR(
        ISNEW(),
        ISCHANGED(BloomTeamApprovalStatus__c)
    )
)</errorConditionFormula>
        <errorDisplayField>BloomTeamApprovalStatus__c</errorDisplayField>
        <errorMessage>For new leasing orders, a signed leasing offer is required before Bloom Team Approval.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
