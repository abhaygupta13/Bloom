    <fields>
        <fullName>TotalAnnualRentwithVAT__c</fullName>
        <formula>AnnualRentVATAmount__c  +  RentalAmountAfterDiscount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Rent with VAT</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TotalDiscount__c</fullName>
        <label>Total Discount</label>
        <summarizedField>LeasingEscalationSchedule__c.Discount__c</summarizedField>
        <summaryForeignKey>LeasingEscalationSchedule__c.LeasingOrder__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>TotalInstallment__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
    OR(ISBLANK(LeasingEndDate__c), ISBLANK(LeasingStartDate__c), ISBLANK(TEXT(PaymentTerm__c))),
    &quot;0 installments&quot;,
    TEXT(
        ROUND(
            ((LeasingEndDate__c - LeasingStartDate__c) / 365) * VALUE(LEFT(TEXT(PaymentTerm__c), FIND(&quot; &quot;, TEXT(PaymentTerm__c)) - 1)), 
            0
        )
    ) &amp; &quot; installments&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Installment</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>TotalRentAfterDiscount__c</fullName>
        <label>Total Rent Amount</label>
        <summarizedField>LeasingEscalationSchedule__c.AfterDiscount__c</summarizedField>
        <summaryForeignKey>LeasingEscalationSchedule__c.LeasingOrder__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>TotalRentForPeriodWithVAT__c</fullName>
        <formula>IF(isVATApplied__c, TotalRentForPeriod__c * 1.05, TotalRentForPeriod__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total Rent For Period With VAT</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>TotalRentForPeriod__c</fullName>
        <description>This field aggregates the sum of all rent installments from the associated Payment Plan Schedules. It was created to replace the static &apos;RentForPeriod&apos; formula field, ensuring that the exact prorated contract value is accurately reflected based on the generated payment plan.</description>
        <inlineHelpText>This amount is automatically calculated by summing up the total rent installments from your generated payment plan. It represents the exact prorated rent for this specific contract duration.</inlineHelpText>
        <label>Total Rent For Period</label>
        <summarizedField>PaymentPlanSchedule__c.Amount__c</summarizedField>
        <summaryForeignKey>PaymentPlanSchedule__c.LeasingOrder__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>TotalRent__c</fullName>
        <label>Total Rent with Escalations</label>
        <summarizedField>LeasingEscalationSchedule__c.TotalRent__c</summarizedField>
        <summaryForeignKey>LeasingEscalationSchedule__c.LeasingOrder__c</summaryForeignKey>
        <summaryOperation>sum</summaryOperation>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Summary</type>
    </fields>
    <fields>
        <fullName>UnitHandOverDate__c</fullName>
        <label>Unit Hand Over Date</label>
