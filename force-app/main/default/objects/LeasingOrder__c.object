    <fields>
        <fullName>AnnualRentVATAmount__c</fullName>
        <formula>If( (ISPICKVAL(Unit__r.PropertyUsage__c, &apos;Commercial&apos;) ||
ISPICKVAL(Unit__r.PropertyUsage__c, &apos;Retail&apos;)) &amp;&amp; isVATApplied__c = true, RentalAmountAfterDiscount__c * Unit__r.Project__r.Leasing_Company__r.LeasingVAT__c,0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Annual Rent VAT</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
