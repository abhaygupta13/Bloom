        <externalId>false</externalId>
        <formula>LPAD(TEXT(DAY(NOC_Date__c)), 2, &quot;0&quot;) &amp; &quot;-&quot; &amp;
LPAD(TEXT(MONTH(NOC_Date__c)), 2, &quot;0&quot;) &amp; &quot;-&quot; &amp;
TEXT(YEAR(NOC_Date__c))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>NOC Date Formatted</label>
        <required>false</required>
