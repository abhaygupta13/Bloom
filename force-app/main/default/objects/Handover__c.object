    <sharingModel>Read</sharingModel>
    <validationRules>
        <fullName>Escrow_Letter_available_confirmation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
NOT(Project__r.IsByPassHOStatus__c),
ISPICKVAL(Payment_Type__c, &quot;Mortgage&quot;),
OR(
ISPICKVAL(Sub_Status__c, &quot;Escrow Letter Generated&quot;)
),
NOT(Escrow_Letter__c)
)</errorConditionFormula>
        <errorMessage>Please confirm the Escrow letter before moving to forward status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Mortgage_Fee_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND( ISPICKVAL( Payment_Type__c , &apos;Mortgage&apos;) ,OR(ISPICKVAL(  Sub_Status__c  , &apos;Upload Mortgage Release Documents&apos;),ISPICKVAL(  Sub_Status__c  , &apos;Tawtheeq Enrollment&apos;)), ISBLANK(  Mortgage_Value__c ) )</errorConditionFormula>
        <errorDisplayField>Mortgage_Value__c</errorDisplayField>
        <errorMessage>Mortgage Value is required when Payment Type is Mortgage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>NON_PHPP_Before_Handovercompleted</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Sub_Status__c, &apos;Handover Completed&apos;),
    OR(
        ISPICKVAL(Payment_Type__c, &apos;Cash&apos;),
        ISPICKVAL(Payment_Type__c, &apos;Mortgage&apos;)
    ),
    OR(
        NOT(Is_BCC_Announcement_Sent__c),
        NOT(Is_Notice_of_Completion_Sent__c),
        NOT(Is_Orientation_Letter_Sent__c),
        NOT(Is_Access_Cards_given__c),
        NOT(Is_Property_keys_given__c),
        NOT(ADDC__c),
        NOT(Is_Title_Deed_Registration__c),
        NOT(Is_Statement_of_Account_given__c),
        NOT(Handover_Guidelines_Brief__c)
    ),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    $Profile.Name &lt;&gt; &quot;Handover Manager&quot;
)</errorConditionFormula>
        <errorMessage>All  KHO checklist should be checked before Handover Completed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Need_to_update_BAM_handover_fields</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISCHANGED(Sub_Status__c),
ISPICKVAL(Sub_Status__c, &quot;Handover Keys to BAM&quot;),
ISBLANK(Sales_Order__c),
OR(

NOT(Is_Access_Cards_given__c),
NOT(Is_Property_keys_given__c),
NOT(Handover_Guidelines_Brief__c),
ISBLANK(Key_Handed_Over_Date__c)
)

)</errorConditionFormula>
        <errorMessage>Please Update Key Handover Checklist fields Before Updating Key Handover To BAM</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Non_PHPP_Finance_Status_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Sub_Status__c, &apos;Generate Bank NOC&apos;),
    ISCHANGED(Sub_Status__c),
    OR(
        NOT(Collection_Till_Handover__c),
        ISBLANK(Collection_Till_Handover_Amount__c),
        NOT(Collection_on_H_O__c),
        ISBLANK(CollectionOnHandoverAmount__c),
        NOT(Collection_of_PDC_s__c),
        ISBLANK(Collection_of_PDC_s_Amount__c),
        ISBLANK(Hassantuk_Fees__c),
        ISBLANK(Title_Deed_Fee__c),
        ISBLANK(Service_Charge_Collection_Amount__c),
        NOT(Service_Charge_Collection__c),
        ISPICKVAL(Payment_Type__c, &apos;&apos;),
        ISBLANK(Bounced_chqs_fees__c),
        ISBLANK(Late_payment_fees__c),
        ISBLANK(Admin_fees__c),
        ISBLANK(Post_HO_PDCs_Collection__c),
        ISBLANK(Service_charge_clearance__c),
        IF(
           ISPICKVAL(Payment_Type__c, &apos;Mortgage&apos;),
            FALSE,ISBLANK(Payment_Date__c))
        

    )
)</errorConditionFormula>
        <errorDisplayField>Account__c</errorDisplayField>
        <errorMessage>Payment Collection fields are mandatory before moving to NOC Internal Followup status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PHPP_Before_Handovercompleted</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Sub_Status__c, &apos;Handover Completed&apos;),
    ISPICKVAL(Payment_Type__c, &apos;PHPP&apos;),
    OR(
        NOT(Is_BCC_Announcement_Sent__c),
        NOT(Is_Notice_of_Completion_Sent__c),
        NOT(Is_Orientation_Letter_Sent__c),
        NOT(Is_Access_Cards_given__c),
        NOT(Is_Property_keys_given__c),
        NOT(Is_Statement_of_Account_given__c),
        NOT(Handover_Guidelines_Brief__c)
    ),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;,
    $Profile.Name &lt;&gt; &quot;Handover Manager&quot;
)</errorConditionFormula>
        <errorMessage>All  KHO checklist should be checked before Handover Completed</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PHPP_Finance_Clearance_Status_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISPICKVAL(Sub_Status__c, &apos;HO Undertaking Letter&apos;),
ISPICKVAL(Payment_Type__c, &apos;PHPP&apos;),
ISCHANGED(Sub_Status__c),
OR(
ISBLANK(Collection_on_H_O_Amount__c),
ISBLANK(UnitCollectionTillClearanceDate__c),
ISBLANK(Hassantuk_Fees__c),
NOT(IsHassantukFeesCollected__c),
NOT(UtilitiesSecurityChequeCollected__c),
ISBLANK(Service_Charge_Collection_Amount__c),
NOT(Service_Charge_Collection__c),
NOT(Payment_Settled__c),
ISBLANK(Payment_Date__c)
)
)</errorConditionFormula>
        <errorMessage>PHPP Finance Clearance fields are mandatory before moving to PHPP Finance Clearance status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>PHPP_Finance_Status_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Sub_Status__c, &apos;HO Undertaking Letter&apos;),
    ISCHANGED(Sub_Status__c),
    OR(
        NOT(Collection_Till_Handover__c),
        ISBLANK(Collection_Till_Handover_Amount__c),
        NOT(UtilitiesSecurityChequeCollected__c),
        NOT(Collection_on_H_O__c),
        ISBLANK(CollectionOnHandoverAmount__c),
        NOT(Collection_of_PDC_s__c),
        ISBLANK(Collection_of_PDC_s_Amount__c),
        ISBLANK(Hassantuk_Fees__c),
        ISBLANK(Title_Deed_Fee__c),
        ISBLANK(Service_Charge_Collection_Amount__c),
        NOT(Service_Charge_Collection__c),
        ISPICKVAL(Payment_Type__c, &apos;&apos;),
        ISBLANK(Bounced_chqs_fees__c),
        ISBLANK(Late_payment_fees__c),
        ISBLANK(Admin_fees__c),
        ISBLANK(Post_HO_PDCs_Collection__c),
        ISBLANK(Service_charge_clearance__c),
        IF(
           ISPICKVAL(Payment_Type__c, &apos;Mortgage&apos;),
            FALSE,ISBLANK(Payment_Date__c))
        

    )
)</errorConditionFormula>
        <errorDisplayField>Account__c</errorDisplayField>
        <errorMessage>Payment Collection fields are mandatory before moving to HO Undertaking Letter status</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Payment_settlement_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Sub_Status__c, &quot;Schedule KHO Appointment&quot;),
    ISCHANGED(Sub_Status__c),
    OR(
        ISNULL(Payment_Date__c),
        NOT(Payment_Settled__c)  
    )
)</errorConditionFormula>
        <errorMessage>Payment Collection fields are mandatory before moving to forward status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Skip_stage_If_No_PHPP</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
OR(
ISPICKVAL(Payment_Type__c, &quot;Mortgage&quot;)||
ISPICKVAL(Payment_Type__c, &quot;Cash&quot;)
),
ISCHANGED(Sub_Status__c),
NOT(
OR(
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;QA De-Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;Home Orientation Sent&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Home Orientation Sent&quot;), ISPICKVAL(Sub_Status__c, &quot;Appointment Booked with Customer&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Home Orientation Sent&quot;), ISPICKVAL(Sub_Status__c, &quot;Pre-Checklist Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Appointment Booked with Customer&quot;), ISPICKVAL(Sub_Status__c, &quot;Pre-Checklist Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Pre-Checklist Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;CHO Snagging Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;CHO Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;CHO De-Snagging Completed&quot;)),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;CHO De-Snagging Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Notice of Completion sent&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Notice of Completion sent&quot;),
ISPICKVAL(Sub_Status__c, &quot;Payment Settled&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Payment Settled&quot;),
ISPICKVAL(Sub_Status__c, &quot;Finance Verified&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Finance Verified&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Release Initiated&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Finance Verified&quot;),
ISPICKVAL(Sub_Status__c, &quot;Escrow Letter Generated&quot;)
),

AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Mortgage Release Initiated&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Release Document Uploaded&quot;)
),

AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Mortgage Release Document Uploaded&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Release Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Mortgage Release Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Escrow Letter Generated&quot;)
),

AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Escrow Letter Generated&quot;),
ISPICKVAL(Sub_Status__c, &quot;Title Deed Registration Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Title Deed Registration Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Utilities Transfer Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Utilities Transfer Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Cheque Clearance&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Mortgage Cheque Clearance&quot;),
ISPICKVAL(Sub_Status__c, &quot;KHO Appointment Scheduled&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;KHO Appointment Scheduled&quot;),
ISPICKVAL(Sub_Status__c, &quot;Handover Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Utilities Transfer Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Handover Completed&quot;)
)
)
),
NOT(
OR(
$Profile.Name = &quot;System Administrator&quot;,
$Profile.Name = &quot;HO Manager&quot;,
$Permission.BypassValidationRule,
AND(
OR(
ISPICKVAL(Sub_Status__c, &quot;Notice of Completion sent&quot;),
ISPICKVAL(Sub_Status__c, &quot;Potential Defaulter&quot;),
ISPICKVAL(Sub_Status__c, &quot;Default -Under Discussion&quot;)
),
$Permission.Handover_Collection_Team_Access
),
AND(
ISPICKVAL(Sub_Status__c, &quot;Potential Defaulter&quot;),
$Profile.Name = &quot;CRM Operations&quot;
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Title Deed Registration Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Cheque Clearance&quot;),
ISPICKVAL(Payment_Type__c, &quot;Cash&quot;)
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Sub_Status__c</errorDisplayField>
        <errorMessage>You can only move to next stage</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Prevent_Skip_stage_If_PHPP</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISPICKVAL(Payment_Type__c, &quot;PHPP&quot;),
ISCHANGED(Sub_Status__c),
NOT(
OR(
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;QA De-Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;Home Orientation Sent&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Home Orientation Sent&quot;), ISPICKVAL(Sub_Status__c, &quot;Appointment Booked with Customer&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Home Orientation Sent&quot;), ISPICKVAL(Sub_Status__c, &quot;Pre-Checklist Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Appointment Booked with Customer&quot;), ISPICKVAL(Sub_Status__c, &quot;Pre-Checklist Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Pre-Checklist Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;CHO Snagging Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;CHO Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;CHO De-Snagging Completed&quot;)),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;CHO De-Snagging Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Notice of Completion sent&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Notice of Completion sent&quot;),
ISPICKVAL(Sub_Status__c, &quot;Payment Settled&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Payment Settled&quot;),
ISPICKVAL(Sub_Status__c, &quot;Finance Verified&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Finance Verified&quot;),
ISPICKVAL(Sub_Status__c, &quot;Property Registration Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Property Registration Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Lease Agreement&quot;)
),

AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Lease Agreement&quot;),
ISPICKVAL(Sub_Status__c, &quot;PHPP - KHO Appointment Scheduled&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;PHPP - KHO Appointment Scheduled&quot;),
ISPICKVAL(Sub_Status__c, &quot;Key Handed Over PHPP&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Key Handed Over PHPP&quot;),
ISPICKVAL(Sub_Status__c, &quot;PHPP Completion Pending&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;PHPP Completion Pending&quot;),
ISPICKVAL(Sub_Status__c, &quot;PHPP Finance Clearance&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;PHPP Finance Clearance&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Release Initiated&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Mortgage Release Initiated&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Release Document Uploaded&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Mortgage Release Document Uploaded&quot;),
ISPICKVAL(Sub_Status__c, &quot;Mortgage Release Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Mortgage Release Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Title Deed Registration Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Title Deed Registration Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Utilities Transfer Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Utilities Transfer Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Handover Completed&quot;)
),
AND(
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;KHO Appointment Scheduled&quot;),
ISPICKVAL(Sub_Status__c, &quot;Handover Completed&quot;)
)
)
),
NOT(
OR(
$Profile.Name = &quot;System Administrator&quot;,
$Profile.Name = &quot;HO Manager&quot;,
$Profile.Name = &quot;Finance Team&quot;,
$Permission.BypassValidationRule,
AND(
OR(
ISPICKVAL(Sub_Status__c, &quot;Notice of Completion sent&quot;),
ISPICKVAL(Sub_Status__c, &quot;Potential Defaulter&quot;),
ISPICKVAL(Sub_Status__c, &quot;Default -Under Discussion&quot;)
),
$Permission.Handover_Collection_Team_Access
),
AND(
ISPICKVAL(Sub_Status__c, &quot;Potential Defaulter&quot;),
$Profile.Name = &quot;CRM Operations&quot;
)


)
)
)</errorConditionFormula>
        <errorDisplayField>Sub_Status__c</errorDisplayField>
        <errorMessage>You can only move to next stage</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Property_Registration_Number</fullName>
        <active>false</active>
        <errorConditionFormula>AND( ISPICKVAL(Sub_Status__c , &apos;Lease Agreement&apos;) , ISBLANK( Property_Registration_Number__c) )</errorConditionFormula>
        <errorDisplayField>Property_Registration_Number__c</errorDisplayField>
        <errorMessage>Please add the Property Registration Number before Lease Agreement</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_Owner_Change</fullName>
        <active>false</active>
        <description>Restric owner change manually by team members.</description>
        <errorConditionFormula>ISCHANGED(OwnerId) &amp;&amp;
NOT(ISCHANGED(Sub_Status__c)) &amp;&amp;
NOT(
ISPICKVAL(Sub_Status__c, &quot;Escrow Letter Generated&quot;) ||
ISPICKVAL(Sub_Status__c, &quot;QA De-Snagging Completed&quot;) ||
ISPICKVAL(Sub_Status__c, &quot;Mortgage Release Completed&quot;)
) &amp;&amp;
NOT(
OR(
$Profile.Name = &quot;HO Manager&quot;,
$Profile.Name = &quot;CRM Operations&quot;,
$Profile.Name = &quot;System Administrator&quot;,
$Permission.BypassValidationRule,
ISPICKVAL($User.UserType, &apos;AutomatedProcess&apos;)
)
)</errorConditionFormula>
        <errorMessage>You are not allowed to change the owner of this record.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Restrict_handover_SalsorderNot_Available</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISBLANK(Sales_Order__c),
ISCHANGED(Sub_Status__c),
NOT(
OR(
ISPICKVAL(Sub_Status__c, &quot;QA Snagging&quot;),
ISPICKVAL(Sub_Status__c, &quot;QA De-Snagging&quot;),
ISPICKVAL(Sub_Status__c, &quot;Handover Keys to BAM&quot;),
ISPICKVAL(Sub_Status__c, &quot;New&quot;)
)
)
)</errorConditionFormula>
        <errorMessage>Please provide the Sales Order before updating any status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sending_of_Noc_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
    ISPICKVAL(Sub_Status__c, &quot;Send Handover Notice&quot;),
    ISCHANGED(Sub_Status__c),
    OR(
        
        NOT(Is_Notice_of_Completion_Sent__c)  
    )
)</errorConditionFormula>
        <errorMessage>Please send NOC before moving to this stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Status_Moving_Forward_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
ISCHANGED(Sub_Status__c) || ISNEW(),
ISBLANK(TEXT(Payment_Type__c)),
NOT(
OR(
ISPICKVAL(Sub_Status__c, &quot;Created&quot;),
ISPICKVAL(Sub_Status__c, &quot;QA Snagging Completed&quot;),
ISPICKVAL(Sub_Status__c, &quot;Potential Defaulter&quot;),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Created&quot;), ISPICKVAL(Sub_Status__c, &quot;QA Snagging Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;QA Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;QA De-Snagging Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;QA De-Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;Home Orientation Sent&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Created&quot;), ISPICKVAL(Sub_Status__c, &quot;Home Orientation Sent&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;QA Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;Home Orientation Sent&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Home Orientation Sent&quot;), ISPICKVAL(Sub_Status__c, &quot;Appointment Booked with Customer&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Home Orientation Sent&quot;), ISPICKVAL(Sub_Status__c, &quot;Pre-Checklist Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Appointment Booked with Customer&quot;), ISPICKVAL(Sub_Status__c, &quot;Pre-Checklist Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Pre-Checklist Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;CHO Snagging Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;CHO Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;CHO De-Snagging Completed&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;CHO De-Snagging Completed&quot;), ISPICKVAL(Sub_Status__c, &quot;Notice of Completion sent&quot;)),
AND(ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Notice of Completion sent&quot;), ISPICKVAL(Sub_Status__c, &quot;Payment Settled&quot;))
)
),
NOT(
OR(
$Profile.Name = &quot;System Administrator&quot;,
$Profile.Name = &quot;HO Manager&quot;,
$Profile.Name = &quot;CRM Operations&quot;,
$Permission.BypassValidationRule,
AND(
OR(
ISPICKVAL(Sub_Status__c, &quot;Notice of Completion sent&quot;),
ISPICKVAL(Sub_Status__c, &quot;Potential Defaulter&quot;),
ISPICKVAL(Sub_Status__c, &quot;Default -Under Discussion&quot;)
),
$Permission.Handover_Collection_Team_Access
)
)
)
)</errorConditionFormula>
        <errorDisplayField>Sub_Status__c</errorDisplayField>
        <errorMessage>You can only move to the next status in the Handover path.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Status_Moving_HandComp_PotentialDefault</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
ISCHANGED(Sub_Status__c),
ISPICKVAL(PRIORVALUE(Sub_Status__c), &quot;Handover Completed&quot;),
OR(
ISPICKVAL(Sub_Status__c, &quot;Potential Defaulter&quot;),
ISPICKVAL(Sub_Status__c, &quot;Default -Under Discussion&quot;)
)
)</errorConditionFormula>
        <errorMessage>After handover is complete, you cannot move to the forward status.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Sub_Status_Handover_Completed_Validation</fullName>
        <active>false</active>
        <errorConditionFormula>AND(
        ISCHANGED(Sub_Status__c),
        OR(
            	ISPICKVAL( Sub_Status__c ,&apos;Handover Completed&apos;),
                ISPICKVAL( Sub_Status__c ,&apos;PHPP Hand Over Keys&apos;)
        ),
	OR(
                NOT(Is_BCC_Announcement_Sent__c),
		NOT(Is_Notice_of_Completion_Sent__c),
		NOT(Is_Orientation_Letter_Sent__c),
		NOT(Is_Access_Cards_given__c),
		NOT(Is_Property_keys_given__c),
		NOT(Is_Statement_of_Account_given__c),
		NOT(Handover_Guidelines_Brief__c),
                NOT(Service_Charges_Confirmed__c),
		NOT(ADDC__c)
	),
	NOT(
		OR(
		  $Profile.Name = &quot;System Administrator&quot;,
		  $Profile.Name = &quot;Handover Manager&quot;
		)
	)
)</errorConditionFormula>
        <errorMessage>Please complete the KHO Process first before moving to this stage.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Unit_Category_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    NOT(
        OR(
            $Profile.Name = &quot;System Administrator&quot;,
            $Permission.BypassValidationRule
        )
    ),
    ISPICKVAL(PRIORVALUE(Sub_Status__c), &apos;Send Handover Notice&apos;),
    NOT(ISPICKVAL(Sub_Status__c, &apos;Settlement Follow up&apos;)),
    ISBLANK(TEXT(UnitCategory__c))
)</errorConditionFormula>
        <errorDisplayField>UnitCategory__c</errorDisplayField>
        <errorMessage>Please select Unit Category</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>Survey_Link</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <encodingKey>UTF-8</encodingKey>
        <hasMenubar>false</hasMenubar>
        <hasScrollbars>true</hasScrollbars>
        <hasToolbar>false</hasToolbar>
        <height>600</height>
        <isResizable>true</isResizable>
        <linkType>url</linkType>
        <masterLabel>Survey Link</masterLabel>
        <openType>newWindow</openType>
        <position>none</position>
        <protected>false</protected>
        <showsLocation>false</showsLocation>
        <showsStatus>false</showsStatus>
        <url>{!Handover__c.SurveyLink__c}</url>
    </webLinks>
</CustomObject>
