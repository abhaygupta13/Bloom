    <fields>
        <fullName>MortgageFee__c</fullName>
        <formula>IF(
    ISBLANK(TEXT(UnitCategory__c)),
    IF(Mortgage_Value__c &gt; 0, ((0.09 / 100) * Mortgage_Value__c) + 945, 0),
    IF(Mortgage_Value__c &gt; 0, ((0.09 / 100) * Mortgage_Value__c), 0)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
