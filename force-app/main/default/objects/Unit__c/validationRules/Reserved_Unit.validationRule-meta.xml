<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reserved_Unit</fullName>
    <active>false</active>
    <errorConditionFormula>IF(
ISPICKVAL(Active_Sales_Order__r.Status__c, &apos;Reserved&apos;)
 &amp;&amp; NOT(ISPICKVAL(Status__c, &apos;Reserved&apos;))&amp;&amp; ISCHANGED(Status__c),
TRUE,
FALSE
)</errorConditionFormula>
    <errorMessage>Status cannot be changed when the Unit is Reserved</errorMessage>
</ValidationRule>
