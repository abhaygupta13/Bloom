<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PublicExclusiveCheck</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
IsPublic__c = TRUE,
IsExclusive__c = TRUE
)</errorConditionFormula>
    <errorMessage>A unit cannot be public and exclusive at the same time.</errorMessage>
</ValidationRule>
