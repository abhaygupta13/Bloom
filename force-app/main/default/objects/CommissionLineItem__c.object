    </fields>
    <fields>
        <fullName>Send_to_SAP__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Send to SAP</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Sold_Date__c</fullName>
        <formula>SalesOrder__r.SoldDate__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Sold Date</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <description>Status of the commission line item.</description>
        <inlineHelpText>Status of the commission line item.</inlineHelpText>
        <label>Status</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Sale Pending Completion</fullName>
                    <default>true</default>
                    <label>Sale Pending Completion</label>
                </value>
                <value>
                    <fullName>Invoice Ready</fullName>
                    <default>false</default>
                    <label>Invoice Ready</label>
                </value>
                <value>
                    <fullName>Invoice Submitted</fullName>
                    <default>false</default>
                    <label>Invoice Submitted</label>
                </value>
                <value>
                    <fullName>Invoice Approved</fullName>
                    <default>false</default>
                    <label>Invoice Approved</label>
                </value>
                <value>
                    <fullName>Invoice Rejected</fullName>
                    <default>false</default>
                    <label>Invoice Rejected</label>
                </value>
                <value>
                    <fullName>Under Payment Processing</fullName>
                    <default>false</default>
                    <label>Under Payment Processing</label>
                </value>
                <value>
                    <fullName>Paid</fullName>
                    <default>false</default>
                    <label>Paid</label>
                </value>
                <value>
                    <fullName>Approved</fullName>
                    <default>false</default>
                    <isActive>false</isActive>
                    <label>Approved</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Tax_Amount__c</fullName>
        <externalId>false</externalId>
        <formula>IF( Taxable__c = false, 0, Updated_Commission_Amount__c * 5 / 100)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Tax Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Taxable__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Taxable</description>
        <label>Taxable</label>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>TotalExternalCommissionPercentage__c</fullName>
        <formula>IF( ISPICKVAL(CommissionType__c,&apos;External&apos;) , SalesOrder__r.ExternalCommissionAmount__c / SalesOrder__r.AmountPayable__c ,null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Total External Comm %</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Total_Updated_Commission_Percent__c</fullName>
        <label>Total Updated Commission Percent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>Unit__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Unit associated with the commission line</description>
        <inlineHelpText>Unit associated with the commission line</inlineHelpText>
        <label>Unit</label>
        <referenceTo>Unit__c</referenceTo>
        <relationshipLabel>Commission Line Items</relationshipLabel>
        <relationshipName>Commission_Line_Items</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Updated_Commission_Amount__c</fullName>
        <externalId>false</externalId>
        <formula>PercentageWRTNetPrice__c  *  SalesOrder__r.NetAmount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Updated Commission Amount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Commission Line Item</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>BrokerAgency__c</columns>
        <columns>BrokerAgent__c</columns>
        <columns>SalesOrder__c</columns>
        <columns>InvoiceNumber__c</columns>
        <columns>CommissionAmount__c</columns>
        <columns>CommissionPercentage__c</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <label>1. All</label>
    </listViews>
    <listViews>
        <fullName>Approval_In_Progress</fullName>
        <columns>NAME</columns>
        <columns>BrokerAgency__c</columns>
        <columns>BrokerAgent__c</columns>
        <columns>SalesOrder__c</columns>
        <columns>InvoiceNumber__c</columns>
        <columns>CommissionAmount__c</columns>
        <columns>CommissionPercentage__c</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>In Progress</value>
        </filters>
        <label>4. Approval In Progress</label>
    </listViews>
    <listViews>
        <fullName>Approval_In_Rejected</fullName>
        <columns>NAME</columns>
        <columns>BrokerAgency__c</columns>
        <columns>BrokerAgent__c</columns>
        <columns>SalesOrder__c</columns>
        <columns>InvoiceNumber__c</columns>
        <columns>CommissionAmount__c</columns>
        <columns>CommissionPercentage__c</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </filters>
        <label>5. Approval Rejected</label>
    </listViews>
    <listViews>
        <fullName>Approved</fullName>
        <columns>NAME</columns>
        <columns>BrokerAgency__c</columns>
        <columns>BrokerAgent__c</columns>
        <columns>SalesOrder__c</columns>
        <columns>InvoiceNumber__c</columns>
        <columns>CommissionAmount__c</columns>
        <columns>CommissionPercentage__c</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>ApprovalStatus__c</field>
            <operation>equals</operation>
            <value>Approved</value>
        </filters>
        <label>6. Approved</label>
    </listViews>
    <listViews>
        <fullName>Rejected</fullName>
        <columns>NAME</columns>
        <columns>BrokerAgency__c</columns>
        <columns>BrokerAgent__c</columns>
        <columns>SalesOrder__c</columns>
        <columns>InvoiceNumber__c</columns>
        <columns>CommissionAmount__c</columns>
        <columns>CommissionPercentage__c</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Rejected</value>
        </filters>
        <label>2. Rejected By Agency</label>
    </listViews>
    <listViews>
        <fullName>Submit_for_Approval</fullName>
        <columns>NAME</columns>
        <columns>BrokerAgency__c</columns>
        <columns>BrokerAgent__c</columns>
        <columns>SalesOrder__c</columns>
        <columns>InvoiceNumber__c</columns>
        <columns>CommissionAmount__c</columns>
        <columns>CommissionPercentage__c</columns>
        <columns>ApprovalStatus__c</columns>
        <columns>CREATED_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Pending Invoice Verification</value>
        </filters>
        <label>3. Verify and Submit for Approval</label>
    </listViews>
    <nameField>
        <displayFormat>CLI{00000000}</displayFormat>
        <label>Commission Line Item #</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Commission Line Items</pluralLabel>
    <searchLayouts>
        <excludedStandardButtons>New</excludedStandardButtons>
        <excludedStandardButtons>OpenListInQuip</excludedStandardButtons>
        <excludedStandardButtons>NewFromDocument</excludedStandardButtons>
        <excludedStandardButtons>PrintableListView</excludedStandardButtons>
        <excludedStandardButtons>ChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Import</excludedStandardButtons>
        <excludedStandardButtons>MassChangeOwner</excludedStandardButtons>
        <excludedStandardButtons>Accept</excludedStandardButtons>
        <searchResultsAdditionalFields>BrokerAgency__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>BrokerAgent__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>SalesManager__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CommissionAmount__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>SalesOrder__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>CREATED_DATE</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
