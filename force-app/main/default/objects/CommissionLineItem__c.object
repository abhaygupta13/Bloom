    <fields>
        <fullName>Broker_Payment_Type_Text__c</fullName>
        <externalId>false</externalId>
        <formula>IF(TEXT(Broker_Commission_Payment_Type__c) != &apos;&apos;,  TEXT(Broker_Commission_Payment_Type__c) , IF( InstalmentNumber__c = &apos;1&apos;, &apos;Broker Commission First Payment&apos;,&apos;Broker Commission Final Payment&apos; ))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Broker Payment Type Text</label>
        <required>false</required>
