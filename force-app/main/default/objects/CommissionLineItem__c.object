    <fields>
        <fullName>InstalmentNumber__c</fullName>
        <description>Instalment line number formula field</description>
        <externalId>false</externalId>
        <formula>TEXT( InstallmentLine__r.InstallmentNumber__c )</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Instalment #</label>
