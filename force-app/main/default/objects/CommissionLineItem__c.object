        <inlineHelpText>Invoice number that was approved for a broker agent.</inlineHelpText>
        <label>Invoice#</label>
        <length>10</length>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InvoiceReferenceNumber__c</fullName>
        <externalId>false</externalId>
        <formula>IF( ISPICKVAL(CommissionType__c,&apos;External&apos;) , IF( OldCommissionReference__c !=null ,OldCommissionReference__c ,SalesOrder__r.Name +&apos;_&apos;+ InstalmentNumber__c +&apos;_&apos; + InvoiceNumber__c ), null)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Invoice Reference Number</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
