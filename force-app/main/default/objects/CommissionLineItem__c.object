        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InstalmentPaid__c</fullName>
        <externalId>false</externalId>
        <formula>IF( (InstallmentLine__r.InstallmentAmount__c -  InstallmentLine__r.ClearedAmount__c) &lt; 50, &apos;Yes&apos;, &apos;No&apos;)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Instalment Paid ?</label>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
