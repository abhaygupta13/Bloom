    </fields>
    <fields>
        <fullName>Transfer_in_Progress_Account__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Transfer in Progress Account</description>
        <inlineHelpText>Transfer in Progress Account</inlineHelpText>
        <label>Main Buyer</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Joint Owners (Transfer in Progress Account)</relationshipLabel>
        <relationshipName>Sales_OrdersJOTrfAcct</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
