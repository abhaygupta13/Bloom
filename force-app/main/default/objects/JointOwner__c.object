    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>JointOwner_share_percetage_validation</fullName>
        <active>true</active>
        <errorConditionFormula>SharePercentage__c &gt;1</errorConditionFormula>
        <errorMessage>Percentage Should Not Exceed 100%</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
    <webLinks>
        <fullName>New</fullName>
