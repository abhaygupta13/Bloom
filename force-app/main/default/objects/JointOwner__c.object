    </fields>
    <label>Joint Owner</label>
    <nameField>
        <displayFormat>JO-{000}</displayFormat>
        <label>Joint Owner Number</label>
        <trackHistory>true</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Joint Owners</pluralLabel>
