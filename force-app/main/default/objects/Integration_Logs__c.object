    <listViews>
        <fullName>Today_s_Logs</fullName>
        <columns>NAME</columns>
        <columns>Unit__c</columns>
        <columns>Type__c</columns>
        <columns>Status__c</columns>
        <columns>Status_code__c</columns>
        <columns>Error__c</columns>
        <columns>Method__c</columns>
        <columns>CREATED_DATE</columns>
        <columns>CREATEDBY_USER</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>CREATED_DATE</field>
            <operation>equals</operation>
            <value>TODAY</value>
        </filters>
        <filters>
            <field>CREATEDBY_USER</field>
            <operation>contains</operation>
            <value>Admin</value>
        </filters>
        <filters>
            <field>Status_code__c</field>
            <operation>notEqual</operation>
            <value>200</value>
        </filters>
        <label>Today&apos;s Logs</label>
    </listViews>
