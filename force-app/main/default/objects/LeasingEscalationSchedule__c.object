    <fields>
        <fullName>AfterDiscount__c</fullName>
        <label>After Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>AnnualRent__c</fullName>
        <label>Annual Rent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>ContractTypeCode__c</fullName>
        <externalId>false</externalId>
        <formula>IF(
NOT(ISBLANK(TEXT(LeasingOrder__r.Unit__r.PropertyUsage__c))),
IF(
ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Residential&quot;), &quot;R001&quot;,
IF(
ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Commercial&quot;), &quot;R002&quot;,
IF(
ISPICKVAL(LeasingOrder__r.Unit__r.PropertyUsage__c, &quot;Retail&quot;), &quot;R003&quot;,
&quot;&quot;
)
)
),
&quot;&quot;
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>ContractTypeCode</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Discount__c</fullName>
        <formula>TotalRent__c  -  AfterDiscount__c</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Discount</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Escalation__c</fullName>
        <label>Escalation (%)</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Percent</type>
    </fields>
    <fields>
        <fullName>LeasingEndDate__c</fullName>
        <label>Leasing End Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>LeasingOrder__c</fullName>
        <label>Leasing Order</label>
        <referenceTo>LeasingOrder__c</referenceTo>
        <relationshipName>Leasing_Escalation_Splits</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>LeasingStartDate__c</fullName>
        <label>Leasing Start Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Date</type>
    </fields>
    <fields>
        <fullName>TotalRent__c</fullName>
        <label>Total Rent</label>
        <precision>18</precision>
        <required>false</required>
        <scale>2</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>Year__c</fullName>
        <externalId>false</externalId>
        <label>Year</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <label>Leasing Escalation Schedule</label>
    <nameField>
        <displayFormat>LES-{0000}</displayFormat>
        <label>Leasing Escalation Split Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Leasing Escalation Schedules</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Year__c</searchResultsAdditionalFields>
